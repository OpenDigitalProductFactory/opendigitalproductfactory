# App-level environment — copy to:
#   apps/web/.env.local    (Next.js + local host-side Prisma commands)
#
# Optional legacy fallback:
#   packages/db/.env       (only if you need a package-local Prisma override)
#
# For Docker Compose container config, see .env.docker.example instead.

# PostgreSQL
DATABASE_URL="postgresql://dpf:dpf_dev@localhost:5432/dpf"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="dpf_dev_password"

# Separate local-only credential for the sanitized Contributor preview.
# Do not reuse ADMIN_PASSWORD or any production secret. Minimum 12 characters.
CONTRIBUTOR_PREVIEW_PASSWORD=""

# Auth.js
AUTH_SECRET="<generate with: openssl rand -base64 32>"
AUTH_TRUST_HOST=true

# ── Canonical Portal URL ─────────────────────────────────
# The externally-reachable base URL for this portal install.
# Used for:
#   - OAuth callbacks (must match what's registered with the provider)
#   - Outbound email/webhook URLs
#   - Canonical-host redirect middleware (apps/web/middleware.ts):
#     non-matching origins (e.g. http://192.168.x.x:3000) are 301'd here
#     with Clear-Site-Data so per-origin browser caches flush, eliminating
#     chat/session state divergence across IP vs hostname access.
# Leave UNSET for local dev — middleware passes through, any Host works.
# PUBLIC_URL="https://portal.example.com"

# Optional comma-separated allow-list of additional host:port values the
# middleware should accept WITHOUT redirecting (LAN bypass / mDNS access).
# Useful when admins want to keep LAN access alive even after setting a
# canonical domain (Home Assistant internal_url pattern).
# PUBLIC_URL_ALIASES="192.168.1.10:3000,portal.local"

# Credential encryption (AES-256-GCM, 32 bytes hex)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="<generate with: openssl rand -hex 32>"

# Anthropic (Agent co-worker)
ANTHROPIC_API_KEY="<your key>"

# Branding logo object storage (S3-compatible, R2, etc.)
BRANDING_LOGO_S3_BUCKET="<bucket name>"
BRANDING_LOGO_S3_REGION="us-east-1"
BRANDING_LOGO_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
BRANDING_LOGO_S3_FORCE_PATH_STYLE="1"
BRANDING_LOGO_AWS_ACCESS_KEY_ID="<object storage access key id>"
BRANDING_LOGO_AWS_SECRET_ACCESS_KEY="<object storage secret>"
BRANDING_LOGO_PUBLIC_URL_PREFIX="https://cdn.example.com/branding"
BRANDING_LOGO_ALLOW_DATA_URL_FALLBACK="0"

# ── Social Auth (Google / Apple sign-in for customers) ───
# Set ENABLE_SOCIAL_AUTH to "true" to activate OAuth providers
ENABLE_SOCIAL_AUTH=false
# Exposed to client for conditional UI rendering
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=false
# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="<your Google client ID>"
GOOGLE_CLIENT_SECRET="<your Google client secret>"
# Apple Sign In credentials (https://developer.apple.com/account/resources/identifiers)
APPLE_CLIENT_ID="<your Apple service ID>"
APPLE_CLIENT_SECRET="<your Apple client secret>"
APPLE_TEAM_ID="<your Apple team ID>"
APPLE_KEY_ID="<your Apple key ID>"

# ── Inngest (durable execution engine) ───────────────────
INNGEST_EVENT_KEY="<generate with: openssl rand -hex 16>"
INNGEST_SIGNING_KEY="<generate with: openssl rand -hex 16>"
INNGEST_BASE_URL=http://localhost:8288
INNGEST_DEV=1

# Build Studio sandbox posture for local host-side runs. Default is 1 (per-build
# git worktrees under /workspace/.builds/<buildId>). Set to 0 only as an
# emergency rollback to the old shared /workspace checkout.
DPF_BUILD_WORKTREE_ISOLATION=

# ── Local LLM Inference (Docker Model Runner) ────────────
# Docker Model Runner is built into Docker Desktop 4.40+.
# Pull models:  docker model pull ai/llama3.2:1B-Q8_0
# List models:  docker model list
# Default URL works automatically inside Docker Compose containers.
# Override only for custom setups (e.g., external Ollama):
# LLM_BASE_URL=http://model-runner.docker.internal/v1

# ── Host bind-mount paths (written by the installer; see check-compose-env-contract) ─
# These are the ABSOLUTE host paths compose bind-mounts into the portal. They are
# written by install-dpf.sh / install-dpf.ps1 at setup time. They must be absolute
# and shared with Docker Desktop, because the self-upgrade PROMOTER runs as root
# (HOME=/root) and re-runs compose during a swap — a ${HOME}-relative fallback would
# resolve to /root/... and fail with "mounts denied" (the #3262 fleet incident).
#
# Absolute path to this install directory (the repo root).
DPF_HOST_INSTALL_PATH=
# Absolute host dir for signed runtime-capability-transition receipts + install-state
# (compose mounts it read-only at /dpf-state). Pin to the operator's real ~/.dpf,
# e.g. /Users/<user>/.dpf (macOS) or C:\Users\<user>\.dpf (Windows). If unset, the
# root-run promoter falls back to /root/.dpf and the upgrade dies at step=migrate.
DPF_STATE_DIR=
DPF_HOST_PLATFORM=
DPF_HOST_ARCH=
# Absolute host dir for Postgres backups (kept OUTSIDE the install root by design).
DPF_BACKUPS_HOST_PATH=

# ── MCP client authentication (OAuth 2.1 authorization server) ────────────────
# Every value here is an operator decision from
# docs/superpowers/specs/2026-08-26-mcp-client-self-authentication-design.md §9.
# All are OPTIONAL: unset means the recommended default, which is what a normal
# install should run.
#
# Dynamic Client Registration. Default: enabled ONLY when the install's origin
# is loopback. Registration grants nothing on its own — a human still consents —
# but an open /register on a reachable install invites junk clients that pick
# their own display name. Set to 1 or 0 to force it either way.
# DPF_OAUTH_DCR=
#
# Client ID Metadata Document resolution (SEP-991). OFF by default and it should
# stay off unless this install is deliberately internet-exposed and its clients
# authenticate by metadata document. Turning it on lets a client cause this
# server to fetch a URL the CLIENT chose. Outbound requests are guarded against
# private, loopback, link-local and reserved address ranges, but not making the
# request at all is the stronger control — and a fully-local install cannot use
# CIMD anyway, since it cannot reach the document. Dynamic registration (above)
# is the local path.
# DPF_OAUTH_CIMD_FETCH=
#
# Access-token lifetime in seconds (default 3600, clamped 300..86400). Shorter
# buys little on a local box and costs refresh traffic; longer widens the replay
# window.
# DPF_OAUTH_ACCESS_TTL_SECONDS=
# DPF_OAUTH_REFRESH_TTL_SECONDS=
# DPF_OAUTH_CODE_TTL_SECONDS=
# DPF_OAUTH_CC_TTL_SECONDS=
#
# Legacy dpfmcp_ personal-access-token retirement. These retire in ORDER and
# both default OFF, because turning either on by default would break working
# installs on upgrade.
#   1. Close issuance: no NEW PATs are minted; existing ones keep working.
#      Platform-minted ephemeral build-ship tokens are exempt.
# DPF_MCP_PAT_ISSUANCE_CLOSED=
#   2. The horizon: PAT resolution stops entirely. Only set this once
#      Admin > Platform Development shows nothing still depending on one.
# DPF_MCP_PAT_RESOLUTION_DISABLED=
