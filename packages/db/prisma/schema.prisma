model UserGroup {
  id             String       @id @default(cuid())
  userId         String
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
}

model CustomerContact {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String?
  accountId        String
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  name             String? // Legacy — use firstName+lastName for new code
  firstName        String?
  lastName         String?
  // MDM write-time dedup (EP-4A12A7CB WG-1): standardizeName of the display
  // name (firstName+lastName, falling back to legacy name). Fuzzy-alert only —
  // email stays the unique identity key.
  nameNormalized   String               @default("")
  phone            String?
  // Field-service dispatch (BI-FS-003): how to reach this contact and whether
  // the phone is SMS-capable. Nullable = operator has not set a preference yet.
  // Allowed values enforced in packages/validators (not a Prisma enum — closed
  // set may grow without a DB migration).
  preferredNotificationChannel String? // sms | voice | email | none
  phoneType                    String? // mobile | landline | unknown
  jobTitle         String?
  linkedinUrl      String?
  source           String? // web | referral | import | manual
  doNotContact     Boolean              @default(false)
  avatarUrl        String?
  // Merge tombstone (EP-4A12A7CB): contacts are identity-bearing, so a merge
  // is a Principal convergence — loser keeps email/credentials, isActive
  // false, mergedIntoId points at the surviving contact.
  mergedIntoId     String?
  updatedAt        DateTime             @default(now()) @updatedAt
  account          CustomerAccount      @relation(fields: [accountId], references: [id])
  mergedInto       CustomerContact?     @relation("ContactMerge", fields: [mergedIntoId], references: [id])
  mergedFrom       CustomerContact[]    @relation("ContactMerge")
  socialIdentities SocialIdentity[]
  accountRoles     ContactAccountRole[]
  invoices         Invoice[]
  engagements      Engagement[]
  opportunities    Opportunity[]
  activities       Activity[]
  rentalAgreements RentalAgreement[]

  @@index([lastName])
  @@index([phone])
  @@index([nameNormalized])
  @@index([mergedIntoId])
}

// ─── MDM stewardship substrate (EP-4A12A7CB: BI-FEA49EC1 / BI-28577CD1 /
//     BI-130EF887 / BI-37F52B70 / BI-16450BB2) ────────────────────────────────

// One row per open data-quality question a human steward must answer:
// a duplicate pair from the batch scan, or a stale record from the
// staleness sweep. Persisted so review survives sessions (the on-demand
// scan in lib/mdm/batch-scan.ts stays the compute; this is the workflow).
model MdmStewardTask {
  id          String    @id @default(cuid())
  taskId      String    @unique // STEW-XXXXXXXX
  domain      String // customer-account | customer-contact | customer-site
  kind        String // duplicate | stale
  // open | resolved_merged | resolved_distinct | resolved_refreshed | dismissed
  status      String    @default("open")
  subjectId   String // canonical row id the task is about
  // duplicate tasks: the other row of the pair; "" for single-record tasks
  // (NOT NULL so the compound unique actually dedupes — NULL≠NULL in PG).
  candidateId String    @default("")
  score       Float?
  reasons     Json?
  note        String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([domain, kind, subjectId, candidateId])
  @@index([status, kind])
  @@index([subjectId])
}

// Attribute-level history for master-data identity fields (BI-130EF887):
// who changed what, when — the temporal record commercial MDM keeps.
// Written by the governed update paths; append-only.
model MdmAttributeChange {
  id        String   @id @default(cuid())
  domain    String // customer-account | customer-contact | customer-site
  entityId  String
  attribute String
  oldValue  String?
  newValue  String?
  actorId   String? // user id when known; null for system paths
  source    String? // api-patch | merge | unmerge | steward | system
  changedAt DateTime @default(now())

  @@index([domain, entityId, changedAt])
  @@index([attribute])
}

// Per-domain governed match/merge configuration (BI-37F52B70 / BI-16450BB2):
// operator-tunable thresholds + survivorship mode, JSON with code defaults
// as fallback (lib/mdm/match-config.ts owns the parse + defaults).
model MdmMatchConfig {
  id        String   @id @default(cuid())
  domain    String   @unique
  config    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SocialIdentity {
  id                String          @id @default(cuid())
  provider          String
  providerAccountId String
  email             String?
  contactId         String
  linkedAt          DateTime        @default(now())
  contact           CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([contactId])
}

model AccountInvite {
  id        String          @id @default(cuid())
  code      String          @unique
  accountId String
  createdBy String?
  expiresAt DateTime?
  usedAt    DateTime?
  usedBy    String?
  createdAt DateTime        @default(now())
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  deliveryChannel   String
  requestedByUserId String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  requestedByUser   User?     @relation("PasswordResetRequestedBy", fields: [requestedByUserId], references: [id])
  user              User      @relation("PasswordResetForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PlatformRole {
