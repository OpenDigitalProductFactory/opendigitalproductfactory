  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Principal {
  id                                  String                              @id @default(cuid())
  principalId                         String                              @unique
  kind                                String
  status                              String                              @default("active")
  displayName                         String
  sponsorPrincipalId                  String?
  authorityMode                       String?
  sensitivityClearance                PrincipalSensitivity[]              @default([public])
  aliases                             PrincipalAlias[]
  sponsorPrincipal                    Principal?                          @relation("PrincipalSponsor", fields: [sponsorPrincipalId], references: [id])
  sponsoredPrincipals                 Principal[]                         @relation("PrincipalSponsor")
  communicationChannelBindings        CommunicationChannelBinding[]
  communicationChannelSessions        CommunicationChannelSession[]
  // Per AGENTS.md §11 (Principal convergence, 2026-05-09): EdgeNode
  // identity lives on Principal + PrincipalAlias, with EdgeNode as a
  // host-attributes side table keyed by `principalId`. 1:1 cardinality.
  edgeNode                            EdgeNode?                           @relation("EdgeNodeIdentity")
  edgeNodesApproved                   EdgeNode[]                          @relation("EdgeNodeApprover")
  // EP-MSP-FEDERATION · B1 — a federated peer (another DPF deployment) is a
  // Principal(kind="federated-peer") with FederationLink as its side table,
  // exactly as EdgeNode is for an edge agent. No parallel identity table.
  federationLink                      FederationLink?                     @relation("FederationLinkIdentity")
  bootstrapTokensIssued               BootstrapToken[]                    @relation("BootstrapTokenIssuer")
  ownedDocuments                      Document[]                          @relation("DocumentOwner")
  createdDocuments                    Document[]                          @relation("DocumentCreator")
  documentVersions                    DocumentVersion[]                   @relation("DocumentVersionCreator")
  documentReferences                  DocumentReference[]                 @relation("DocumentReferenceCreator")
  documentAccessGrants                DocumentAccessGrant[]               @relation("DocumentAccessGrantPrincipal")
  documentAccessGrantsCreated         DocumentAccessGrant[]               @relation("DocumentAccessGrantCreator")
  documentLifecycleEvents             DocumentLifecycleEvent[]            @relation("DocumentLifecycleActor")
  ownedDecisionPerspectiveProfiles    DecisionPerspectiveProfile[]        @relation("DecisionPerspectiveProfileOwner")
  promotedDecisionPerspectiveVersions DecisionPerspectiveProfileVersion[] @relation("DecisionPerspectiveProfileVersionPromoter")
  decisionEscalationsResolved         EscalationCapture[]                 @relation("DecisionEscalationResolverPrincipal")
  patientProfiles                     PatientProfile[]                    @relation("PatientProfileIdentity")
  patientProfilesRecorded             PatientProfile[]                    @relation("PatientProfileRecorder")
  patientProfilesVerified             PatientProfile[]                    @relation("PatientProfileVerifier")
  patientAuthoritiesGranted           PatientAuthority[]                  @relation("PatientAuthorityGrantee")
  patientAuthoritiesAsserted          PatientAuthority[]                  @relation("PatientAuthorityAsserter")
  patientAuthoritiesVerified          PatientAuthority[]                  @relation("PatientAuthorityVerifier")
  patientAuthoritiesRevoked           PatientAuthority[]                  @relation("PatientAuthorityRevoker")
  patientConsentDirectivesAsserted    PatientConsentDirective[]           @relation("PatientConsentDirectiveAsserter")
  patientConsentDirectivesVerified    PatientConsentDirective[]           @relation("PatientConsentDirectiveVerifier")
  patientConsentDirectivesRevoked     PatientConsentDirective[]           @relation("PatientConsentDirectiveRevoker")
  patientAuthorizationDecisions       AuthorizationDecisionLog[]          @relation("PatientAuthorizationSubject")
  careAppointmentsCreated             CareAppointment[]                   @relation("CareAppointmentCreator")
  careAppointmentsOverbooked          CareAppointment[]                   @relation("CareAppointmentOverbookAuthorizer")
  careAppointmentStatusEvents         CareAppointmentStatusEvent[]        @relation("CareAppointmentStatusActor")
  careIntakePacketsSourced            CareIntakePacket[]                  @relation("CareIntakePacketSource")
  careIntakePacketsRecorded           CareIntakePacket[]                  @relation("CareIntakePacketRecorder")
  careIntakeResponsesSourced          CareIntakeResponse[]                @relation("CareIntakeResponseSource")
  careIntakeResponsesRecorded         CareIntakeResponse[]                @relation("CareIntakeResponseRecorder")
  careIntakeAccessGrants              CareIntakeAccessGrant[]             @relation("CareIntakeAccessGrantee")
  careIntakeAccessGrantsIssued        CareIntakeAccessGrant[]             @relation("CareIntakeAccessIssuer")
  careConsentAttestationsSigned       CareConsentAttestation[]            @relation("CareConsentAttestationSigner")
  careConsentAttestationsWitnessed    CareConsentAttestation[]            @relation("CareConsentAttestationWitness")
  careConsentAttestationsAccepted     CareConsentAttestation[]            @relation("CareConsentAttestationAcceptor")
  careCoverageEvidenceResponsible     CareCoverageEvidence[]              @relation("CareCoverageResponsibleParty")
  careCoverageEvidenceVerified        CareCoverageEvidence[]              @relation("CareCoverageEvidenceVerifier")
  careIntakeExceptionsAssigned        CareIntakeException[]               @relation("CareIntakeExceptionAssignee")
  careIntakeExceptionsResolved        CareIntakeException[]               @relation("CareIntakeExceptionResolver")
  careIntakeStatusEvents              CareIntakeStatusEvent[]             @relation("CareIntakeStatusActor")
  createdAt                           DateTime                            @default(now())
  updatedAt                           DateTime                            @updatedAt

  @@index([sponsorPrincipalId])
  @@index([kind, authorityMode])
}

model PrincipalAlias {
  id                   String                @id @default(cuid())
