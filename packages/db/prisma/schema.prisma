  licenseDisplayObligations LicenseDisplayObligation[]

  @@index([obligationId])
  @@index([controlId])
  @@index([collectedByEmployeeId])
  @@index([status])
  @@index([evidenceType])
  @@index([providerConnectionId, claimKey, status])
  @@index([expiresAt, status])
}

