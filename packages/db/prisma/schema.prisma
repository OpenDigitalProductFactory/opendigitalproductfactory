model ScheduledAgentTask {
  id           String    @id @default(cuid())
  taskId       String    @unique
  agentId      String
  title        String
  prompt       String
  routeContext String
  schedule     String // cron expression: "0 9 * * 1" (Mon 9am), "0 8 * * *" (daily 8am)
  timezone     String    @default("UTC")
  isActive     Boolean   @default(true)
  ownerUserId  String
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  lastStatus   String? // ok | error
  lastError    String?
  lastThreadId String?
  // Autonomous coworker runtime Slice 1: latest TaskRun spawned by this schedule.
  taskRunId    String?
  // BI-754C9E82: consecutive failed attempts in the CURRENT retry cycle. The
  // proactivity plan's followUpCadenceMinutes/maxAttempts drive short-cadence
  // retries after a failure; reset on success or when the budget is exhausted
  // (each cron cycle gets a fresh budget).
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation("ScheduledAgentTaskOwner", fields: [ownerUserId], references: [id])

  @@index([agentId])
  @@index([ownerUserId])
  @@index([isActive, nextRunAt])
  @@index([taskRunId])
}

