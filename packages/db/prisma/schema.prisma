// BI-D88DFEEA Phase 3. A weight-adjustment PROPOSAL — never a silent
// mutation (spec 2026-07-23-decision-tier-rebalance-and-vector-epistemology-
// design.md §2.4). Emitted by weight-inference.ts's inferWeightProposals(),
// persisted here, surfaced on /coworker-decisions/review for a human ruling.
// `status` starts "proposed" at PROPOSED_CONFIDENCE_WEIGHT (0.3, below every
// authored stance tier). A ruling moves it to "ruled" (and, via
// stance-promotion.ts's promoteStanceMaterial, into the same ladder authored
// stance material uses) or "rejected" — the review-queue pattern this reuses
// (stance-promotion.ts) has no reject primitive of its own, so this model
// carries its own explicit status rather than inventing a second ladder.
model WeightAdjustmentProposal {
  id                     String    @id @default(cuid())
  proposalId             String    @unique
  domainClass            String
  profileId              String
  axis                   String
  direction              String
  consistency            Float
  meanSeparation         Float
  sampleSize             Int
  entersAtConfidenceWeight Float
  status                 String    @default("proposed")
  ruledAt                DateTime?
  ruledByUserId          String?
  rejectionReason        String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  profile                DecisionPerspectiveProfile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  ruledByUser            User?     @relation(fields: [ruledByUserId], references: [id], onDelete: SetNull)

  @@index([profileId, domainClass, status])
  @@index([status, createdAt])
}

