  toPageId   String
  fromPage   WikiPage @relation("WikiOutLinks", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage     WikiPage @relation("WikiInLinks", fields: [toPageId], references: [id], onDelete: Cascade)

