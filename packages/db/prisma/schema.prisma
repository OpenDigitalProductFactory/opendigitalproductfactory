model InventoryRelationship {
  id                      String                   @id @default(cuid())
  // BI-PIR-7d69a445 (part 2): relationshipKey is SOURCE-SCOPED provenance that
  // varies per source/scope for the same real relationship, so it is NOT the
  // canonical identity — it is intentionally non-unique. The canonical identity
  // is the compound @@unique([fromEntityId, toEntityId, relationshipType]) below.
  // Per-run relationshipKey provenance is preserved on DiscoveredRelationship
  // (@@unique([discoveryRunId, relationshipKey])); nothing looks up
  // InventoryRelationship by relationshipKey, so dropping its @unique loses
  // nothing and ends the cross-run P2002 (the upsert now targets the tuple).
  relationshipKey         String
  relationshipType        String
  status                  String                   @default("active")
  confidence              Float?
  properties              Json?
  firstSeenAt             DateTime                 @default(now())
  lastSeenAt              DateTime                 @default(now())
  lastConfirmedRunId      String?
  fromEntityId            String
  toEntityId              String
  scopeKey                String                   @default("organization:internal")
  customerAccountId       String?
  customerSiteId          String?
  mergedIntoId            String?
  discoveredRelationships DiscoveredRelationship[]
  fromEntity              InventoryEntity          @relation("InventoryRelationshipFromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  lastConfirmedRun        DiscoveryRun?            @relation("InventoryRelationshipConfirmedRun", fields: [lastConfirmedRunId], references: [id])
  toEntity                InventoryEntity          @relation("InventoryRelationshipToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)
  qualityIssues           PortfolioQualityIssue[]
  customerAccount         CustomerAccount?         @relation("InventoryRelationshipCustomerAccount", fields: [customerAccountId], references: [id], onDelete: SetNull)
  customerSite            CustomerSite?            @relation("InventoryRelationshipCustomerSite", fields: [customerSiteId], references: [id], onDelete: SetNull)
  mergedInto              InventoryRelationship?   @relation("InventoryRelationshipMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedRelationships     InventoryRelationship[]  @relation("InventoryRelationshipMerge")

  @@unique([fromEntityId, toEntityId, relationshipType])
  @@index([relationshipType])
  @@index([status])
  @@index([scopeKey])
  @@index([customerAccountId])
  @@index([customerSiteId])
  @@index([mergedIntoId])
}

model PortfolioQualityIssue {
  id                      String                    @id @default(cuid())
  issueKey                String                    @unique
  issueType               String
  status                  String                    @default("open")
  severity                String                    @default("warn")
  summary                 String
  details                 Json?
  firstDetectedAt         DateTime                  @default(now())
  lastDetectedAt          DateTime                  @default(now())
  resolvedAt              DateTime?
  inventoryEntityId       String?
  inventoryRelationshipId String?
  portfolioId             String?
  taxonomyNodeId          String?
  digitalProductId        String?
  // EP-MSP-FEDERATION · A1 (BI-8777B85A) — per-customer/site routing scope.
  // Denormalized from the originating EdgeNode / InventoryEntity (the canonical
  // scope source) via the estate-scope resolver so the operator inbox can route
  // a firing issue to the right customer queue instead of one global inbox.
  // NULL customerAccountId / scopeKey="organization:internal" = the operator's
  // own estate (self-monitoring), preserving backward-compatible behavior.
  customerAccountId       String?
  customerSiteId          String?
  scopeKey                String?
  digitalProduct          DigitalProduct?           @relation(fields: [digitalProductId], references: [id])
  inventoryEntity         InventoryEntity?          @relation(fields: [inventoryEntityId], references: [id])
  inventoryRelationship   InventoryRelationship?    @relation(fields: [inventoryRelationshipId], references: [id])
  portfolio               Portfolio?                @relation(fields: [portfolioId], references: [id])
  taxonomyNode            TaxonomyNode?             @relation(fields: [taxonomyNodeId], references: [id])
  customerAccount         CustomerAccount?          @relation("QualityIssueCustomerAccount", fields: [customerAccountId], references: [id], onDelete: SetNull)
  customerSite            CustomerSite?             @relation("QualityIssueCustomerSite", fields: [customerSiteId], references: [id], onDelete: SetNull)
  triageDecisions         DiscoveryTriageDecision[]

  @@index([issueType])
  @@index([status])
  @@index([severity])
  @@index([portfolioId])
  @@index([taxonomyNodeId])
  @@index([digitalProductId])
  @@index([customerAccountId])
  @@index([customerSiteId])
  @@index([scopeKey])
}

