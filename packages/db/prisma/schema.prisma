  readinessState     String
  dpfPlatformVersion String?
  mcpOk              Boolean  @default(false)
  mcpReason          String?
  detail             Json?
  reportedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clientKind])
