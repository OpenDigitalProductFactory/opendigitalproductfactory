  taxonomyNode         TaxonomyNode?                       @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  approvedObservations DiscoveryFingerprintObservation[]   @relation("ApprovedFingerprintRule")

  @@index([status])
  @@index([scope])
