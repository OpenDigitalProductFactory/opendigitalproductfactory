// A first-class marketing campaign: the executable aggregate that ties an
// objective + audience + channels + budget + timeline + KPI targets together
// and owns its child briefs and asset tasks. Before this, briefs/tasks were
// loose siblings off MarketingStrategy and the campaigns view reconstructed the
// brief<->task link by fuzzy string matching; campaignId makes that a real
// relation. Additive: campaignId on brief/task is nullable so legacy rows keep
// working (the view falls back to fuzzy matching for null-campaign rows).
model MarketingCampaign {
  campaignId       String    @id @default(cuid())
  organizationId   String
  strategyId       String
  name             String
  objective        String
  audience         String?
  channels         String[]  @default([])
  status           String    @default("draft")
  budgetTotalCents Int?
  budgetByChannel  Json?
  startDate        DateTime?
  endDate          DateTime?
  kpiTargets       Json?
  primaryCta       String?
  notes            String?
  createdByAgentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategy     MarketingStrategy        @relation(fields: [strategyId], references: [strategyId], onDelete: Cascade)
  briefs       MarketingCampaignBrief[]
  assetTasks   MarketingAssetTask[]

  @@index([organizationId, createdAt])
  @@index([strategyId, createdAt])
  @@index([status])
}

