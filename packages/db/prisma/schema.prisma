  @@unique([sourceType, sourceId])
  @@index([status, createdAt(sort: Desc)])
  @@index([routeContext, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([toolName, createdAt(sort: Desc)])
}

