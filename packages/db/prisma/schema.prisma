  mergedInto             CustomerSite?               @relation("SiteMerge", fields: [mergedIntoId], references: [id])
  mergedFrom             CustomerSite[]              @relation("SiteMerge")
  configurationItems     CustomerConfigurationItem[]
  nodes                  CustomerSiteNode[]
  edgeNodes              EdgeNode[]
  edgeBootstrapTokens    BootstrapToken[]
  discoveryRuns          DiscoveryRun[]
  discoveryConnections   DiscoveryConnection[]
  inventoryEntities      InventoryEntity[]           @relation("InventoryEntityCustomerSite")
  inventoryRelationships InventoryRelationship[]     @relation("InventoryRelationshipCustomerSite")
  qualityIssues          PortfolioQualityIssue[]     @relation("QualityIssueCustomerSite")
  serviceTickets         ServiceTicket[]             @relation("ServiceTicketCustomerSite")

  @@index([accountId])
  @@index([primaryAddressId])
  @@index([status])
  @@index([siteType])
  @@index([mergedIntoId])
}

// ── EP-MSP-FEDERATION · A3 — customer service desk (BI-99FEA7FA) ──────────────
// ONE canonical customer-facing work record discriminated by `ticketKind`
// (incident | request | change | scheduled-review) — not four premature tables
// (reviewed spec §6.A3). Distinct from the internal-ops PlatformIssueReport.
// Born from A2 correlated incidents (correlatedIncidentKey) and routed by the
// A1 estate-scope columns. Status/kind closed unions live in
// packages/db/src/service-ticket-types.ts (hyphenated per the WS-0 convergence
// rule). Soft references (configurationItemId, serviceAgreementId, edgeNodeId,
// correlatedIncidentKey, ownerPrincipalId) keep cross-model blast radius low in
// this slice; FK relations are added when the linked behaviors land.
model ServiceTicket {
  id                    String    @id @default(cuid())
  ticketId              String    @unique
  ticketKind            String    @default("incident")
  status                String    @default("open")
  priority              String    @default("normal")
  severity              String?
  title                 String
  description           String?
  // Estate scope (A1 routing columns; canonical source is the owning node/CI).
  customerAccountId     String?
  customerSiteId        String?
  scopeKey              String?
  // Linkage (soft references this slice).
  configurationItemId   String?
  serviceAgreementId    String?
  edgeNodeId            String?
  correlatedIncidentKey String?
  // SLA + ownership.
  slaPolicy             Json?
  slaDueAt              DateTime?
  ownerPrincipalId      String?
  // Lifecycle timestamps.
  openedAt              DateTime  @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customerAccount CustomerAccount?       @relation("ServiceTicketCustomerAccount", fields: [customerAccountId], references: [id], onDelete: SetNull)
  customerSite    CustomerSite?          @relation("ServiceTicketCustomerSite", fields: [customerSiteId], references: [id], onDelete: SetNull)
  comments        ServiceTicketComment[]

  @@index([ticketKind])
  @@index([status])
  @@index([priority])
  @@index([customerAccountId])
  @@index([customerSiteId])
  @@index([scopeKey])
  @@index([correlatedIncidentKey])
  @@index([slaDueAt])
}

model ServiceTicketComment {
  id                String        @id @default(cuid())
  ticketId          String
  authorPrincipalId String?
  // operator | customer | agent | system
  authorKind        String        @default("operator")
  body              String
  // internal | customer  — gates what a federated/customer viewer may read.
  visibility        String        @default("internal")
  createdAt         DateTime      @default(now())
  ticket            ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

