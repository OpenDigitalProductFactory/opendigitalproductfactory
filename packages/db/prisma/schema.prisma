  userAgent           String?
  reportedById        String?
  digitalProductId    String?
  portfolioId         String?
  agentId             String?
  featureBuildId      String?
  source              String        @default("manual")
  // Governed Hermes learning Slice 1: link runtime issues to the thread/run
