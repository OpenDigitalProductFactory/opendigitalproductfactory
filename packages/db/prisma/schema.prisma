model TaskRun {
  id                   String                @id @default(cuid())
  taskRunId            String                @unique
  userId               String
  threadId             String?
  contextId            String?
  buildId              String?
  initiatingAgentId    String?
  currentAgentId       String?
  parentTaskRunId      String?
  routeContext         String?
  title                String
  objective            String                @db.Text
  source               String                @default("coworker") // coworker | build | skill | proactive
  /// A2A-aligned task states: submitted | working | input-required | auth-required | completed | failed | canceled | rejected | archived
  status               String                @default("submitted")
  authorityScope       Json?
  a2aMetadata          Json?
  progressPayload      Json?
  repeatedPatternKey   String?
  templateId           String?
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  archivedAt           DateTime?
  // Cooperative heartbeat written by long-running loops (agent runtime,
  // deliberation rounds, sandbox pipeline, Codex CLI) so the watchdog can
  // distinguish a live task from a wedged one. See BI-4ab6be39 §6.1.
  lastHeartbeatAt      DateTime?
  // Timestamp when the Activity Quiescence coordinator flipped this row to
  // status='quiescing' during a normal→draining transition. Null on rows
  // that have never been part of a quiescence cycle. See spec
  // docs/superpowers/specs/2026-05-24-activity-quiescence-protocol-design.md
  // §5.1 + §6.2. BI-QUIESCE-001.
  quiescedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes                TaskNode[]
  messages             TaskMessage[]
  artifacts            TaskArtifact[]
  deliberationRuns     DeliberationRun[]
  decisionInteractions DecisionInteraction[]
  stallEvents          StallEvent[]
  actionEnvelopes      CoworkerActionEnvelope[]

  @@index([userId, status])
  @@index([threadId])
  @@index([contextId])
  @@index([parentTaskRunId])
  @@index([buildId, status])
  @@index([routeContext, status])
  @@index([repeatedPatternKey])
  // Watchdog query: WHERE status = 'working' AND lastHeartbeatAt < ...
  @@index([status, lastHeartbeatAt])
}

// ─── Build Studio Stall Detection — audit trail (BI-4ab6be39) ─────
//
// One row per stall detection or operator-initiated recovery action.
// Captures the watchdog's decision evidence (reason, observed values,
// thresholds in effect) and the resulting operator outcome (retry,
// abandon, escalate). Used by the Build Studio phase panel history
// strip and as candidate WWMD profile material in v2.
model StallEvent {
  id                  String    @id @default(cuid())
  taskRunId           String
  buildId             String?
  phase               String? // FeatureBuild.phase at detection time
  reason              String // "heartbeat_timeout" | "total_timeout" | "never_started" | "parent_stalled" | "parent_abandoned"
  detectedAt          DateTime  @default(now())
  lastHeartbeatAt     DateTime?
  startedAt           DateTime
  thresholdHeartbeatS Int
  thresholdTotalS     Int
  outcome             String? // null (pending) | "retry" | "abandoned" | "escalated" | "auto-recovered"
  outcomeAt           DateTime?
  outcomeBy           String? // User.id of operator who acted; null if watchdog auto-action
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())

  taskRun TaskRun @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([taskRunId])
  @@index([buildId])
  @@index([phase, reason])
  @@index([outcome])
  @@index([createdAt])
}

// ─── Activity Quiescence Protocol — coordinator audit (BI-QUIESCE-001) ───
//
// One row per orchestrated drain attempt. Lifecycle:
//   pending → preparing → draining → ready-to-swap → swapping → completed
//                                          │              │
//                                          └─→ aborted    └─→ failed
//                            │
//                            └─→ deferred (hard-blocker exceeded budget)
//
// Critical invariant (spec §5.2): every terminal transition emits the
// "platform.quiescence-cleared" Inngest event so suspended functions resume
// regardless of outcome. Otherwise a single coordinator crash would wedge
// the Inngest queue forever.
//
// Independent of SelfUpgradeRun because quiescence is also triggerable from
// manual maintenance and sandbox recovery flows; the trigger field carries
// the caller, and triggerRefId links back when the caller has its own audit
// substrate (e.g., SelfUpgradeRun.runId).
//
// Spec: docs/superpowers/specs/2026-05-24-activity-quiescence-protocol-design.md §5.1
model QuiescenceRun {
  id           String  @id @default(cuid())
  // Public/human-readable id (e.g., "QR-2026-05-24-abc123"). Used in event
  // payloads + URLs + log lines; the cuid `id` is internal FK substrate only.
  runId        String  @unique
  // Caller category: "self-upgrade" | "manual" | "sandbox-recovery"
  trigger      String
  // Caller's external reference (e.g., SelfUpgradeRun.runId). Echoed back
  // on platform.quiescence-cleared so caller's step.waitForEvent can filter
  // when multiple non-self-upgrade callers emit in close sequence (spec §5.3).
  triggerRefId String?

  // State machine value (see model comment above). String not enum so future
  // additions don't require a schema migration — application-layer validation
  // via the QUIESCENCE_RUN_STATUSES constant.
  status          String
  startedAt       DateTime  @default(now())
  // Per-state entry timestamps: { draining: ts, "ready-to-swap": ts, ... }.
  // JSON-of-timestamps rather than columns per state so adding telemetry
  // fields later doesn't force a migration per signal added.
  enteredStateAt  Json      @default("{}")
  // Swap-window timestamps populated when the caller signals progress past
  // the ready-to-swap handshake. Distinguished from completedAt because the
  // outer coordinator lifetime extends past swap (final state transitions).
  swapStartedAt   DateTime?
  swapCompletedAt DateTime?
  completedAt     DateTime?
  // Coordinator function heartbeat — written every wait-loop tick (~5s).
  // Stuck-coordinator detection in taskrunWatchdog (BI-QUIESCE-007) keys on
  // this; mirrors the BI-4ab6be39 TaskRun.lastHeartbeatAt pattern.
  lastHeartbeatAt DateTime?

  // ActiveSessionBlockers shape (spec §5.6) captured at preparing transition.
  initialSnapshot Json
  // Latest snapshot at completion / defer; null while still in flight.
  finalSnapshot   Json?

  // Expected post-swap identity for boot reconcile (BI-QUIESCE-010). When the
  // new bundle boots it can correlate against these fields to detect that a
  // pending QuiescenceRun matches the now-running version.
  targetVersion    String?
  targetBundleHash String?

  // Operator-promised wait budget (ms). Coordinator chooses regime at
  // preparing time and may extend per spec §5.5 max(regimeBudget, phaseBudget)
  // rule when a BuildPhaseRun blocker is present.
  budgetMs     Int
  // Actual wait time at terminal transition. Populated for success/defer paths.
  actualWaitMs Int?

  // Defer audit (populated when status='deferred').
  deferReason    String?
  deferSurface   String?
  // List of surfaces force-cancelled past budget (e.g., ship-force override).
  // JSON array of { surface, reason, forcedAt } objects.
  forcedSurfaces Json    @default("[]")

  // Terminal outcome label: succeeded | deferred-by-surface |
  // aborted-by-operator | failed. Set together with status transition.
  outcome          String?
  // Where the terminal transition came from: caller | boot-reconciler | watchdog.
  // Distinguishes "caller signaled swap-complete cleanly" from "post-swap boot
  // reconciler had to close out a pending run" from "watchdog forced cleanup".
  completionSource String?
  outcomeNotes     String? @db.Text

  // BI-4F3B2FA9: mid-flight emergency escalation. When an operator clicks
  // "Force Now" on an ALREADY-RUNNING drain, these record when/who promoted it
  // to forced mode. The coordinator re-reads shipForceEscalatedAt every wait
  // tick and treats a non-null value as shipForce, so a stuck drain can be
  // forced through without restarting the run. Null when started forced or
  // never escalated; an audit entry is also appended to forcedSurfaces.
  shipForceEscalatedAt DateTime?
  shipForceEscalatedBy String?

  @@index([trigger, startedAt])
  // Stuck-coordinator query: status NOT IN (terminal) AND lastHeartbeatAt < cutoff.
  @@index([status, lastHeartbeatAt])
}

model TaskMessage {
  id               String   @id
  messageId        String   @unique
  taskRunId        String
  contextId        String?
  role             String
  parts            Json
  metadata         Json?
  referenceTaskIds String[] @default([])
  createdAt        DateTime @default(now())
  taskRun          TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([taskRunId, createdAt])
  @@index([contextId])
}

model TaskArtifact {
  id              String   @id
  artifactId      String   @unique
  taskRunId       String
  name            String
  description     String?
  parts           Json
  metadata        Json?
  producerAgentId String?
  producerNodeId  String?
  createdAt       DateTime @default(now())
  taskRun         TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([taskRunId, createdAt])
  @@index([producerAgentId])
  @@index([producerNodeId])
}

model TaskNode {
  id                 String           @id @default(cuid())
  taskNodeId         String           @unique
  taskRunId          String
  parentNodeId       String?
  nodeType           String // analyze | plan | execute | review | skeptical_review | activation_proposal | approval_gate | verify | summarize
  title              String
  objective          String           @db.Text
  status             String           @default("queued") // queued | ready | running | blocked | awaiting_human | completed | failed | cancelled | superseded
  workerRole         String // planner | researcher | executor | reviewer | skeptical_reviewer | verifier | activation_analyst | summarizer
  dependencyMode     String? // all_of | any_of | after_parent
  authorityEnvelope  Json?
  evidenceContract   Json?
  requestContract    Json?
  routeDecision      Json?
  inputSnapshot      Json?
  outputSnapshot     Json?
  costUsd            Float?
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  influenceLevel     String? // none | contextual | material
  supersededByNodeId String?
  deliberationRunId  String? // nullable — non-null only when this TaskNode is a deliberation branch
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  taskRun            TaskRun          @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  parentNode         TaskNode?        @relation("TaskNodeTree", fields: [parentNodeId], references: [id])
  childNodes         TaskNode[]       @relation("TaskNodeTree")
  incomingEdges      TaskNodeEdge[]   @relation("TaskNodeEdgeTo")
  outgoingEdges      TaskNodeEdge[]   @relation("TaskNodeEdgeFrom")
  deliberationRun    DeliberationRun? @relation("DeliberationRunBranchNodes", fields: [deliberationRunId], references: [id])
  claimRecords       ClaimRecord[]    @relation("ClaimRecordBranchNode")
  evidenceBundles    EvidenceBundle[] @relation("EvidenceBundleTaskNode")

  @@index([taskRunId, status])
  @@index([parentNodeId])
  @@index([nodeType, status])
  @@index([workerRole, status])
  @@index([deliberationRunId])
}

model TaskNodeEdge {
  id         String   @id @default(cuid())
  fromNodeId String
  toNodeId   String
  edgeType   String // depends_on | informs | verifies | blocks | supersedes
  createdAt  DateTime @default(now())
  fromNode   TaskNode @relation("TaskNodeEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     TaskNode @relation("TaskNodeEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, edgeType])
  @@index([toNodeId])
}

model FeaturePack {
  id               String  @id @default(cuid())
  packId           String  @unique
  title            String
  description      String?
  portfolioContext String?
  version          String  @default("1.0.0")
  manifest         Json
  screenshot       String?
  buildId          String?
  status           String  @default("local")

  // Contribution review results (populated by contribution-review pipeline)
  mergeReadiness      String? // "ready" | "needs-work" | "blocked"
  applicableVerticals String[] // archetype categories, e.g. ["pet-services", "healthcare-wellness"]
  sourceVertical      String? // contributing org's industry
  reusabilityScope    String? // "one_off" | "parameterizable" | "already_generic"
  prUrl               String? // GitHub PR URL
  prNumber            Int? // GitHub PR number
  reviewReport        Json? // Full structured ContributionReviewResult
  reviewedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model SelfUpgradeRun {
  id                    String    @id @default(cuid())
  runId                 String    @unique
  status                String    @default("queued")
  trigger               String
  currentSha            String?
  targetSha             String?
  deployedSha           String?
  reason                String?
  promoterContainerName String?
  completionEvidence    Json?
  failureLog            String?   @db.Text
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // The "What's in this update?" summary the operator reviewed when launching
  // this upgrade — attached so the run records the changes it carried, and so
  // the summary survives the process restart the swap triggers.
  impactSummaryId String?
  impactSummary   UpgradeImpactSummary? @relation(fields: [impactSummaryId], references: [id])

  // The change-management record (RFC) this self-upgrade is registered as. Every
  // self-upgrade is mirrored into the change register as an ITIL standard change
  // so it is auditable for root-cause analysis. Nullable: no-op skipped ticks
  // never open a record. See apps/web/lib/self-upgrade/change-record.ts.
  changeRequestId String?        @unique
  changeRequest   ChangeRequest? @relation("SelfUpgradeChangeRecord", fields: [changeRequestId], references: [id])

  @@index([status, createdAt])
  @@index([targetSha])
  @@index([impactSummaryId])
}

/// Durable "What's in this update?" impact summary, keyed by the immutable
/// (currentLineageSha, targetSha) pair. The commit range between two SHAs is
/// fixed, so a computed summary for a pair never changes — it is cached here so
/// it survives a page refresh AND the process restart every self-upgrade
/// triggers (the prior in-memory cache died on both). The in-memory map
/// (impact/cache.ts) is an L1 in front of this; the panel's Refresh forces a
/// recompute. Only successful (ok:true) summaries are persisted.
model UpgradeImpactSummary {
  id                String           @id @default(cuid())
  currentLineageSha String
  targetSha         String
  /// The full UpgradeImpactSummary object (the ok:true SummaryResult.summary).
  summary           Json
  generatedAt       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  runs              SelfUpgradeRun[]

  @@unique([currentLineageSha, targetSha])
  @@index([targetSha])
}

// PrivatePathRule — operator-managed overrides that merge with the checked-in
// `.dpf/private-paths` manifest. Paths matching either source are NEVER
// included in a public-hive contribution diff (Private/Public Change
// Segregation, EP-1A78BAE1). gitignore-style glob in `pattern`.
model PrivatePathRule {
  id          String   @id @default(cuid())
  pattern     String   @unique
  reason      String?
  createdById String?
  createdBy   User?    @relation("PrivatePathRuleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model PlatformDevConfig {
  id                        String    @id @default("singleton")
  contributionMode          String    @default("selective")
  // Values: "fork_only" | "selective" | "contribute_all"
  gitRemoteUrl              String? // Reserved for future git push capability
  updatePending             Boolean   @default(false)
  pendingVersion            String?
  configuredAt              DateTime  @default(now())
  configuredById            String?
  configuredBy              User?     @relation("PlatformDevConfiguredBy", fields: [configuredById], references: [id])
  dcoAcceptedAt             DateTime?
  dcoAcceptedById           String?
  dcoAcceptedBy             User?     @relation("PlatformDevDcoAcceptedBy", fields: [dcoAcceptedById], references: [id])
  upstreamRemoteUrl         String?
  // Client identity — generated once at install, never changes.
  // Used as the git author for all agent commits so contributions are
  // indistinguishable by name but unique and traceable by email hash.
  clientId                  String? // UUID, generated at first seed
  gitAgentEmail             String? // agent-<sha256(clientId)[:16]>@hive.dpf
  // Which push model to use when contributionMode is selective | contribute_all.
  // null = unconfigured; explicit value required before contribute_to_hive runs.
  // "maintainer-direct" — push directly to upstream (legacy path, requires upstream write)
  // "fork-pr"          — push to contributor-owned fork, open cross-repo PR (public-repo default)
  contributionModel         String?
  contributorForkOwner      String?
  contributorForkRepo       String?
  forkVerifiedAt            DateTime?
  backlogTeeUpDailyCap      Int       @default(3)
  governedBacklogEnabled    Boolean   @default(false)
  // Demand-management policy (EP-DEMAND-MGMT Phase 4): the operator-owned,
  // audited scoring policy the demand engine reads instead of a hardcoded
  // default. demandFramework = active scoring framework (rice|wsjf|value_effort|
  // weighted); demandBucketTargets = org-wide default investment allocation,
  // e.g. { "run": 70, "grow": 20, "transform": 10 }. null = built-in defaults
  // (rice, 70/20/10). §11.
  demandFramework           String?
  demandBucketTargets       Json?
  // Use-it-or-lose-it capacity draining (EP-DEMAND-MGMT / capacity automation).
  // When enabled, near the weekly pre-paid LLM allocation reset with a healthy
  // (non-exhausted) pool and free build slots, the scheduled evaluator dispatches
  // top demand-ranked ready work up to the WIP cap so allocation is not wasted.
  // All nullable/defaulted → off by default (opt-in). See lib/capacity/drain-policy.ts.
  capacityDrainEnabled      Boolean   @default(false)
  /// Weekly reset day-of-week in UTC (0=Sun … 6=Sat). Default Monday.
  capacityResetDow          Int       @default(1)
  /// Weekly reset hour in UTC (0–23).
  capacityResetHourUtc      Int       @default(0)
  /// Start draining once within this many hours of the reset.
  capacityDrainWindowHours  Int       @default(12)
  /// Max builds to dispatch per drain evaluation (still bounded by the WIP cap).
  capacityDrainMaxDispatch  Int       @default(3)
  // Hive Contributions consent (spec §6.1). Device-fingerprint contribution is
  // opt-in, DEFAULTED ON because outbound fingerprints are PII-free
  // (redactFingerprintEvidence, fail-closed). The master pause halts ALL
  // contribution types immediately.
  deviceFingerprintOptIn    Boolean   @default(true)
  hiveContributionsPaused   Boolean   @default(false)
  // Upstream feedback escalation consent (BI-6D45BA27, spec 2026-06-06 §3).
  // OPT-IN, defaulted OFF: nothing leaves the install until a user explicitly
  // consents. The AI coworker surfaces the consent prompt and the
  // "Report to the project team" action.
  upstreamFeedbackOptIn     Boolean   @default(false)
  upstreamFeedbackOptInAt   DateTime?
  upstreamFeedbackOptInById String?
  upstreamFeedbackOptInBy   User?     @relation("PlatformDevUpstreamFeedbackOptInBy", fields: [upstreamFeedbackOptInById], references: [id])
  // Configurable intake relay target (spec §4). When set, the install posts
  // redacted reports here (install-authenticated) instead of calling GitHub
  // directly — the no-token consumer path and the reseller seam.
  upstreamRelayUrl          String?
}

// One ledger for everything that flows to the hive — what was shared, when,
// its type, and its curation status (spec §6.1: "one contribution ledger").
model HiveContributionLedger {
  id                    String                           @id @default(cuid())
  // "device_fingerprint" | "source" | "improvement" (extensible).
  contributionType      String
  // The stable obfuscated contributor pseudonym used across all types.
  contributor           String
  // For device-fingerprint contributions: the rule key shared.
  ruleKey               String?
  summary               String
  // Hash of the contributed payload for dedup/audit without storing PII.
  payloadHash           String?
  // submitted | curating | accepted | rejected | withdrawn
  status                String                           @default("submitted")
  redactionStatus       String?
  // Result-only contribution body and opaque source receipt. Intake commits
  // independently of downstream forge delivery so a provider outage cannot
  // lose a contribution or expose the contributor's private backlog.
  resultBundle          Json?
  sourceReceipt         String?                          @unique
  deliveryProvider      String?
  deliveryStatus        String                           @default("not-requested")
  deliveryAttempts      Int                              @default(0)
  deliveryRemoteRef     String?
  deliveryError         String?
  nextDeliveryAt        DateTime?
  deliveredAt           DateTime?
  reviewedByPrincipalId String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  partnerRecognitions   PartnerContributionRecognition[]

  @@index([contributionType])
  @@index([status])
  @@index([contributor])
  @@index([deliveryStatus, nextDeliveryAt])
}

