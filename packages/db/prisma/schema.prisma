  fromDiscoveredItem      DiscoveredItem         @relation("DiscoveredRelationshipFromItem", fields: [fromDiscoveredItemId], references: [id], onDelete: Cascade)
  inventoryRelationship   InventoryRelationship? @relation(fields: [inventoryRelationshipId], references: [id])
  toDiscoveredItem        DiscoveredItem         @relation("DiscoveredRelationshipToItem", fields: [toDiscoveredItemId], references: [id], onDelete: Cascade)

