generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "ts"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // BET-5 (BI-A1E864A5): vectors move Qdrant -> pgvector, graph hierarchy uses ltree.
  extensions = [vector, ltree]
}

enum IntakeSource {
  user_conversation
  artifact_reference
  existing_example
  coworker_proposal
  innovation_radar
}

enum BriefConfidence {
  high
  medium
  low
}

enum BriefStatus {
  draft
  gathering_evidence
  redacting
  interpreting
  awaiting_clarification
  accepted
  converted_to_build
  rejected
  superseded
}

enum PrincipalSensitivity {
  public
  internal
  confidential
  restricted
}

