/// Durable operational identity for an animal. A public AdoptableAnimal row is
/// an optional projection of this record, never the source of custody truth.
model AnimalProfile {
  id                String                @id @default(cuid())
  animalRef         String
  organizationId    String
  storefrontId      String?
  externalSourceKey String?
  name              String
  species           String?
  breed             String?
  sex               String?
  birthDate         DateTime?
  approximateAge    String?
  microchipNumber   String?
  lifecycleStatus   AnimalLifecycleStatus @default(in_care)
  source            String                @default("operator")
  sourceRef         String?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storefront      StorefrontConfig?           @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  publicListing   AdoptableAnimal?
  custodyEpisodes AnimalCustodyEpisode[]
  custodyEvents   AnimalCustodyEvent[]
  applications    AnimalAdoptionApplication[]
  placements      AnimalPlacement[]

  @@unique([organizationId, animalRef])
  @@unique([organizationId, externalSourceKey])
  @@unique([id, organizationId])
  @@index([organizationId, lifecycleStatus, updatedAt])
  @@index([storefrontId])
}

/// One admission-to-outcome interval. Re-entry creates a new numbered episode
/// instead of rewriting the animal's prior history.
model AnimalCustodyEpisode {
  id              String             @id @default(cuid())
  episodeRef      String             @unique
  organizationId  String
  animalProfileId String
  episodeNumber   Int
  intakeType      AnimalIntakeType
  intakeSource    String?
  intakeLocation  String?
  openedAt        DateTime
  currentStage    AnimalCustodyStage @default(intake)
  legalHoldActive Boolean            @default(false)
  legalHoldReason String?
  closedAt        DateTime?
  outcomeType     AnimalOutcomeType?
  outcomeReason   String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  animal       AnimalProfile        @relation(fields: [animalProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events       AnimalCustodyEvent[]

  @@unique([animalProfileId, episodeNumber])
  @@unique([id, organizationId])
  @@index([animalProfileId, organizationId])
  @@index([organizationId, currentStage, openedAt])
}

/// Append-only custody timeline; sequence is monotonic inside an episode.
model AnimalCustodyEvent {
  id                String                 @id @default(cuid())
  eventRef          String                 @unique
  organizationId    String
  animalProfileId   String
  custodyEpisodeId  String
  sequence          Int
  fromStage         AnimalCustodyStage?
  toStage           AnimalCustodyStage
  kind              AnimalCustodyEventKind @default(stage_transition)
  reason            String?
  actorPrincipalRef String
  occurredAt        DateTime               @default(now())
  createdAt         DateTime               @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  animal       AnimalProfile        @relation(fields: [animalProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  episode      AnimalCustodyEpisode @relation(fields: [custodyEpisodeId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([custodyEpisodeId, sequence])
  @@index([custodyEpisodeId, organizationId])
  @@index([organizationId, animalProfileId, occurredAt])
}

model AnimalAdoptionApplication {
  id                   String                          @id @default(cuid())
  applicationRef       String                          @unique
  organizationId       String
  animalProfileId      String
  inquiryRef           String?
  applicantContactRef  String?
  applicantName        String?
  status               AnimalAdoptionApplicationStatus @default(submitted)
  reviewerPrincipalRef String?
  decisionReason       String?
  submittedAt          DateTime                        @default(now())
  decidedAt            DateTime?
  version              Int                             @default(1)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  animal       AnimalProfile    @relation(fields: [animalProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  placement    AnimalPlacement?

  @@unique([id, organizationId])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, animalProfileId, status])
}

model AnimalPlacement {
  id                String                @id @default(cuid())
  placementRef      String                @unique
  organizationId    String
  animalProfileId   String
  applicationId     String                @unique
  adopterContactRef String?
  status            AnimalPlacementStatus @default(reserved)
  placedAt          DateTime?
  returnedAt        DateTime?
  returnReason      String?
  adoptionFeeAmount Decimal?
  currency          String                @default("USD")
  paymentRef        String?
  allocationRef     String?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  animal       AnimalProfile             @relation(fields: [animalProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  application  AnimalAdoptionApplication @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([applicationId, organizationId])
  @@index([organizationId, status, placedAt])
  @@index([organizationId, animalProfileId, createdAt])
}

model StorefrontInquiry {
  id                String           @id @default(cuid())
  inquiryRef        String           @unique
  storefrontId      String
  itemId            String?
  customerContactId String?
  customerEmail     String
  customerName      String
  customerPhone     String?
  message           String?
  formData          Json?
  status            String           @default("new")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  storefront        StorefrontConfig @relation(fields: [storefrontId], references: [id])

  @@index([storefrontId, status])
  @@index([customerEmail])
}

model StorefrontDonation {
  id                String           @id @default(cuid())
  donationRef       String           @unique
  storefrontId      String
  customerContactId String?
  donorEmail        String
  donorName         String?
  amount            Decimal
  currency          String           @default("USD")
  campaignId        String?
  fundId            String?
  message           String?
  isAnonymous       Boolean          @default(false)
  status            String           @default("pending")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  storefront        StorefrontConfig @relation(fields: [storefrontId], references: [id])
  fund              FinancialFund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([storefrontId, status])
  @@index([donorEmail])
  @@index([fundId])
}

// ─── Finance: Accounts Payable ─────────────────────────────────────

// ── Stock coverage starter (EP-SPEND-PROCUREMENT-ASSETS, BI-SPEND-003 slice) ──
// The smallest honest model of "are we about to run out of what we sell":
// a stocked supply the operator counts, and the per-unit link from a sellable
// StorefrontItem to the supplies it consumes.
//
// Deliberately NOT a warehouse system. onHandQuantity is operator-maintained
// (a stocktake number), and CONSUMPTION IS DERIVED FROM ACTUAL SALES rather
// than from a decrement ledger — which is how a small operator actually works,
// and which keeps this slice free of partial-fulfilment/reversal semantics.
// Receipts, adjustments, valuation, and COGS posting remain BI-SPEND-003 scope.
//
// Naming note: `InventoryEntity` is the IT-estate discovery model and `Bom*` is
// the software bill of materials; neither describes physical supplies, so this
// is genuinely new substrate rather than a fork of either.
model StockItem {
  id              String   @id @default(cuid())
  stockItemId     String   @unique
  organizationId  String
  name            String
  /// Counting unit the operator thinks in (kg, litre, each, case).
  unit            String
  /// Latest counted quantity. Operator-maintained; not a running ledger.
  onHandQuantity  Decimal  @default(0)
  /// Reorder when coverage falls to/below this quantity.
  reorderPoint    Decimal  @default(0)
  /// Suggested quantity to order when below the reorder point.
  reorderQuantity Decimal  @default(0)
  supplierId      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  components   StorefrontItemComponent[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([supplierId])
}

/// One line of a sellable item's recipe: selling one unit of `storefrontItem`
/// consumes `quantityPerUnit` of `stockItem`. Archetype-neutral — a dish
/// consumes mozzarella, a salon service consumes colourant.
model StorefrontItemComponent {
  id               String   @id @default(cuid())
  storefrontItemId String
  stockItemId      String
  quantityPerUnit  Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  storefrontItem StorefrontItem @relation(fields: [storefrontItemId], references: [id], onDelete: Cascade)
  stockItem      StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([storefrontItemId, stockItemId])
  @@index([stockItemId])
}

// ─── Course Management ────────────────────────────────────────────
model CourseProduct {
  id                String           @id @default(cuid())
  courseProductId   String           @unique
  name              String
  description       String?
  standardPriceUsd  Decimal
  durationDays      Int
  certificationBody String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  instances         CourseInstance[]

  @@index([isActive])
  @@index([certificationBody])
}

model CourseInstance {
  id                String               @id @default(cuid())
  jobCode           String               @unique
  courseProductId   String
  startDate         DateTime
  endDate           DateTime
  trainerName       String?
  location          String?
  isPublic          Boolean              @default(true)
  customerTag       String?
  maxSeats          Int
  currentEnrollment Int                  @default(0)
  pricePerSeatUsd   Decimal?
  status            String               @default("scheduled")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  courseProduct     CourseProduct        @relation(fields: [courseProductId], references: [id])
  registrations     CourseRegistration[]

  @@index([courseProductId, status])
  @@index([startDate])
  @@index([isPublic, status])
  @@index([customerTag])
}

model CourseRegistration {
  id               String         @id @default(cuid())
  registrationId   String         @unique
  courseInstanceId String
  firstName        String
  lastName         String
  email            String
  phone            String?
  company          String?
  country          String?
  role             String?
  netFeeUsd        Decimal        @default(0)
  vatAmount        Decimal        @default(0)
  instructorCost   Decimal        @default(0)
  materialsCost    Decimal        @default(0)
  voucherCost      Decimal        @default(0)
  grossProfit      Decimal?
  paymentStatus    String         @default("pending")
  paidDate         DateTime?
  stripeRef        String?
  b2cInvoice       String?
  xeroRef          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  courseInstance   CourseInstance @relation(fields: [courseInstanceId], references: [id])
  examVoucher      ExamVoucher?

  @@index([courseInstanceId, paymentStatus])
  @@index([email])
  @@index([stripeRef])
  @@index([xeroRef])
}

model ExamVoucher {
  id               String             @id @default(cuid())
  registrationId   String             @unique
  ogId             String?
  voucherType      String?
  voucherExpiry1   DateTime?
  voucherExpiry2   DateTime?
  ogStoreReference String?
  status           String             @default("pending")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  registration     CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([ogId])
  @@index([status])
}
