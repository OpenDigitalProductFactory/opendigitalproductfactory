/// Operator-authored geometry for one operational-twin scene. Live business
/// state remains in its owning domain models and is joined through layoutState
/// placement entity references at read time.
model OperationalSceneLayout {
  id           String       @id @default(cuid())
  orgId        String
  twinTemplate String
  spaceKind    String
  locationId   String?
  label        String
  layoutState  Json
  underlayRef  String?
  version      Int          @default(1)
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())
