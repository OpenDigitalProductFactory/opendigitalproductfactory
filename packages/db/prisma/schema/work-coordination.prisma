  @@index([backlogItemId, recordedAt(sort: Desc)])
  @@index([backlogItemId, gateKey, recordedAt(sort: Desc), id(sort: Desc)])
  @@index([kind, recordedAt(sort: Desc)])
  @@index([recordedAt]) // retention sweep cutoff scan, apps/web/lib/operate/retention/execute.ts:99
}

model InitiativeArtifactRetentionPin {
