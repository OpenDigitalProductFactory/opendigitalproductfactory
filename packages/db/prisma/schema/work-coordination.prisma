model BacklogItem {
  id                      String                        @id @default(cuid())
  itemId                  String                        @unique
  title                   String
  status                  String
  type                    String
  // Cross-org sharing classification (BI-DC4E526E). Deny-by-default — only
  // `public` may cross an organization boundary in federated demand (kernel
  // DI-3E77E48D5710). Default `internal` so unclassified proprietary demand
  // never leaks upstream.
  sensitivity             BacklogSensitivity            @default(internal)
  body                    String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  priority                Int?
  digitalProductId        String?
  // Product-management demand scope (EP-ED496EB0 Phase 8). Business Product
  // and EEMD DigitalProduct remain separate targets; application invariants
  // require organization context and at most one narrower target. Nullable
  // expand-first columns preserve historical rows as explicitly unclassified.
  organizationId          String?
  productLineId           String?
  businessProductId       String?
  taxonomyNodeId          String?
  epicId                  String?
  portfolioId             String?
  source                  String?
  workType                String?
  triageOutcome           String?
  effortSize              String?
  proposedOutcome         String?
  // Demand-management scoring (EP-DEMAND-MGMT Phase 1). Store the scoring
  // INPUTS as first-class nullable fields; the score is COMPUTED by a pluggable
  // framework (apps/web/lib/demand/scoring.ts). null = not yet scored. reach
  // seeds from occurrenceCount and jobSize from effortSize when the explicit
  // field is absent. demandStage is an additive funnel facet orthogonal to
  // status (which continues to gate work-claims). Spec:
  // docs/superpowers/specs/2026-07-10-demand-management-design.md §5.
  demandStage             DemandStage?
  reach                   Int?
  impact                  Float?
  confidence              Float?
  businessValue           Int?
  timeCriticality         Int?
  riskOpportunity         Int?
  jobSize                 Float?
  demandScore             Float?
  demandScoreFramework    DemandScoreFramework?
  demandScoreComputedAt   DateTime?
  // Investment bucket (EP-DEMAND-MGMT Phase 3): run | grow | transform. The
  // strategic-balance dimension so demand is prioritized against a target
  // allocation, not a flat list. Default derived from workType. §8.
  investmentBucket        InvestmentBucket?
  // Backlog archetype scope (BI-E387A203). Nullable/additive so existing
  // planning rows honestly remain unclassified until backfilled.
  scopeKind               String?
  archetypeCategories     String[]                      @default([])
  archetypeIds            String[]                      @default([])
  scopeRationale          String?
  lifecycleTags           String[]                      @default([])
  // Estimate provenance (EP-DELIVERY-FLOW BI-E731A6C1). The effort estimate
  // (jobSize) is the value/effort score's DENOMINATOR; these facets attribute
  // WHOSE number it is — an AI coworker's first-pass proposal and a human's
  // confirm/overrule — so the Delivery Flow can show AI<->human divergence, a
  // reconcile affordance, and mark the score trustworthy once agreed. jobSize
  // stays the effective denominator scoring reads; the write door
  // (record_effort_estimate) mirrors the resolved effective estimate into it.
  // All additive-nullable — null = no attributed estimate yet; the
  // jobSize/effortSize fallbacks feed scoring unchanged. Resolver:
  // apps/web/lib/demand/estimate-provenance.ts. Spec: 2026-07-12-delivery-flow
  // -demand-backlog-unification-design.md §"Collaborative estimation".
  estimateAiJobSize       Float?
  estimateAiById          String?
  estimateAiAt            DateTime?
  estimateHumanJobSize    Float?
  estimateHumanById       String?
  estimateHumanAt         DateTime?
  estimateSource          EstimateSource?
  estimateAgreed          Boolean?
  activeBuildId           String?                       @unique
  activeEpicId            String?                       @unique
  duplicateOfId           String?
  resolution              String?
  abandonReason           String?
  stalenessDetectedAt     DateTime?
  occurrenceCount         Int                           @default(1)
  lastSeenAt              DateTime?
  submittedById           String?
  completedAt             DateTime?
  agentId                 String?
  accountableEmployeeId   String?
  claimedById             String?
  claimedByAgentId        String?
  claimedAt               DateTime?
  claimStatus             String?
  // Governed active-deferral projection (DI-03B7564E648A). History remains in
  // BacklogItemActivity; these fields answer why/when/who without replaying it.
  deferReason             String?
  deferTrigger            String?
  deferReviewAt           DateTime?
  deferOwnerPrincipalId   String?
  deferredAt              DateTime?
  upstreamIssueNumber     Int?
  upstreamIssueUrl        String?
  upstreamSyncedAt        DateTime?
  accountableEmployee     EmployeeProfile?              @relation("ItemAccountable", fields: [accountableEmployeeId], references: [id])
  deferOwnerPrincipal     Principal?                    @relation("BacklogDeferralOwner", fields: [deferOwnerPrincipalId], references: [id], onDelete: SetNull)
  activeBuild             FeatureBuild?                 @relation("BacklogItemActiveBuild", fields: [activeBuildId], references: [id])
  activeEpic              Epic?                         @relation("BacklogItemActiveEpic", fields: [activeEpicId], references: [id])
  originatingEpic         Epic?                         @relation("EpicOriginatingItem")
  digitalProduct          DigitalProduct?               @relation(fields: [digitalProductId], references: [id])
  organization            Organization?                 @relation("BacklogItemOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  productLine             ProductLine?                  @relation("BacklogItemProductLine", fields: [productLineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  businessProduct         Product?                      @relation("BacklogItemBusinessProduct", fields: [businessProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  duplicateOf             BacklogItem?                  @relation("BacklogItemDuplicates", fields: [duplicateOfId], references: [id])
  duplicates              BacklogItem[]                 @relation("BacklogItemDuplicates")
  epic                    Epic?                         @relation(fields: [epicId], references: [id])
  featureBuilds           FeatureBuild[]                @relation("BacklogItemOriginator")
  submittedBy             User?                         @relation("BacklogSubmissions", fields: [submittedById], references: [id])
  taxonomyNode            TaxonomyNode?                 @relation(fields: [taxonomyNodeId], references: [id])
  activities              BacklogItemActivity[]
  demandEvidenceLinks     DemandEvidenceLink[]
  coworkerNeeds           CoworkerCapabilityNeed[]      @relation("BacklogItemCoworkerCapabilityNeeds")
  businessCapabilityLinks BusinessCapabilityTraceLink[] @relation("BusinessCapabilityBacklogLinks")
  founderDemandClusters   FounderDemandCluster[]
  productObjectiveWork    ProductObjectiveWork[]

  @@index([portfolioId])
  @@index([organizationId])
  @@index([productLineId])
  @@index([businessProductId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([status, deferReviewAt])
  @@index([deferOwnerPrincipalId, status])
  @@index([portfolioId, demandScore])
  @@index([demandStage])
  @@index([scopeKind])
  @@index([duplicateOfId]) // FK-leading (self-relation): duplicate-chain reverse lookup, apps/web/lib/mcp/backlog-retirement-handlers.ts:55
  @@index([epicId]) // FK-leading (spine): open-items-per-epic scan, apps/web/lib/mcp/backlog-retirement-handlers.ts:168
}

// Direct, queryable evidence linked to the canonical BacklogItem demand record.
// The source remains authoritative in its own domain. This child owns only the
// reviewed link, evidence-at-link snapshot, and provenance used to explain an
// investment score without hiding current references in activity JSON.
model DemandEvidenceLink {
  id                  String      @id @default(cuid())
  evidenceLinkId      String      @unique
  backlogItemId       String
  sourceKind          String
  sourceRef           String
  wikiPageId          String?
  title               String
  summary             String?     @db.Text
  confidence          Float?
  reviewedAt          DateTime?
  status              String      @default("active")
  provenance          Json?
  linkedByPrincipalId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  backlogItem         BacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)
  wikiPage            WikiPage?   @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)

  @@unique([backlogItemId, sourceKind, sourceRef])
  @@index([backlogItemId, status])
  @@index([sourceKind, sourceRef])
  @@index([wikiPageId])
}

// Per-item timeline. Cross-cutting tool audit lives in ToolExecution; this is
// the entity-scoped view used by get_backlog_item and the UI.
model BacklogItemActivity {
  id                String                          @id @default(cuid())
  backlogItemId     String
