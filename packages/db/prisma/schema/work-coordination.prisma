// ─────────────────────────────────────────────────────────────────────────────
// Closed-set vocabularies (BI-817ED2D4, Simplify & Strengthen W4, architecture
// pass 2026-08-16 §3.2-a). Closed-set string fields are typed enums (AGENTS.md
// §8); long-lived columns migrate expand→contract because fleet installs may
// hold drifted values.
//
// Two groups below:
//   1. IN USE — the column is already this enum type (direct conversion per
//      the 20260815200100 payroll precedent; each conversion's data-safety
//      argument lives in migration 20260816110000).
//   2. CONTRACT-PENDING — the Postgres type exists and the column carries a
//      `*_closed_set` CHECK (NOT VALID) enforcing new writes, but the Prisma
//      field stays String until the contract step normalizes legacy values and
//      flips the type. Ordered plan (operator-review-required):
//      docs/superpowers/plans/2026-08-16-enum-contract-step-proposal.md
//
// New closed-set String columns are blocked by
// scripts/check-no-new-closed-set-strings.mjs (baseline may only shrink).
// ─────────────────────────────────────────────────────────────────────────────

// ── Group 1: in use ──

// BacklogItem.sensitivity — cross-org sharing classification (BI-DC4E526E).
// Canonical union: apps/web/lib/federation/cross-org-sharing.ts
enum BacklogSensitivity {
  public
  internal
  confidential
  restricted
}

// BacklogItem.estimateSource — estimate provenance (BI-E731A6C1).
// Canonical union: apps/web/lib/demand/estimate-provenance.ts
enum EstimateSource {
  ai
  human
  agreed
}

// BacklogItem.demandStage — demand funnel (EP-DEMAND-MGMT, DI-5CB3AFE78912).
enum DemandStage {
  raw
  screened
  shaped
  ready
}

// BacklogItem.demandScoreFramework — pluggable scoring (DI-4CEA0F5FACCE).
enum DemandScoreFramework {
  rice
  wsjf
  value_effort
  weighted
}

// BacklogItem.investmentBucket — Run/Grow/Transform (DI-8E489A791375).
enum InvestmentBucket {
