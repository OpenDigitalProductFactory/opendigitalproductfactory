// ─────────────────────────────────────────────────────────────────────────────
// Workforce staffing & scheduling substrate (EP-WORKFORCE-OPS / BI-4AD09A35).
// Canonical staffing authority: demand → shifts → assignments → availability →
// preferences → constraints → proposals. Spec:
// docs/superpowers/specs/2026-07-17-organization-workforce-staffing-scheduling-design.md
// Cross-domain references (employee/org/principal/leave/credential/proposal) are
// bare indexed FK columns — matching the schema's organizationId convention — so
// this migration is additive and touches no hub model. Relations are declared
// only within the staffing domain. Closed-set discriminator fields are typed
// enums, or CHECK-constrained Strings pending the enum contract flip
// (BI-817ED2D4; AGENTS.md §8) — a NEW closed-set String column is a defect,
// ratcheted by scripts/check-no-new-closed-set-strings.mjs.
// Times are stored as instants plus a timezone and local-date context (spec §5.3).
// `version` columns carry optimistic concurrency for publication (spec §5.3).
// ─────────────────────────────────────────────────────────────────────────────

/// Required coverage for an interval/location/role. Spec §5.1.1 + §9.9(1):
/// `demandShape` is the first-class discriminator so the solver posture is
/// explicit rather than assumed.
model StaffingDemand {
  id                  String   @id @default(cuid())
  demandId            String   @unique
  organizationId      String
  // coverage_floor | forecast_curve | fixed_slot | task_pipeline | census_load
  demandShape         String
  sourceType          String? // forecast | manual | booking | work | census
  sourceId            String?
  startAt             DateTime
  endAt               DateTime
  timezone            String
  localDateContext    String?
  workLocationId      String?
  occupationProfileId String?
  roleKey             String?
  requiredSkills      String[] @default([])
  requiredCredentials String[] @default([])
  minQuantity         Int      @default(1)
  targetQuantity      Int?
  // headcount-by-formula (spec §9.3): when set, quantity is derived at eval time
  quantityFormula     Json?
  priority            Int      @default(0)
  status              String   @default("open") // open | partially_covered | covered | cancelled
  provenance          Json?
  effectiveVersion    Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shifts       StaffingShift[]
  organization Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([demandShape])
  @@index([startAt, endAt])
  @@index([workLocationId])
}

/// Tentative work interval, mutable until publication. Spec §5.1.2.
model StaffingShift {
  id                 String   @id @default(cuid())
  shiftId            String   @unique
  organizationId     String
  staffingDemandId   String?
  startAt            DateTime
  endAt              DateTime
  timezone           String
  localDateContext   String?
  workLocationId     String?
  requiredQuantity   Int      @default(1)
  lifecycle          String   @default("draft") // draft | proposed | published | cancelled
  publicationVersion Int      @default(0)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  demand        StaffingDemand?        @relation(fields: [staffingDemandId], references: [id])
  assignments   StaffingAssignment[]
  resourceLinks StaffingResourceLink[]
  organization  Organization           @relation(fields: [organizationId], references: [id])

  @@index([organizationId, lifecycle])
  @@index([staffingDemandId])
  @@index([startAt, endAt])
}

/// Authorized (or proposed) binding of a person/crew to a shift. Spec §5.1.3 +
/// §9.9(2,4): assignee may be an individual or a typed crew; `assignmentMode`
/// distinguishes direct assignment from the offer/claim flow used for
/// contractor/renter/volunteer capacity the organization does not command.
model StaffingAssignment {
  id                    String   @id @default(cuid())
  assignmentId          String   @unique
  organizationId        String
  staffingShiftId       String
  assigneeType          String   @default("employee") // employee | crew
  employeeProfileId     String?
  staffingCrewId        String?
  // proposed | offered | claimed | confirmed | declined | withdrawn | completed | on_site
  lifecycle             String   @default("proposed")
  assignmentMode        String   @default("assigned") // assigned | offer_claim
  decisionInteractionId String?
  approverEmployeeId    String?
  acknowledgementState  String   @default("none") // none | pending | acknowledged | declined
  source                String? // solver | manual | swap | import
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shift                   StaffingShift             @relation(fields: [staffingShiftId], references: [id], onDelete: Cascade)
  crew                    StaffingCrew?             @relation(fields: [staffingCrewId], references: [id])
  events                  StaffingAssignmentEvent[]
  hospitalityServiceTurns HospitalityServiceTurn[]
  organization            Organization              @relation(fields: [organizationId], references: [id])

  @@unique([id, organizationId])
  @@index([organizationId, lifecycle])
  @@index([staffingShiftId])
  @@index([employeeProfileId])
  @@index([staffingCrewId])
}

/// Append-only assignment history (spec §5.3): cancellation must not erase who
/// was assigned previously.
model StaffingAssignmentEvent {
  id                   String   @id @default(cuid())
  staffingAssignmentId String
  eventType            String // proposed | confirmed | declined | withdrawn | completed | acknowledged | reassigned
  atVersion            Int
  actorRef             String?
  detail               Json?
  createdAt            DateTime @default(now())

  assignment StaffingAssignment @relation(fields: [staffingAssignmentId], references: [id], onDelete: Cascade)

  @@index([staffingAssignmentId, createdAt])
  @@index([createdAt]) // retention sweep cutoff scan, apps/web/lib/operate/retention/execute.ts:99
}

/// Typed crew / composite assignable unit (spec §9.2.3). Members and their
/// in-crew roles (lead + helper, apprentice paired with journeyman) are the
/// unit's internal composition.
model StaffingCrew {
  id             String   @id @default(cuid())
  crewId         String   @unique
  organizationId String
  name           String?
  crewType       String? // moving | trades_install | catering | event_dept | patrol
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members      StaffingCrewMember[]
  assignments  StaffingAssignment[]
  organization Organization         @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model StaffingCrewMember {
  id                String   @id @default(cuid())
  staffingCrewId    String
  employeeProfileId String
  roleInCrew        String?
  isLead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  crew StaffingCrew @relation(fields: [staffingCrewId], references: [id], onDelete: Cascade)

  @@unique([staffingCrewId, employeeProfileId])
  @@index([employeeProfileId])
}

/// Co-scheduled non-person resources (vehicle/room/operatory/kit/equipment) that
/// share a shift interval, so double-booking detection covers equipment and
/// rooms, not only people (spec §9.9(2)). `resourceRef` points at the owning
/// domain record (e.g. a WorkLocation, vehicle asset, or ServiceProvider room).
model StaffingResourceLink {
  id              String   @id @default(cuid())
  organizationId  String
  staffingShiftId String
  resourceType    String // vehicle | room | operatory | kit | equipment | chair | station | table
  resourceRef     String
  createdAt       DateTime @default(now())

  shift        StaffingShift @relation(fields: [staffingShiftId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@index([staffingShiftId])
  @@index([resourceType, resourceRef])
}

/// Employee-declared or authorized availability window. Spec §5.1.4.
model EmployeeAvailabilityWindow {
  id                String       @id @default(cuid())
  windowId          String       @unique
  organizationId    String
  employeeProfileId String
  kind              String // available | unavailable
  startAt           DateTime
  endAt             DateTime
  timezone          String
  localInterval     String?
  recurrence        String?
  source            String? // employee | hr | derived
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  ownerRef          String?
  confirmationState String       @default("confirmed") // confirmed | pending
  supersededById    String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([employeeProfileId])
  @@index([organizationId, kind])
  @@index([startAt, endAt])
}

/// Typed, consented, weighted scheduling preference. Spec §5.1.5 + §12: only
/// employee-confirmed preferences (origin=explicit or promoted) are binding;
/// inferred origin stays soft and expiring.
model EmployeeSchedulingPreference {
  id                String       @id @default(cuid())
  preferenceId      String       @unique
  organizationId    String
  employeeProfileId String
  preferenceType    String
  scope             String?
  weight            Float        @default(0)
  origin            String       @default("explicit") // explicit | inferred
  consentState      String       @default("pending") // pending | consented | revoked
  confidence        Float?
  evidenceRefs      Json?
  effectiveFrom     DateTime?
  expiresAt         DateTime?
  supersededById    String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([employeeProfileId])
  @@index([organizationId, preferenceType])
}

/// Typed labor-rule predicate + parameters (spec §5.1.6 + §9.8 registry).
/// `organizationId` null = a platform/jurisdiction starter pack rule.
/// `predicateType` names the §9.8 variable family; hard rules cannot be relaxed
/// by the solver, and non-waivable hard rules reject exception creation (§6).
model StaffingConstraintRule {
  id              String        @id @default(cuid())
  ruleId          String        @unique
  organizationId  String?
  predicateType   String
  family          String?
  parameters      Json          @default("{}")
  severity        String        @default("hard") // hard | soft
  applicability   Json          @default("{}") // jurisdiction | archetype | org | unit | location | employmentType
  sourcePolicyUrl String?
  legallyWaivable Boolean       @default(false)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  validationState String        @default("draft") // draft | reviewed | active
  reviewOwnerRef  String?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([predicateType])
  @@index([severity, validationState])
}

/// Immutable optimization run over a versioned input snapshot (spec §5.1.7). A
/// run never mutates assignments; it produces options.
model StaffingProposalRun {
  id                String   @id @default(cuid())
  runId             String   @unique
  organizationId    String
  inputSnapshotHash String
  inputVersion      String?
  solverProvider    String?
  solverVersion     String?
  timeLimitMs       Int?
  // pending | running | feasible | optimal | infeasible | unknown | timeout | failed
  status            String   @default("pending")
  scoreComponents   Json?
  unfilledDemand    Json?
  violations        Json?
  explanation       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  options      StaffingProposalOption[]
  organization Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

model StaffingProposalOption {
  id                    String   @id @default(cuid())
  optionId              String   @unique
  staffingProposalRunId String
  rank                  Int?
  scoreComponents       Json?
  coverage              Json?
  unfilledDemand        Json?
  violations            Json?
  explanation           Json?
  comparison            Json?
  terminalStatus        String?
  createdAt             DateTime @default(now())

  run StaffingProposalRun @relation(fields: [staffingProposalRunId], references: [id], onDelete: Cascade)

  @@index([staffingProposalRunId, rank])
}

/// Request to depart from a waivable organization rule (spec §5.1.8). Hard
/// non-waivable legal/credential rules must reject exception creation at the
/// application layer.
model StaffingExceptionRequest {
  id                       String       @id @default(cuid())
  exceptionId              String       @unique
  organizationId           String
  staffingConstraintRuleId String?
  staffingShiftId          String?
  staffingAssignmentId     String?
  reason                   String
  requestedScope           String?
  expiresAt                DateTime?
  approvingAuthorityRef    String?
  decision                 String       @default("pending") // pending | approved | denied
  decisionInteractionId    String?
  evidence                 Json?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, decision])
  @@index([staffingConstraintRuleId])
}

/// Bounded staging record for communication/integration-derived intent
/// (spec §5.1.9 + §10-§11). Never directly solver-authoritative: it must be
/// employee-confirmed and promoted (to a preference or a LeaveRequest) first.
model WorkforceCandidateFact {
  id                       String       @id @default(cuid())
  candidateFactId          String       @unique
  organizationId           String
  subjectEmployeeProfileId String?
  kind                     String // time_off_intent | availability_hint | preference_hint
  extractedValue           Json?
  confidence               Float?
  sourceEnvelope           Json? // provider | tenant | external id | sender/subject | received | integrity | excerpt/digest
  identityResolution       String       @default("unresolved") // unresolved | resolved | ambiguous
  reviewState              String       @default("pending") // pending | confirmed | edited | rejected
  extractionModelVersion   String?
  inferenceAt              DateTime?
  expiresAt                DateTime?
  correctionOf             String?
  promotionTargetType      String? // preference | leave_request
  promotionTargetId        String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, reviewState])
  @@index([subjectEmployeeProfileId])
  @@index([kind])
}

// ─── Recruiting / ATS (BI-F3AEBF68) ───────────────────────────────────────────
// Native requisition→hire model — the convergence target for the Greenhouse
// absorption (BI-E5561DC9). Additive-only: links to existing People-Core
// entities (Position/Department/WorkLocation/EmploymentType/EmployeeProfile) are
// soft scalar FKs (indexed, no @relation) so this migration creates only new
// tables; typed relations + the candidate→worker crosswalk are follow-on
// hardening. Design: docs/superpowers/specs/2026-08-05-greenhouse-ats-absorption-design.md §3.
model JobRequisition {
  id               String    @id @default(cuid())
  reqId            String    @unique
  title            String
  status           String    @default("draft") // draft|pending_approval|open|on_hold|closed|filled
  headcount        Int       @default(1)
  positionId       String?
  departmentId     String?
  workLocationId   String?
  employmentTypeId String?
  hiringManagerId  String?
  recruiterId      String?
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  openings     RequisitionOpening[]
  postings     JobPosting[]
  stages       PipelineStage[]
  applications Application[]

  // Typed People-Core relations (BI-7ACC38CE, kernel DI-A114C610DFD9). All
  // nullable + onDelete SetNull: a requisition survives the removal of a
  // position/department/location/type/employee. Populated only by native
  // authoring (never by absorption, which holds external refs in
  // StagedRecord + MasterDataSourceRef).
  position       Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workLocation   WorkLocation?    @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  employmentType EmploymentType?  @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  hiringManager  EmployeeProfile? @relation("ReqHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiter      EmployeeProfile? @relation("ReqRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([positionId])
  @@index([departmentId])
  @@index([workLocationId])
  @@index([employmentTypeId])
  @@index([hiringManagerId])
  @@index([recruiterId])
}

model RequisitionOpening {
  id                    String   @id @default(cuid())
  requisitionId         String
  openingRef            String?
  status                String   @default("open") // open|closed|filled
  filledByApplicationId String?
  closeReason           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  requisition JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([status])
}

model JobPosting {
  id             String    @id @default(cuid())
  requisitionId  String
  title          String
  description    String?
  locationText   String?
  employmentType String?
  remote         Boolean   @default(false)
  compCurrency   String?
  compMin        Decimal?
  compMax        Decimal?
  live           Boolean   @default(false)
  locale         String    @default("en-US")
  channels       String[]  @default([])
  datePosted     DateTime?
  validThrough   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requisition JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([live])
}

model RecruitingSource {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("other") // referral|job-board|agency|internal|other
  createdAt DateTime @default(now())

  candidates   Candidate[]
  applications Application[]

  @@index([type])
}

model Candidate {
  id          String   @id @default(cuid())
  candidateId String   @unique
  kind        String   @default("candidate") // prospect|candidate
  firstName   String?
  lastName    String?
  displayName String
  email       String?
  phone       String?
  title       String?
  company     String?
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source       RecruitingSource? @relation(fields: [sourceId], references: [id])
  applications Application[]

  @@index([kind])
  @@index([email])
}

model PipelineStage {
  id            String   @id @default(cuid())
  requisitionId String?
  name          String
  orderIndex    Int      @default(0)
  kind          String   @default("interview") // application_review|screen|interview|offer|hired
  createdAt     DateTime @default(now())

  requisition         JobRequisition?      @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  currentApplications Application[]        @relation("ApplicationCurrentStage")
  interviews          ScheduledInterview[]

  @@index([requisitionId])
}

model Application {
  id                  String    @id @default(cuid())
  applicationId       String    @unique
  candidateId         String
  requisitionId       String?
  status              String    @default("active") // active|rejected|hired|withdrawn|converted
  currentStageId      String?
  sourceId            String?
  dispositionReasonId String?
  appliedAt           DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidate            Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisition          JobRequisition?       @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  currentStage         PipelineStage?        @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  source               RecruitingSource?     @relation(fields: [sourceId], references: [id])
  dispositionReason    DispositionReason?    @relation(fields: [dispositionReasonId], references: [id])
  interviews           ScheduledInterview[]
  scorecards           Scorecard[]
  offers               Offer[]
  demographicResponses DemographicResponse[]

  @@index([candidateId])
  @@index([requisitionId])
  @@index([status])
}

model ScheduledInterview {
  id            String    @id @default(cuid())
  applicationId String
  stageId       String?
  startsAt      DateTime?
  endsAt        DateTime?
  location      String?
  videoUrl      String?
  status        String    @default("scheduled") // scheduled|completed|cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  scorecards  Scorecard[]

  @@index([applicationId])
}

model Scorecard {
  id                    String    @id @default(cuid())
  applicationId         String
  interviewId           String?
  submittedById         String?
  overallRecommendation String?
  attributes            Json?
  submittedAt           DateTime?
  createdAt             DateTime  @default(now())

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   ScheduledInterview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  // BI-7ACC38CE: the interviewer/submitter is a native worker.
  submittedBy EmployeeProfile?    @relation("ScorecardSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([submittedById])
}

model Offer {
  id            String    @id @default(cuid())
  offerRef      String    @unique
  applicationId String
  version       Int       @default(1)
  status        String    @default("draft") // draft|approved|sent|accepted|declined|rescinded
  startDate     DateTime?
  compensation  Json?
  sentAt        DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
}

model DispositionReason {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  category  String   @default("rejected") // rejected|withdrawn|hired
  createdAt DateTime @default(now())

  applications Application[]
}

model DemographicResponse {
  id               String    @id @default(cuid())
  applicationId    String
  jurisdiction     String    @default("US") // jurisdiction-gated (design §6): US OFCCP solicits; MX restricts
  race             String?
  ethnicity        String?
  gender           String?
  veteranStatus    String?
  disabilityStatus String?
  consentGiven     Boolean   @default(false)
  collectedAt      DateTime?
  createdAt        DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([jurisdiction])
}

// ---------------------------------------------------------------------------
// Payslip component lines and deduction elections (BI-EAC670F1)
//
// Payslip currently stores earnings / employeeDeductions / employerCosts as Json
// blobs. That is fine for display and wrong for everything else: GL posting,
// reimbursement-in-payroll and payroll-tax emission all need to read the SAME
// line shape, and a Json blob cannot be joined, aggregated or constrained.
//
// This is the EXPAND half of an expand->contract migration. Rows are written
// alongside the existing Json; a later migration backfills historical payslips
// and drops the Json columns. Nothing here removes or rewrites existing data.
// ---------------------------------------------------------------------------

enum PayComponentKind {
  earning
  pre_tax_deduction
  statutory
  post_tax_deduction
  employer_cost
  reimbursement
}

enum DeductionElectionKind {
  benefit
  retirement
  garnishment
  charitable
  loan_repayment
  other
}

/// One money line on a payslip. `taxable` is explicit rather than inferred from
/// the kind because a reimbursement and a non-taxable benefit are both excluded
/// from the tax base for different reasons, and the emitter must not have to
/// re-derive that rule.
model PayComponentLine {
  id              String           @id @default(cuid())
  payslipId       String
  componentKind   PayComponentKind
  code            String
  label           String
  amount          Decimal          @db.Decimal(14, 2)
  currency        String           @default("USD")
  taxable         Boolean          @default(true)
  ledgerAccountId String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())

  payslip       Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount? @relation("PayComponentLedgerAccount", fields: [ledgerAccountId], references: [id], onDelete: SetNull)

  // One line per code per payslip — makes recomputing a run idempotent.
  @@unique([payslipId, code])
  // FK-leading (payslipId): render or post a payslip's lines in order.
  @@index([payslipId, componentKind, sortOrder])
  // FK-leading (ledgerAccountId): trace a ledger account back to the payroll lines behind it.
  @@index([ledgerAccountId])
}

/// A standing instruction to deduct something from an employee's pay.
/// Effective-dated so a mid-year change never rewrites what an earlier run
/// already computed.
model EmployeeDeductionElection {
  id                          String                @id @default(cuid())
  employeeDeductionElectionId String                @unique
  employeeProfileId           String
  electionKind                DeductionElectionKind
  code                        String
  label                       String
  /// Fixed money per period. Exactly one of amount / percentOfGross is set.
  amount                      Decimal?              @db.Decimal(14, 2)
  /// Percentage of gross, e.g. 0.05 for 5%.
  percentOfGross              Decimal?              @db.Decimal(6, 4)
  currency                    String                @default("USD")
  preTax                      Boolean               @default(false)
  /// Statutory ceiling for garnishments — the run must not deduct beyond it.
  annualCapAmount             Decimal?              @db.Decimal(14, 2)
  effectiveFrom               DateTime
  effectiveTo                 DateTime?
  lifecycle                   RecordLifecycle       @default(active)
  lifecycleAt                 DateTime?
  lifecycleReason             String?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  employeeProfile EmployeeProfile @relation("EmployeeDeductionElections", fields: [employeeProfileId], references: [id], onDelete: Cascade)

  // FK-leading (employeeProfileId): resolve an employee's live elections for a run date.
  @@index([employeeProfileId, lifecycle, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Mileage capture (EP-MILEAGE-ABSORB, BI-6D98AD8A)
//
// Absorbs the MileIQ-class job: a driver's business trips are captured without
// them acting, classified by rule where possible, and monetised onto the
// existing ExpenseClaim spine (finance.prisma) rather than a parallel
// reimbursement path. Capture is consent-gated — DriverLocationConsent is a
// precondition for any background fix, not an afterthought.
// ---------------------------------------------------------------------------

enum VehicleOwnershipKind {
  company
  personal
}

enum TripCaptureKind {
  automatic
  manual
  imported
}

enum TripClassificationKind {
  unclassified
  business
  personal
  commute
}

enum TripClassifierKind {
  driver
  rule
  admin
}

enum MileageRuleKind {
  repeated_route
  work_hours
  commute_exclusion
}

enum MileageRuleScopeKind {
  driver
  team
  organization
}

enum DriverLocationConsentStatus {
  pending
  granted
  revoked
  expired
}

/// A vehicle a driver logs business mileage against. Company-owned vehicles
/// point at the FixedAsset row so depreciation and mileage share one asset.
model Vehicle {
  id                String               @id @default(cuid())
  vehicleId         String               @unique
  organizationId    String
  employeeProfileId String?
  fixedAssetId      String?              @unique
  label             String
  ownership         VehicleOwnershipKind
  registrationRef   String?
  lifecycle         RecordLifecycle      @default(active)
  lifecycleAt       DateTime?
  lifecycleReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization    Organization     @relation("VehicleOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile? @relation("VehicleDriver", fields: [employeeProfileId], references: [id], onDelete: SetNull)
  fixedAsset      FixedAsset?      @relation("VehicleFixedAsset", fields: [fixedAssetId], references: [id], onDelete: SetNull)
  trips           Trip[]

  // FK-leading (organizationId): org fleet roster filtered by live rows.
  @@index([organizationId, lifecycle])
  // FK-leading (employeeProfileId): a driver's own vehicle picker in the mobile app.
  @@index([employeeProfileId, lifecycle])
}

/// One captured drive. Distance is stored in metres as an integer so no
/// rounding is baked in at capture time; the reimbursable money is derived from
/// the effective-dated MileageRate in force on startedAt, never from today's rate.
model Trip {
  id                   String                 @id @default(cuid())
  tripId               String                 @unique
  organizationId       String
  employeeProfileId    String
  vehicleId            String?
  startedAt            DateTime
  endedAt              DateTime
  startLatitude        Decimal                @db.Decimal(10, 7)
  startLongitude       Decimal                @db.Decimal(10, 7)
  endLatitude          Decimal                @db.Decimal(10, 7)
  endLongitude         Decimal                @db.Decimal(10, 7)
  startPlaceLabel      String?
  endPlaceLabel        String?
  /// ISO 3166-1 alpha-2 of where the drive happened, DERIVED by the capturing
  /// device from its own location — never chosen by the driver. NULL means the
  /// device could not resolve one (no signal, permission withheld, an older
  /// client), which prices the trip on the employee's country of record rather
  /// than guessing at a country.
  countryCode          String?
  distanceMeters       Int
  captureKind          TripCaptureKind
  classification       TripClassificationKind @default(unclassified)
  classifiedByKind     TripClassifierKind?
  classifiedAt         DateTime?
  classificationRuleId String?
  customerAccountId    String?
  mileageRateId        String?
  reimbursableAmount   Decimal?
  currency             String                 @default("USD")
  expenseItemId        String?                @unique
  notes                String?
  lifecycle            RecordLifecycle        @default(active)
  lifecycleAt          DateTime?
  lifecycleReason      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization       Organization           @relation("TripOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  employeeProfile    EmployeeProfile        @relation("TripDriver", fields: [employeeProfileId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  classificationRule TripClassificationRule? @relation(fields: [classificationRuleId], references: [id], onDelete: SetNull)
  customerAccount    CustomerAccount?       @relation("TripCustomerAccount", fields: [customerAccountId], references: [id], onDelete: SetNull)
  mileageRate        MileageRate?           @relation("TripMileageRate", fields: [mileageRateId], references: [id], onDelete: Restrict)
  expenseItem        ExpenseItem?           @relation("TripExpenseItem", fields: [expenseItemId], references: [id], onDelete: SetNull)

  // FK-leading (employeeProfileId): the driver's own trip list, newest first.
  @@index([employeeProfileId, startedAt])
  // FK-leading (organizationId): admin review queue of unclassified/business trips in a period.
  @@index([organizationId, classification, startedAt])
  // FK-leading (vehicleId): per-vehicle mileage totals for an asset.
  @@index([vehicleId, startedAt])
  // FK-leading (classificationRuleId): which trips a rule has claimed, for rule review.
  @@index([classificationRuleId])
  // FK-leading (customerAccountId): job-costed and rebillable mileage per customer.
  @@index([customerAccountId, startedAt])
  // FK-leading (mileageRateId): rate-change impact analysis over already-priced trips.
  @@index([mileageRateId])
}

/// Auto-classification rules. One model covers all three MileIQ-class behaviours
/// (repeated route, work hours, commute exclusion) because they differ only in
/// predicate, not in shape. Scope widens driver -> team -> organization.
model TripClassificationRule {
  id                 String                 @id @default(cuid())
  tripClassificationRuleId             String                 @unique
  organizationId     String
  employeeProfileId  String?
  ruleKind           MileageRuleKind
  scopeKind          MileageRuleScopeKind
  resultClassification TripClassificationKind
  predicate          Json
  priority           Int                    @default(100)
  lifecycle          RecordLifecycle        @default(active)
  lifecycleAt        DateTime?
  lifecycleReason    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization    Organization     @relation("TripRuleOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile? @relation("TripRuleDriver", fields: [employeeProfileId], references: [id], onDelete: Cascade)
  trips           Trip[]

  // FK-leading (organizationId): rule evaluation order for an org's captured trip.
  @@index([organizationId, lifecycle, priority])
  // FK-leading (employeeProfileId): a driver's own rules.
  @@index([employeeProfileId, lifecycle])
}

/// Explicit, revocable consent for background location capture. No background
/// fix may be recorded without a granted row; revocation stops capture and is
/// retained so the consent history itself is auditable.
model DriverLocationConsent {
  id                 String                      @id @default(cuid())
  driverLocationConsentId          String                      @unique
  organizationId     String
  employeeProfileId  String
  consentStatus      DriverLocationConsentStatus @default(pending)
  grantedAt          DateTime?
  revokedAt          DateTime?
  retentionDays      Int                         @default(365)
  policyVersion      String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization    Organization    @relation("DriverConsentOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation("DriverConsentDriver", fields: [employeeProfileId], references: [id], onDelete: Cascade)

  // One live consent record per driver per policy version.
  @@unique([employeeProfileId, policyVersion])
  // FK-leading (organizationId): org-wide consent posture review.
  @@index([organizationId, consentStatus])
}
