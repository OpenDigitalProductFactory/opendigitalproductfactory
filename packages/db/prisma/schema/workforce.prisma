// Payroll run — a batch payslip calculation for a pay period. Persists the output
// of lib/hr/labor-service.ts#computeEmployeePayslip so a hire's computed pay becomes
// a durable, auditable, disbursable record (the "paying" hop of the recruiting→
// hiring→paying seam). Regulated financial records — retained per payroll/tax law.
// Actual money movement (bank/ACH) is a separate provider bridge; disbursementStatus
// tracks it. Model shape mirrors the pure Payslip type (lib/hr/payroll.ts).
enum PayRunStatus {
  draft
  approved
  paid
  cancelled
}

enum PayslipDisbursementStatus {
  pending
  paid
  failed
}

model PayRun {
  id          String       @id @default(cuid())
  payRunRef   String       @unique
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime?
  status      PayRunStatus @default(draft)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payslips Payslip[]

  @@index([status])
  @@index([periodStart])
}

model Payslip {
  id                 String                    @id @default(cuid())
  payRunId           String
  employeeProfileId  String
  grossPay           Decimal
  taxablePay         Decimal
  netPay             Decimal
  totalEmployerCost  Decimal
  earnings           Json // PayComponent[] — earning lines
  employeeDeductions Json // PayComponent[] — income tax / NI / post-tax
  employerCosts      Json // PayComponent[] — employer NI etc.
  disbursementStatus PayslipDisbursementStatus @default(pending)
  paidAt             DateTime?
  createdAt          DateTime                  @default(now())

  payRun          PayRun          @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  // One payslip per employee per run — makes a re-run idempotent.
  componentLines PayComponentLine[]

  @@unique([payRunId, employeeProfileId])
  @@index([employeeProfileId])
  @@index([disbursementStatus])
}

