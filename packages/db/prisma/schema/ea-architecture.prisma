model EaNotation {
  id                String               @id @default(cuid())
  slug              String               @unique
  name              String
  version           String
  dqRules           EaDqRule[]
  elementTypes      EaElementType[]
  relTypes          EaRelationshipType[]
  structureRules    EaStructureRule[]
  traversalPatterns EaTraversalPattern[]
  views             EaView[]
}

model EaReferenceModel {
  id              String                     @id @default(cuid())
  slug            String                     @unique
  name            String
  version         String
  authorityType   String
  status          String                     @default("draft")
  description     String?
  primaryIndustry String?
  sourceSummary   String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  assessments     EaReferenceAssessment[]
  artifacts       EaReferenceModelArtifact[]
  elements        EaReferenceModelElement[]
  proposals       EaReferenceProposal[]
}

model EaReferenceModelElement {
  id              String                    @id @default(cuid())
  modelId         String
  parentId        String?
  kind            String
  slug            String
  name            String
  code            String?
  description     String?
  normativeClass  String?
  sourceReference String?
  properties      Json                      @default("{}")
  assessments     EaReferenceAssessment[]
  model           EaReferenceModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parent          EaReferenceModelElement?  @relation("EaReferenceModelTree", fields: [parentId], references: [id])
  children        EaReferenceModelElement[] @relation("EaReferenceModelTree")

  @@unique([modelId, slug])
  @@index([modelId, kind])
  @@index([parentId])
}

model EaReferenceModelArtifact {
  id         String                @id @default(cuid())
  modelId    String
  kind       String
  path       String
  checksum   String?
  authority  String
  importedAt DateTime?
  createdAt  DateTime              @default(now())
  model      EaReferenceModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  proposals  EaReferenceProposal[]

  @@unique([modelId, path])
  @@index([modelId, authority])
}

model EaAssessmentScope {
  id          String                  @id @default(cuid())
  scopeType   String
  scopeRef    String
  name        String
  description String?
  status      String                  @default("active")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  assessments EaReferenceAssessment[]

  @@unique([scopeType, scopeRef])
}

model EaReferenceAssessment {
  id              String                  @id @default(cuid())
  scopeId         String
  modelId         String
  modelElementId  String
  coverageStatus  String
  mvpIncluded     Boolean                 @default(true)
  evidenceSummary String?
  rationale       String?
  confidence      String?
  assessedById    String?
  updatedAt       DateTime                @updatedAt
  createdAt       DateTime                @default(now())
  modelElement    EaReferenceModelElement @relation(fields: [modelElementId], references: [id], onDelete: Cascade)
  model           EaReferenceModel        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  scope           EaAssessmentScope       @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, modelElementId])
  @@index([modelId, coverageStatus])
}

model EaReferenceProposal {
  id               String                    @id @default(cuid())
  modelId          String?
  proposalType     String
  sourceArtifactId String?
  payload          Json
  status           String                    @default("proposed")
  proposedByType   String
  proposedByRef    String?
  reviewNotes      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  model            EaReferenceModel?         @relation(fields: [modelId], references: [id])
  sourceArtifact   EaReferenceModelArtifact? @relation(fields: [sourceArtifactId], references: [id])

  @@index([modelId, status])
  @@index([sourceArtifactId])
}

model EaElementType {
  id                     String               @id @default(cuid())
  notationId             String
  slug                   String
  name                   String
  neoLabel               String
  domain                 String
  description            String?
  validLifecycleStages   String[]
  validLifecycleStatuses String[]
  isExtension            Boolean              @default(false)
  archimateExportSlug    String?
  ontologyCategory       String?
  dqRules                EaDqRule[]
  elements               EaElement[]
  frameworkMappings      EaFrameworkMapping[]
  notation               EaNotation           @relation(fields: [notationId], references: [id])
  fromRules              EaRelationshipRule[] @relation("FromType")
  toRules                EaRelationshipRule[] @relation("ToType")
  childStructureRules    EaStructureRule[]    @relation("EaStructureRuleChild")
  parentStructureRules   EaStructureRule[]    @relation("EaStructureRuleParent")

  @@unique([notationId, slug])
}

model EaRelationshipType {
  id            String               @id @default(cuid())
  notationId    String
  slug          String
  name          String
  neoType       String
  description   String?
  relationships EaRelationship[]
  rules         EaRelationshipRule[]
  notation      EaNotation           @relation(fields: [notationId], references: [id])

  @@unique([notationId, slug])
}

model EaRelationshipRule {
  id                 String             @id @default(cuid())
  fromElementTypeId  String
  toElementTypeId    String
  relationshipTypeId String
  fromElementType    EaElementType      @relation("FromType", fields: [fromElementTypeId], references: [id])
  relationshipType   EaRelationshipType @relation(fields: [relationshipTypeId], references: [id])
  toElementType      EaElementType      @relation("ToType", fields: [toElementTypeId], references: [id])

  @@unique([fromElementTypeId, toElementTypeId, relationshipTypeId])
}

model EaDqRule {
  id             String         @id @default(cuid())
  notationId     String
  elementTypeId  String?
  name           String
  description    String?
  lifecycleStage String
  severity       String         @default("error")
  rule           Json
  elementType    EaElementType? @relation(fields: [elementTypeId], references: [id])
  notation       EaNotation     @relation(fields: [notationId], references: [id])
}

model EaElement {
  id                            String                         @id @default(cuid())
  elementTypeId                 String
  name                          String
  description                   String?
  properties                    Json                           @default("{}")
  lifecycleStage                String                         @default("plan")
  lifecycleStatus               String                         @default("draft")
  createdById                   String?
  digitalProductId              String?
  infraCiKey                    String?
  portfolioId                   String?
  taxonomyNodeId                String?
  syncedAt                      DateTime?
  refinementLevel               String                         @default("logical")
  itValueStream                 String?
  ontologyRole                  String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  conformanceIssues             EaConformanceIssue[]
  digitalProduct                DigitalProduct?                @relation(fields: [digitalProductId], references: [id])
  elementType                   EaElementType                  @relation(fields: [elementTypeId], references: [id])
  portfolio                     Portfolio?                     @relation(fields: [portfolioId], references: [id])
  taxonomyNode                  TaxonomyNode?                  @relation(fields: [taxonomyNodeId], references: [id])
  fromRelationships             EaRelationship[]               @relation("FromElement")
  toRelationships               EaRelationship[]               @relation("ToElement")
  viewElements                  EaViewElement[]
  businessCapabilityLinks       BusinessCapabilityTraceLink[]  @relation("BusinessCapabilityEaElementLinks")
  capabilityMaturityAssessments CapabilityMaturityAssessment[]
  // Plateau membership: when this element is a Plateau (slug=plateau), the governed
  // things that belong to that architecture state. Spec 2026-06-07 §5, §8.5.
  plateauMemberships            PlateauMembership[]            @relation("PlateauMembershipPlateau")

  @@index([portfolioId])
  @@index([taxonomyNodeId])
  @@index([digitalProductId])
  @@index([elementTypeId])
  // Unified lifecycle backbone: realization-stage axis is queried by the baseline
  // projector and current/future views. Spec 2026-06-07 §8.3.
  @@index([refinementLevel])
}

// ─── Unified Lifecycle Backbone (EP-LIFECYCLE) ──────────────────────────────────────
// Spec: docs/superpowers/specs/2026-06-07-unified-lifecycle-backbone-design.md §8.4-8.5.
// Canonical axes + governed-thing allowlist live in apps/web/lib/lifecycle.ts and
// apps/web/lib/governed-thing-ref.ts (single source of truth for the string enums).

// Universal append-only lifecycle transition log. Generalises DocumentLifecycleEvent to
// every governed thing. Identity-bearing actors resolve through Principal (AGENTS.md §11),
// not a new actor table.
model LifecycleEvent {
  id                String         @id @default(cuid())
  governedThingKind String // GovernedThingKind (apps/web/lib/governed-thing-ref.ts)
  governedThingId   String
  fromStage         String? // LifecycleStage | null
  toStage           String? // LifecycleStage | null
  fromStatus        String? // LifecycleStatus | null (closed canonical enum)
  toStatus          String? // LifecycleStatus | null (closed canonical enum)
  fromState         String? // open per-grammar StageState.key, NOT a canonical enum (lifecycle-grammar.ts)
  toState           String? // open per-grammar StageState.key, NOT a canonical enum (lifecycle-grammar.ts)
  reason            String?        @db.Text
  evidenceRef       String? // pointer to corroborating evidence (discovery run, probe, etc.)
  actorPrincipalId  String?
  toolExecutionId   String?
  createdAt         DateTime       @default(now())
  actorPrincipal    Principal?     @relation("LifecycleEventActor", fields: [actorPrincipalId], references: [id])
  toolExecution     ToolExecution? @relation(fields: [toolExecutionId], references: [id])

  @@index([governedThingKind, governedThingId, createdAt])
  @@index([actorPrincipalId])
  @@index([toolExecutionId])
}

// Membership of a governed thing in a Plateau (a relatively stable architecture state —
// ArchiMate Plateau element type, already seeded). The baseline (current-state) plateau is
// populated by the projector with membershipSource="projected"; target plateaus are curated.
model PlateauMembership {
  id                String    @id @default(cuid())
  plateauElementId  String // EaElement with elementType.slug = "plateau"
  governedThingKind String
  governedThingId   String
  membershipSource  String    @default("projected") // projected | curated | imported
  validFrom         DateTime  @default(now())
  validTo           DateTime?
  stateSnapshot     Json      @default("{}") // CanonicalLifecycle snapshot at membership time
  evidenceRef       String? // required for projected baseline members (enforced in app layer)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  plateauElement    EaElement @relation("PlateauMembershipPlateau", fields: [plateauElementId], references: [id], onDelete: Cascade)

  // The migration enforces one ACTIVE interval with a partial unique index
  // (validTo IS NULL). Historical intervals remain immutable and repeatable.
  @@index([plateauElementId, governedThingKind, governedThingId])
  @@index([governedThingKind, governedThingId])
  @@index([membershipSource])
  @@index([plateauElementId])
}

// A typed delta between the baseline and a target plateau, or a cross-cutting concern
// (EOL, vulnerability, data-quality, break-fix) raised against the current-state baseline.
// Spec 2026-06-07 §6-7, §8.6. The gap NEVER owns work status — backlogItemId is a soft
// pointer; work status is read from BacklogItem/Epic/FeatureBuild. Plateau/work-package/
// ea-gap/backlog references are plain id columns (no FK, like EaElement.infraCiKey) to keep
// EaElement and BacklogItem free of four back-relations; the app layer validates them.
model LifecycleGap {
  id                   String    @id @default(cuid())
  gapKey               String    @unique // stable dedup key (dimension+thing+signal identity)
  kind                 String // add | change | remove
  dimension            String // capability | technology-currency | vulnerability | data-quality | operational | cost | regulatory
  severity             String    @default("medium") // info | low | medium | high | critical
  status               String    @default("open") // open | scoped | resolved | dismissed
  scopeLevel           String    @default("portfolio") // portfolio | product
  governedThingKind    String
  governedThingId      String
  title                String
  detail               String?   @db.Text
  baselinePlateauId    String? // EaElement.id (Plateau) — soft pointer
  targetPlateauId      String? // EaElement.id (Plateau) — soft pointer
  workPackageElementId String? // EaElement.id (Work Package) — soft pointer
  eaGapElementId       String? // EaElement.id (ArchiMate Gap) — soft pointer
  backlogItemId        String? // BacklogItem.itemId — semantic soft pointer; gap never owns work status
  digitalProductId     String? // product-level scope target
  evidenceRef          String?
  detectedAt           DateTime  @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([dimension])
  @@index([scopeLevel])
  @@index([governedThingKind, governedThingId])
  @@index([backlogItemId])
  @@index([digitalProductId])
}

model CapabilityMaturityAssessment {
  id                            String                         @id @default(cuid())
  assessmentId                  String                         @unique
  name                          String
  capabilityCategory            String
  riskTier                      String
  maturityScore                 Int
  confidenceGrade               String                         @default("claimed")
  strategicOwnership            String
  vendorReplacementConfidence   String                         @default("low")
  installScope                  String                         @default("canonical")
  archetypeScope                String?
  productizationStatus          String                         @default("not_eligible")
  productizationStatusChangedAt DateTime?
  parityChecklistEvidence       Json                           @default("[]")
  existingPrimitives            Json                           @default("[]")
  maturityGaps                  Json                           @default("[]")
  evidenceSources               Json                           @default("[]")
  hiveMindSignals               Json                           @default("[]")
  kernelPrinciples              String[]                       @default([])
  operationalSurface            String?
  hasContinuousEvidence         Boolean                        @default(false)
  evidenceFreshnessAt           DateTime?
  lastGovernanceReviewAt        DateTime?
  lastAssessmentAt              DateTime                       @default(now())
  assessedBy                    String                         @default("seed")
  portfolioId                   String
  taxonomyNodeId                String?
  eaElementId                   String?
  digitalProductId              String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  portfolio                     Portfolio                      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  taxonomyNode                  TaxonomyNode?                  @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  eaElement                     EaElement?                     @relation(fields: [eaElementId], references: [id], onDelete: SetNull)
  digitalProduct                DigitalProduct?                @relation(fields: [digitalProductId], references: [id], onDelete: SetNull)
  dependencies                  CapabilityMaturityDependency[] @relation("CapabilityMaturityDependencyFrom")
  dependents                    CapabilityMaturityDependency[] @relation("CapabilityMaturityDependencyTo")

  @@index([portfolioId])
  @@index([taxonomyNodeId])
  @@index([eaElementId])
  @@index([digitalProductId])
  @@index([capabilityCategory])
  @@index([riskTier])
  @@index([installScope])
  @@index([productizationStatus])
}

model CapabilityMaturityDependency {
  id           String                       @id @default(cuid())
  assessmentId String
  dependencyId String
  createdAt    DateTime                     @default(now())
  assessment   CapabilityMaturityAssessment @relation("CapabilityMaturityDependencyFrom", fields: [assessmentId], references: [id], onDelete: Cascade)
  dependency   CapabilityMaturityAssessment @relation("CapabilityMaturityDependencyTo", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, dependencyId])
  @@index([dependencyId])
}

model BusinessCapability {
  id                String                        @id @default(cuid())
  capabilityId      String                        @unique
  name              String
  slug              String
  description       String?
  level             Int
  sortOrder         Int                           @default(0)
  status            String                        @default("active")
  parentId          String?
  currentMaturity   Int                           @default(1)
  targetMaturity    Int                           @default(3)
  maturityRationale String?
  it4itValueStreams String[]                      @default([])
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  parent            BusinessCapability?           @relation("BusinessCapabilityTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          BusinessCapability[]          @relation("BusinessCapabilityTree")
  traceLinks        BusinessCapabilityTraceLink[]

  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
  @@index([level, status])
}

model BusinessCapabilityTraceLink {
  id               String             @id @default(cuid())
  capabilityId     String
  targetType       String
  targetId         String
  relationship     String             @default("supports")
  note             String?
  taxonomyNodeId   String?
  digitalProductId String?
  backlogItemId    String?
  eaElementId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  capability       BusinessCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  taxonomyNode     TaxonomyNode?      @relation("BusinessCapabilityTaxonomyLinks", fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  digitalProduct   DigitalProduct?    @relation("BusinessCapabilityProductLinks", fields: [digitalProductId], references: [id], onDelete: Cascade)
  backlogItem      BacklogItem?       @relation("BusinessCapabilityBacklogLinks", fields: [backlogItemId], references: [id], onDelete: Cascade)
  eaElement        EaElement?         @relation("BusinessCapabilityEaElementLinks", fields: [eaElementId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, targetType, targetId, relationship])
  @@index([capabilityId])
  @@index([targetType, targetId])
  @@index([taxonomyNodeId])
  @@index([digitalProductId])
  @@index([backlogItemId])
  @@index([eaElementId])
}

model EaRelationship {
  id                 String             @id @default(cuid())
  fromElementId      String
  toElementId        String
  relationshipTypeId String
  notationSlug       String
  properties         Json               @default("{}")
  createdById        String?
  syncedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  fromElement        EaElement          @relation("FromElement", fields: [fromElementId], references: [id])
  relationshipType   EaRelationshipType @relation(fields: [relationshipTypeId], references: [id])
  toElement          EaElement          @relation("ToElement", fields: [toElementId], references: [id])

  // One relationship per (from, to, type) — lets projection/import extractors upsert
  // idempotently instead of accumulating duplicate edges (BI-8C121D30).
  @@unique([fromElementId, toElementId, relationshipTypeId], map: "EaRelationship_triple_key")
  @@index([fromElementId])
  @@index([toElementId])
  @@index([relationshipTypeId])
}

model EaView {
  id                String               @id @default(cuid())
  notationId        String
  name              String
  description       String?
  layoutType        String
  scopeType         String
  scopeRef          String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  canvasState       Json?
  status            String               @default("draft")
  submittedAt       DateTime?
  submittedById     String?
  viewpointId       String?
  conformanceIssues EaConformanceIssue[]
  snapshots         EaSnapshot[]
  notation          EaNotation           @relation(fields: [notationId], references: [id])
  viewpoint         ViewpointDefinition? @relation(fields: [viewpointId], references: [id])
  viewElements      EaViewElement[]
}

model EaViewElement {
  viewId              String
  elementId           String
  id                  String          @id @default(cuid())
  mode                String          @default("new")
  proposedProperties  Json?
  orderIndex          Int?
  parentViewElementId String?
  element             EaElement       @relation(fields: [elementId], references: [id])
  parentViewElement   EaViewElement?  @relation("EaViewElementParent", fields: [parentViewElementId], references: [id])
  childViewElements   EaViewElement[] @relation("EaViewElementParent")
  view                EaView          @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([viewId, elementId])
  @@index([elementId])
  @@index([viewId, parentViewElementId, orderIndex])
  @@index([parentViewElementId]) // FK-leading (tree parent): view-element tree traversal, apps/web/lib/actions/ea.ts:651
}

model EaStructureRule {
  id                      String        @id @default(cuid())
  notationId              String
  parentElementTypeId     String
  childElementTypeId      String
  patternSlug             String
  minChildren             Int?
  maxChildren             Int?
  orderedChildren         Boolean       @default(false)
  impliedRelationshipSlug String?
  defaultSeverity         String        @default("warn")
  rendererHint            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  childElementType        EaElementType @relation("EaStructureRuleChild", fields: [childElementTypeId], references: [id])
  notation                EaNotation    @relation(fields: [notationId], references: [id])
  parentElementType       EaElementType @relation("EaStructureRuleParent", fields: [parentElementTypeId], references: [id])

  @@unique([notationId, parentElementTypeId, childElementTypeId, patternSlug])
  @@index([notationId, patternSlug])
}

model EaConformanceIssue {
  id          String     @id @default(cuid())
  viewId      String?
  elementId   String?
  issueType   String
  severity    String     @default("warn")
  message     String
  status      String     @default("open")
  detailsJson Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  element     EaElement? @relation(fields: [elementId], references: [id], onDelete: Cascade)
  view        EaView?    @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([viewId, status])
  @@index([elementId, status])
  @@index([issueType, severity])
}

model ViewpointDefinition {
  id                      String   @id @default(cuid())
  name                    String   @unique
  description             String?
  allowedElementTypeSlugs String[]
  allowedRelTypeSlugs     String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  views                   EaView[]
}

model EaSnapshot {
  id                String    @id @default(cuid())
  viewId            String
  approvedById      String?
  submittedById     String?
  approvedAt        DateTime?
  changeSummary     String?
  elementCount      Int
  relationshipCount Int
  graphJson         Json
  view              EaView    @relation(fields: [viewId], references: [id])
}

model EaTraversalPattern {
  id                 String     @id @default(cuid())
  notationId         String
  slug               String
  name               String
  description        String?
  patternType        String
  steps              Json
  forbiddenShortcuts Json       @default("[]")
  status             String     @default("active")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  notation           EaNotation @relation(fields: [notationId], references: [id])

  @@unique([notationId, slug])
  @@index([notationId, patternType])
}

model EaFrameworkMapping {
  id                   String        @id @default(cuid())
  elementTypeId        String
  frameworkSlug        String
  nativeConceptName    String
  mappingType          String
  semanticDisparity    String?
  influenceOpportunity String?
  exchangeOpportunity  Boolean       @default(false)
  notes                String?
  createdAt            DateTime      @default(now())
  elementType          EaElementType @relation(fields: [elementTypeId], references: [id])

  @@unique([elementTypeId, frameworkSlug])
  @@index([frameworkSlug])
  @@index([elementTypeId])
}
