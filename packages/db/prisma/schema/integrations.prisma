model DeviceCodeSession {
  id         String   @id @default(cuid())
  deviceCode String   @unique
  userCode   String
  interval   Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  createdBy  String
  consumed   Boolean  @default(false)

  @@index([expiresAt])
}

