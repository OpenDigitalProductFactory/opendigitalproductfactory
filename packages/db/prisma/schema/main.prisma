generator client {
  provider            = "prisma-client"
  output              = "../../generated/client"
  importFileExtension = "ts"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // BET-5 (BI-A1E864A5): vectors move Qdrant -> pgvector, graph hierarchy uses ltree.
  extensions = [vector, ltree]
}
