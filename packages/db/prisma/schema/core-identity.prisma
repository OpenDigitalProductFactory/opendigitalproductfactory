// EP-PARTNER-CHANNEL Phase 1b. Generic per-organization opt-in overlay on top of
// the axis-derived capability applicability from @dpf/storefront-templates. The
// derivation answers "is this capability applicable to the business model?"; this
// row records "did this org turn it on?" — captured at setup (decidedVia="setup-wizard")
// for capabilities that resolveCapabilityActivation() flags promptAtSetup, and
// editable later from admin (decidedVia="admin"). Not partner-specific; partner-program
// is the first consumer. Spec 2026-06-04-partner-reseller-archetype-identity §6.3.
model OrganizationCapabilityActivation {
  id             String       @id @default(cuid())
  organizationId String
  // Matches a @dpf/storefront-templates CapabilityKey (validated in app code via
  // isCapabilityKey before write). Stored as String to avoid a DB enum that would
  // need a migration every time the capability registry grows.
  capabilityKey  String
  // CapabilityActivationChoice: "enabled" | "disabled".
  choice         String
  // Provenance of the decision: "setup-wizard" | "admin".
  decidedVia     String
  decidedAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capabilityKey])
  @@index([organizationId])
}

model BusinessContext {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  // What the company does (richer than tagline)
  description      String?
  valueProposition String?
  // Why the company exists — captured at onboarding (business-context step).
  // Seeds the company-mission prompt (Block 0) and the org WWWD corpus.
  mission          String?

  // Who they serve
  targetMarket     String?
  customerSegments String[]

  // Business model
  revenueModel    String?
  companyStage    String?
  companySize     String?
  geographicScope String?
  sourceSystem    String?
  // US state/province code driving statutory defaults (records-request response
  // deadlines, retention schedules) for public-sector archetypes. Org-level
  // configuration on seeded obligations — not 50 seed variants (civic spec $10).
  stateCode       String?

  // ─── Compliance & regulatory scope (captured at setup) ───────────────────
  // Region is multi-dimensional: a business OPERATES in some jurisdictions,
  // SELLS to others, and EMPLOYS in others — and different obligations key off
  // different dimensions (sales tax & marketing consent off where customers are;
  // employment law off where staff work; data sovereignty off where data
  // subjects are). Each set holds PROFESSION_JURISDICTIONS slugs (us | eu | uk).
  // Read by resolveInstallVariantContext to drive per-coworker corpus selection
  // via the jurisdiction-basis model. Empty = undeclared → that dimension is not
  // filtered (no regression).
  operatesIn                String[]  @default([])
  sellsTo                   String[]  @default([])
  employsIn                 String[]  @default([])
  dataResidency             String[]  @default([])
  // Whether the business handles card payments (PCI-DSS, a global-basis obligation).
  handlesCardPayments       Boolean   @default(false)
  // What the org DOES with data / how it operates — the triggers that put it in
  // scope of HORIZONTAL regulations (privacy, breach, AI governance, marketing,
  // accessibility). Values are the DATA_HANDLING_PREDICATES enum in
  // regulation-applicability.ts (processes-personal-data | serves-consumers |
  // deploys-automated-decisioning | sends-marketing | publicly-accessible-service
  // | handles-health-data | handles-financial-data | handles-education-data |
  // government-customers | handles-card-data). Empty = undeclared → a
  // data-handling-gated regulation surfaces as "review", never silently applied.
  // handlesCardPayments=true is bridged to the handles-card-data predicate at
  // resolve time, so the two stay consistent.
  dataHandling              String[]  @default([])
  // Corporate-law legal form / market-listing status, orthogonal to industry
  // archetype: any archetype can be a listed or private company. Gates
  // listing-specific governance regimes (e.g. UK Corporate Governance Code
  // Provision 29, which applies to UK premium-listed companies). Values are the
  // LISTING_STATUSES enum in regulation-applicability.ts (premium-listed |
  // standard-listed | aim-listed | private | other). Null = undeclared → a
  // listing-gated regulation is surfaced as "review", never silently applied.
  listingStatus             String?
  // When the operator last confirmed the compliance scope at setup.
  complianceScopeCapturedAt DateTime?

  // Derived from archetype (auto-populated)
  industry String?
  ctaType  String?

  // Per-org Digital Product Portfolio decomposition (BI-2D452667, spec
  // docs/superpowers/specs/2026-06-07-business-operating-model-portfolio-wiring-design.md §3/§8 Phase 0).
  // Shape: PortfolioDecomposition (Record<PortfolioRole, PortfolioProfile>) from
  // @dpf/storefront-templates — roles foundational | manufactureAndDeliver |
  // forEmployees | productsAndServicesSold, each with a scope. Seeded ONCE from
  // the archetype's activationProfile at setup completion (seed-is-bootstrap),
  // then refinable by the operator. Read via resolvePortfolioDecomposition(),
  // which prefers this persisted value and falls back to the archetype-derived
  // computation when null.
  portfolioDecomposition Json?

  // ─── Risk posture (EP-ONBOARDING-INTAKE P0) ─────────────────────────────────
  // Org-wide autonomy/risk appetite — the structured companion to the prose
  // howWeDecide WWWD stance. Industry sets a conservative DEFAULT
  // (deriveRiskPostureDefault, mirroring INDUSTRY_RETENTION_FLOORS); the operator
  // may override. Sets the autonomy ENVELOPE (ceiling + maturation rate), not the
  // live autonomy level: the autopilot trust dial still starts HITL-first and
  // earns autonomy on evidence. Values: conservative | balanced | progressive.
  // Read via resolveRiskEnvelope() (apps/web/lib/govern/risk-posture.ts).
  // Consumers wired in P1; this column is the inert home seeded at setup.
  riskPosture           String?
  // Provenance: "industry-default" (machine-derived) or "operator" (chosen).
  riskPostureSource     String?
  // When the operator last confirmed/changed the posture.
  riskPostureCapturedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Personal access token for the external MCP transport at /api/mcp/v1.
// User-owned (the human issues it from /admin/platform-development), hashed
// at rest, scoped to a subset of the user's grants, optionally bound to a
// specific Agent identity for grant-narrowing.
model McpApiToken {
  id            String    @id @default(cuid())
  userId        String
  agentId       String?
  // Lifecycle classification. "operator" (default) = manually issued by an
  // operator, lives until manually revoked. "ephemeral_ship" = auto-issued
  // by transitionBuildPhase on review→ship entry, auto-revoked on ship
  // exit (complete / failed / phase rollback). Other kinds may be added
  // later (e.g. "ephemeral_promotion") — keep as a string so we don't
  // need an enum migration each time.
  kind          String    @default("operator")
  // When kind = "ephemeral_ship", this points at the FeatureBuild whose
  // ship phase owns this token's lifecycle. Null for operator-issued
  // tokens. Not modelled as a Prisma relation: FeatureBuild lives in the
  // same DB but the FK semantics here are loose-coupled (we don't want a
  // build delete to cascade-delete the audit trail).
  buildId       String?
  name          String
  tokenHash     String    @unique
  prefix        String
  tokenSuffix   String?
  secretEnc     String?   @db.Text
  scopes        String[]  @default([])
  capability    String    @default("read")
  scope         String    @default("read")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  // OAuth 2.1 issuance (EP-24741BBF / BI-E4DFDCB0). An OAuth access token and
  // a dpfmcp_ PAT are the SAME governed object with different issuance paths —
  // one resolution path, one revocation surface, one admin list, one audit
  // shape. That is the point: two credential systems means the second one is
  // the one nobody keeps current.
  //
  // Null on a PAT row. Set together on an oauth_access row:
  //   oauthClientId — the registered client the token was issued to
  //   resource      — RFC 8707 audience; the canonical MCP URI this token is
  //                   valid AT. Validated on every call, which is what stops a
  //                   token minted for one install being replayed at another.
  //   publicScopes  — the consented public scope strings (dpf.read, …). The
  //                   granular `scopes` column still carries the expanded
  //                   internal grants, so the authorization gate is unchanged.
  oauthClientId String?
  resource      String?
  publicScopes  String[]  @default([])

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([tokenHash])
  // Lookup: "all active ephemeral tokens for build X" — used by the
  // ship-exit hook to find rows to revoke.
  @@index([buildId, revokedAt])
  // Lookup: "revoke everything issued to this client" — the per-client revoke
  // control in Admin > Platform Development.
  @@index([oauthClientId, revokedAt])
}

/// Registration mechanism for an OAuth client, matching the three the MCP
/// authorization spec defines (`authorization.mdx:196-209`) plus the headless
/// grant. A closed set, so it is an enum rather than a String: the values are
/// branched on in the token endpoint and shown on the consent screen.
enum OAuthClientRegistrationKind {
  /// RFC 7591 self-registration. Grants nothing on its own — a human still
  /// consents — but the client CHOSE its own name, so the consent screen
  /// marks it self-asserted.
  dcr
  /// Client ID Metadata Document (SEP-991): the client id is an https URL the
  /// AS fetched and validated. Unusable on an air-gapped install, which is
  /// why dcr exists here.
  cimd
  /// Operator-entered in Admin > Platform Development.
  preregistered
  /// A headless client using the client_credentials grant. This is what
  /// replaces the PAT for CI/cron/containers — a grant type, not a second
  /// credential system.
  credentials
}

/// An OAuth client registered against this install's authorization server.
model OAuthClient {
  id               String                      @id @default(cuid())
  /// The OAuth `client_id` value this client presents. Named for the model
  /// rather than for the protocol field so it reads as this row's public
  /// identity (the wire still calls it `client_id`); a DCR client gets a
  /// generated `dpfoc_...`, a CIMD client's is the https URL of its metadata
  /// document.
  oAuthClientId    String                      @unique
  clientName       String
  registrationKind OAuthClientRegistrationKind
  /// Confidential clients only (credentials / client_secret_*). Public
  /// browser clients authenticate with PKCE and hold no secret.
  clientSecretHash String?
  clientSecretEnc  String?                     @db.Text
  redirectUris     String[]                    @default([])
  /// For a "credentials" client: the human whose authority it acts under, and
  /// optionally the coworker identity it acts as. A client can never exceed
  /// this human's platformRole — consent narrows, never widens.
  ownerUserId      String?
  agentId          String?
  /// Public scopes this client may receive. For interactive clients this caps
  /// what consent may grant; for a credentials client it IS the grant, since
  /// there is no browser in which to consent.
  allowedScopes    String[]                    @default([])
  /// Verbatim RFC 7591 registration request / fetched CIMD document, kept for
  /// audit. Never contains a secret: the secret is hashed above.
  metadataJson     Json?
  createdAt        DateTime                    @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokedReason    String?

  owner              User?                    @relation("OAuthClientOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  agent              Agent?                   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tokens             McpApiToken[]
  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]

  @@index([ownerUserId, revokedAt])
  @@index([registrationKind, revokedAt])
  @@index([agentId])
}

/// A single-use authorization code. Short-lived, consumed on first exchange;
/// a second presentation is a replay and is refused. The PKCE challenge is
/// stored, never the verifier.
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  oauthClientId       String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  /// RFC 8707 audience the eventual access token will be bound to.
  resource            String
  scopes              String[]  @default([])
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oauthClientId])
  @@index([userId])
  @@index([expiresAt])
}

/// A refresh token. ROTATES on every use: exchanging one marks it consumed and
/// issues a successor. A replayed refresh token is therefore detectable — its
/// successor already exists — and the whole chain is revoked, per OAuth 2.1
/// refresh-token-rotation guidance.
model OAuthRefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  oauthClientId String
  userId        String
  agentId       String?
  resource      String
  scopes        String[]  @default([])
  /// Set when this token has been exchanged; points at its successor. A
  /// presentation of a token that already has one is a replay.
  rotatedToId   String?
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  client      OAuthClient         @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  rotatedTo   OAuthRefreshToken?  @relation("OAuthRefreshRotation", fields: [rotatedToId], references: [id], onDelete: SetNull)
  rotatedFrom OAuthRefreshToken[] @relation("OAuthRefreshRotation")

  @@index([oauthClientId, revokedAt])
  @@index([userId, revokedAt])
  @@index([agentId])
  @@index([rotatedToId])
}

model ApiToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  name      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId]) // FK-leading (spine): token revocation by user, apps/web/app/api/v1/auth/logout/route.ts:33
}

model OrgSettings {
  id                 String    @id @default(cuid())
  // The single-org locale/currency spine (EP-ORG-LOCALE-CURRENCY). baseCurrency
  // + locale are the operator-facing money-format source; countryCode is the ISO
  // alpha-2 the two are derived from at onboarding (see lib/org-locale). Default
  // is the neutral USD/en-US, NOT a hardcoded foreign GBP/Europe-London.
  baseCurrency       String    @default("USD")
  locale             String    @default("en-US")
  countryCode        String?
  autoFetchRates     Boolean   @default(true)
  lastRateFetchAt    DateTime?
  // Archetype finance profile actually applied during setup. Lets surfaces
  // render the org's real profile instead of a hardcoded default.
  appliedProfileSlug String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
