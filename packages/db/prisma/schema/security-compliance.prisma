  updatedAt            DateTime              @updatedAt
  regulation           Regulation?           @relation(fields: [regulationId], references: [id])
  reviewedBy           EmployeeProfile?      @relation("AlertReviewer", fields: [reviewedByEmployeeId], references: [id])
