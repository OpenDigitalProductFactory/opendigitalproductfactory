  totalControls       Int
  implementedControls Int
  openIncidents       Int
  overdueActions      Int
  publishedPolicies   Int
  pendingAlerts       Int
  overallScore        Float
  regulationBreakdown Json
  agentId             String?
  createdAt           DateTime @default(now())

  @@index([takenAt])
