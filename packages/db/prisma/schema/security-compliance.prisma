  startedAt             DateTime          @default(now())
  completedAt           DateTime?
  errorMessage          String?
  createdAt             DateTime          @default(now())
  alerts                RegulatoryAlert[]
  triggeredByEmployee   EmployeeProfile?  @relation("ScanTriggerer", fields: [triggeredByEmployeeId], references: [id])

