  policy     Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([policyId, obligationId])
  @@index([policyId])
  @@index([obligationId])
