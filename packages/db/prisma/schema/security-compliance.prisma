/// Durable intent and reconciliation journal for consequential data mutations
/// that cross Postgres and one or more external or derived stores.
model DataControlOperation {
  id                       String                     @id @default(cuid())
  operationId              String                     @unique @default(cuid())
  organizationId           String
  actorType                String
  actorRef                 String
  actorAuthority           Json
  actionKey                String
  purposeOfUse             String
  inputHash                String
  envelopeHash             String
  assetRefs                String[]                   @default([])
  fieldRefs                String[]                   @default([])
  classificationRefs       String[]                   @default([])
  policyVersions           Json
  holdRevisions            Json
  approvals                Json                       @default("[]")
  risk                     Json                       @default("{}")
  idempotencyKey           String
  status                   String                     @default("planned")
  authorizationDecisionId  String?
  authorizationBindingHash String?
  authorizationConsumedAt  DateTime?
  governedCaseWorkItemId   String?
  terminalEvidence         Json?
  authorizedAt             DateTime?
  startedAt                DateTime?
  reconciledAt             DateTime?
  failedAt                 DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  organization             Organization               @relation(fields: [organizationId], references: [id])
  authorizationDecision    AuthorizationDecisionLog?  @relation(fields: [authorizationDecisionId], references: [decisionId], onDelete: SetNull)
  governedCaseWorkItem     WorkItem?                  @relation("DataControlOperationGovernedCase", fields: [governedCaseWorkItemId], references: [id], onDelete: SetNull)
  steps                    DataControlOperationStep[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, actionKey, createdAt])
  @@index([status, updatedAt])
  @@index([authorizationDecisionId])
  @@index([governedCaseWorkItemId])
}

/// A target-specific durable outbox/checkpoint row. Provider acknowledgement
/// is intentionally separate from verified target truth.
model DataControlOperationStep {
  id                  String               @id @default(cuid())
  stepId              String               @unique @default(cuid())
  operationId         String
  targetKey           String
  targetType          String
  pepKey              String
  sequence            Int
  status              String               @default("pending")
  idempotencyKey      String               @unique
  attempt             Int                  @default(0)
  cursor              Json?
  targetReceipt       Json?
  verificationReceipt Json?
  errorClass          String?
  errorDetail         Json?
  nextRetryAt         DateTime?
  compensable         Boolean              @default(false)
  compensationKey     String?
  compensationReceipt Json?
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  claimedAt           DateTime?
  appliedAt           DateTime?
  verifiedAt          DateTime?
  compensatedAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  operation           DataControlOperation @relation(fields: [operationId], references: [operationId], onDelete: Cascade)

  @@unique([operationId, targetKey])
  @@index([operationId, sequence])
  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
}

// ─── Security telemetry (OCSF-normalized) ───────────────────────────────────
// EP-SOVEREIGN-SOC P0 keystone — append-only OCSF-aligned security telemetry.
// Spec: docs/superpowers/specs/2026-06-24-sovereign-soc-siem-design.md §6.1.
//
// Distinct from EdgeEvent/ChangeEvent — the same call the codebase already made
// splitting ChangeEvent from EdgeEvent: one shared edge envelope (eventType=
// "security"), distinct model because the lifecycle differs. An EdgeEvent is a
// dedup'd fire-and-collapse alert; a SecurityEvent is an immutable normalized
// fact — the triggered/acknowledged/resolved lifecycle lives on Detection /
// SecurityCase (later phases), never here.
//
// Scope is FIRST-CLASS (denormalized), NOT derived through an EdgeNode relation
// like EdgeEvent, because (a) internal sources (AuthorizationDecisionLog,
// ToolExecution) have no edge node, and (b) fleet-scale per-tenant reads must
// not join through EdgeNode. There is intentionally NO foreign key to EdgeNode:
// a security record must outlive node deletion for forensic / audit purposes.
//   - Edge-sourced rows: scope copied from the authenticated EdgeNode row
//     (never the request body — preserves the edge auth-boundary invariant).
//   - Internal rows: scope set at write time from actor / object context.
// rawRef is a pointer / hash to edge-local raw evidence — never the raw blob
// (the sovereignty boundary: raw stays on the edge, detections cross). ocsf-
// Version pins the schema the producer normalized to (version-pinned-ocsf,
// the kernel-decided schema authority, spec §8) so schema evolution is explicit.
model SecurityEvent {
  id              String   @id @default(cuid())
  // Globally-unique, producer-composed idempotency / dedup key. Internal
  // sources namespace it ("dpf.internal:authz:<decisionId>"); edge detectors
  // compose it from source + node + offset/hash so replays collapse.
  eventKey        String   @unique
  // OCSF schema version the producer normalized to (e.g. "1.8.0").
  ocsfVersion     String
  ocsfCategoryUid Int?
  ocsfClassUid    Int
  ocsfActivityId  Int?
  // OCSF severity_id (0..6).
  severityId      Int?
  // OCSF event time (when the activity occurred, set by the detector).
  time            DateTime

  // DPF tenancy scope — denormalized, set at the trust boundary.
  scopeKey          String
  customerAccountId String?
  customerSiteId    String?
  // Soft reference to EdgeNode.id (NO FK — see header). Null for internal sources.
  edgeNodeId        String?
  // Source family — "windows.security", "syslog", "aws.cloudtrail", "dpf.internal".
  sourceKind        String
  sourceName        String

  // Principal reference when the actor is a known platform identity (AGENTS.md §11).
  actorPrincipalId String?
  actor            Json     @default("{}")
  device           Json     @default("{}")
  srcEndpoint      Json     @default("{}")
  dstEndpoint      Json     @default("{}")
  observables      Json     @default("[]")
  // Full normalized OCSF object (the canonical body).
  normalized       Json     @default("{}")
  // Pointer / hash to edge-local raw evidence — NOT the raw blob.
  rawRef           Json     @default("{}")
  // source-reported | low | medium | high | confirmed
  confidence       String   @default("source-reported")
  createdAt        DateTime @default(now())

  @@index([scopeKey, time])
  @@index([customerAccountId, severityId, time])
  @@index([edgeNodeId, time])
  @@index([ocsfClassUid, time])
  // Ingest-time index for the data-retention sweep (security-audit category).
  @@index([createdAt])
}

// ─── Detection content + fired detections + threat intel ────────────────────
// EP-SOVEREIGN-SOC P1. Spec §6.2–6.5. DetectionRule is executable content (NOT
// wiki storage) carrying a kernel-pack baseline + per-tenant overlay via
// scopeKey; the correlation sweep evaluates enabled rules over SecurityEvent
// windows and emits Detection rows; ThreatIndicator is the IOC store matched at
// enrichment + detection. Detections later group into SecurityCase (P2).
model DetectionRule {
  id              String   @id @default(cuid())
  ruleKey         String   @unique
  rulePackKey     String
  rulePackVersion String
  name            String
  description     String?
  // sigma | ocsf-query | dpf-correlation — how `predicate` is interpreted.
  ruleFormat      String
  // Executable predicate (the DetectionPredicate DSL for dpf-correlation).
  predicate       Json
  // ATT&CK technique ids carried by the rule (string[]), for coverage rollups.
  mitreTechniques Json     @default("[]")
  severity        String
  // kernel (shared pack) | customer:<id> | site:<id> overlay.
  scopeKey        String
  enabled         Boolean  @default(true)
  // Per-tenant tuning — thresholds, allow-lists, suppression with expiry.
  tuning          Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scopeKey, enabled])
  @@index([rulePackKey, rulePackVersion])
}

model Detection {
  id                String   @id @default(cuid())
  // Idempotency: a rule firing on the same event-set collapses on this key.
  detectionKey      String   @unique
  ruleId            String
  scopeKey          String
  customerAccountId String?
  customerSiteId    String?
  severity          String
  // open | triaged | linked | suppressed | closed
  status            String   @default("open")
  riskScore         Int?
  // SecurityEvent.eventKey[] that fired this detection.
  matchedEventRefs  Json     @default("[]")
  enrichment        Json     @default("{}")
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  // Set when the detection is grouped into a SecurityCase (P2). Soft ref.
  securityCaseId    String?
  createdAt         DateTime @default(now())

  @@index([scopeKey, status, lastSeenAt])
  @@index([customerAccountId, severity, status])
  @@index([ruleId, lastSeenAt])
  // Ingest-time index for the data-retention sweep (security-audit category).
  @@index([createdAt])
}

model ThreatIndicator {
  id            String    @id @default(cuid())
  indicatorKey  String    @unique
  // ip | domain | url | hash | email | user | process | registry
  indicatorType String
  value         String
  source        String
  confidence    String
  severity      String?
  validFrom     DateTime?
  validUntil    DateTime?
  tags          Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Value-first index powers the observable-match path (value IN (...)).
  @@index([value])
  @@index([indicatorType, value])
  @@index([source])
  @@index([validUntil])
}

// ─── Security case (the AI-SOC analyst worklist) ────────────────────────────
// EP-SOVEREIGN-SOC P2. Spec §6.4. Operational SOC record: groups Detections and
// owns the investigation timeline, verdict, SLA, and assignment. The federation
// projection unit (P5). It COMPOSES ComplianceIncident for the regulated path
// (complianceIncidentId link) rather than duplicating regulatoryNotifiable /
// notificationDeadline / CorrectiveAction — those stay on ComplianceIncident.
// The verdict is an evidence conclusion (set by investigation), NOT a kernel
// vote; the kernel governs the action decisions layered on top (spec §6, §7.3).
model SecurityCase {
  id                   String    @id @default(cuid())
  caseKey              String    @unique
  scopeKey             String
  customerAccountId    String?
  customerSiteId       String?
  title                String
  severity             String
  // new | triaging | investigating | contained | resolved | closed
  status               String    @default("new")
  // unknown | false-positive | benign-true-positive | malicious | needs-human
  verdict              String    @default("unknown")
  // low | medium | high | confirmed
  confidence           String    @default("low")
  assignedAgentId      String?
  assignedUserId       String?
  // Investigation timeline entries (actor, action, evidence ref, decision).
  timeline             Json      @default("[]")
  evidence             Json      @default("{}")
  // SLA timers (MTTD / MTTR clocks, due-by markers).
  sla                  Json      @default("{}")
  // Soft link to the regulated incident record when the notifiable threshold
  // is crossed (ComplianceIncident owns regulatoryNotifiable / deadlines).
  complianceIncidentId String?
  openedAt             DateTime  @default(now())
  resolvedAt           DateTime?
  closedAt             DateTime?
  // Ingest-time-equivalent index (openedAt) already covers retention scans;
  // SecurityCase is a RETAINED record (never auto-purged) per policies.ts.

  @@index([scopeKey, status, openedAt])
  @@index([customerAccountId, severity, status])
  @@index([complianceIncidentId])
}
