  displayObligations         LicenseDisplayObligation[]
  feeSchedules               LicenseFeeSchedule[]
  readinessIssues            LicenseReadinessIssue[]

  @@index([organizationLicenseProfileId])
  @@index([requirementReferenceId])
  @@index([status, expiresAt])
}

