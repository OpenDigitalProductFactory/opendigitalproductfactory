  /// "/customer/marketing"). Nullable: non-route callers (scheduled jobs,
  /// system tasks) have no route, and rows predating this column have none.
  /// Without it a declared-vs-measured drift can only be attributed to an
  /// agent, not to the route-context entry that actually declared the level.
  routeContext               String?
  selectedEndpointId         String
  taskType                   String
  sensitivity                String
  reason                     String
  fitnessScore               Float?
  candidateTrace             Json
  excludedTrace              Json
  policyRulesApplied         String[] @default([])
  fallbackChain              String[] @default([])
  fallbacksUsed              Json?
  shadowMode                 Boolean  @default(false)
  createdAt                  DateTime @default(now())
  selectedModelId            String?
  suitabilityReceipt         Json?
  inferenceDataScreenReceipt Json?

  @@index([taskType])
  @@index([agentMessageId, createdAt])
  @@index([actorKind, actorId, createdAt])
  @@index([agentId, createdAt])
  @@index([routeContext, createdAt])
  @@index([selectedEndpointId])
  @@index([createdAt])
  @@index([traceId])
  @@index([designRevision, createdAt])
}

