// ─── EP-INF-009d: Async/Long-Running Inference Operations ──────────
model AsyncInferenceOp {
  id                String  @id @default(cuid())
  providerId        String
  modelId           String
  operationId       String? // Provider's operation/interaction ID
  contractFamily    String
  requestContext    Json // Screened, credential-free request params

  // Stored as text so the additive migration remains compatible with the
  // pre-lifecycle Prisma client. The database CHECK constraint and the shared
  // application parser enforce the closed lifecycle vocabulary.
  status String @default("pending")

  // identityVersion=0 preserves legacy rows. Every durable-worker admission is
  // version 1 and must bind exactly one TaskRun or Workroom before enqueue.
  identityVersion   Int     @default(0)
  authorityScopeKey String?
  requestKey        String?
  requestDigest     String?
  bindingDigest     String?
  taskRunId         String?
  workroomId        String?

  checkpointSequence Int @default(0)
  transitionSequence Int @default(0)
  startClaimFence    Int @default(0)
  startAttemptedAt   DateTime?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  cancelRequestedAt  DateTime?
  nextPollAt         DateTime?

  resultText   String? @db.Text // Final text result
  resultData   Json? // Full structured result
  errorMessage String? @db.Text

  progressPct     Int? // 0-100
  progressMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime // Hard deadline

  threadId      String? // Event bus key for SSE progress
  callerContext Json? // Opaque caller context

  taskRun       TaskRun? @relation("TaskRunAsyncInferenceOperations", fields: [taskRunId], references: [id], onDelete: Restrict)
  workroom      Workroom? @relation("WorkroomAsyncInferenceOperations", fields: [workroomId], references: [id], onDelete: Restrict)
  transitions   AsyncInferenceOperationTransition[]

  @@index([status])
  @@index([providerId, status])
  @@index([threadId])
  @@index([taskRunId, status])
  @@index([workroomId, status])
  @@index([status, nextPollAt])
  @@index([leaseExpiresAt])
  @@index([authorityScopeKey, createdAt, id])
  @@unique([authorityScopeKey, requestKey])
}

model AsyncInferenceOperationTransition {
  id               String   @id @default(cuid())
  operationId      String
  sequence         Int
  status           String
  checkpoint       Json     @default("{}")
  occurredAt       DateTime @default(now())
  deliveryAttempts Int      @default(0)
  deliveredAt      DateTime?
  operation        AsyncInferenceOp @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, sequence])
  @@index([operationId, occurredAt])
  @@index([deliveredAt, occurredAt])
}

