{
  "schemaVersion": 1,
  "cleanupPolicy": {
    "schemaVersion": 1,
    "mode": "disable-not-delete",
    "plainLanguage": "Keep DPF process skills current by rerunning bootstrap/updater after skill-pack changes. Safe adapters disable known competitive plugins; they never delete user-owned skill files or plugin caches.",
    "clients": [
      {
        "client": "codex",
        "status": "reconciles-safe-config",
        "competitivePluginIds": [
          "superpowers",
          "superpowers@openai-curated",
          "superpowers@openai-bundled"
        ],
        "action": "disable-plugin"
      },
      {
        "client": "claude",
        "status": "reconciles-safe-config",
        "competitivePluginIds": [
          "superpowers",
          "superpowers@openai-curated",
          "superpowers@openai-bundled"
        ],
        "action": "disable-plugin"
      },
      {
        "client": "grok",
        "status": "reconciles-safe-config",
        "competitivePluginIds": [
          "superpowers",
          "superpowers@openai-curated",
          "superpowers@openai-bundled"
        ],
        "action": "disable-plugin"
      },
      {
        "client": "antigravity",
        "status": "unsupported-until-proven",
        "competitivePluginIds": [
          "superpowers",
          "superpowers@openai-curated",
          "superpowers@openai-bundled"
        ],
        "action": "warn-no-disable-cli",
        "notes": "agy has no non-interactive plugin disable; skills are file-synced only. Hook plane still unproven (BI-47A81FEB)."
      }
    ]
  },
  "replacements": [
