{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendpf.org/schemas/promoter-contract-v1.json",
  "title": "DPF promoter contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entrypoint", "requiredFiles", "requiredMounts", "requiredEnvironment", "callerProtocol"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entrypoint": { "const": "/promoter/promote.sh" },
    "requiredFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
    "requiredMounts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "mode"],
        "properties": { "path": { "type": "string", "pattern": "^/" }, "mode": { "enum": ["ro", "rw"] } }
      }
    },
    "requiredEnvironment": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
    "callerProtocol": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
    }
  }
}
