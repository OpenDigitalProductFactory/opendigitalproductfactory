node-linker=hoisted
# Copy files out of the pnpm store instead of hardlinking (BI-EC88BAC1).
# With hundreds of concurrent worktrees sharing one same-volume store, hardlinks
# mean any in-place mutation of a node_modules file corrupts the store and every
# sibling worktree. Do NOT remove: reverting silently re-enables that corruption
# class. Costs some install time in ephemeral environments (CI, Docker) where
# the risk doesn't exist — accepted trade-off, see BI-EC88BAC1.
package-import-method=copy
