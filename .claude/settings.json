{
  "permissions": {
    "allow": [
      "Bash(xargs grep:*)",
      "Bash(git fetch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose logs:*)",
      "Bash(curl -s http://localhost:3000/api/health)",
      "WebFetch(domain:skillsllm.com)",
      "WebFetch(domain:skillsmp.com)",
      "mcp__dpf__propose_improvement"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "dpf"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/lease-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/ux-fit-precheck.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/spec-plan-doc-precheck.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" safety/transcript-snapshot",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" safety/transcript-snapshot",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/session-reaper",
            "async": false
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dpf-platform@dpf-platform-local": true
  },
  "extraKnownMarketplaces": {
    "dpf-platform-local": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
