{
  "permissions": {
    "allow": [
      "Bash(xargs grep:*)",
      "Bash(git fetch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose logs:*)",
      "Bash(curl -s http://localhost:3000/api/health)",
      "WebFetch(domain:skillsllm.com)",
      "WebFetch(domain:skillsmp.com)",
      "mcp__dpf__propose_improvement"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "dpf"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/lease-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/root-clone-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/compose-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/lease-punt-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/pregate-evidence-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/pregate-invocation-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/workroom-claim-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/decision-routing-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/root-clone-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/plan-backlog-coverage-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/ux-fit-precheck.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/spec-plan-doc-precheck.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/design-grounding-precheck.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/tool-economy-precheck.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/workroom-claim-guard.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/shared-clone-occupancy.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/worktree-freshness",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/mcp-health",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/janitor-throttle",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/reconcile-claude-plugin",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" safety/transcript-snapshot",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/uncommitted-work-guard.mjs\"",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" safety/transcript-snapshot",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/run-hook.mjs\" hooks/session-reaper",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/packages/dpf-skill-pack/hooks/uncommitted-work-guard.mjs\"",
            "async": false
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dpf-platform@dpf-platform-local": true
  },
  "extraKnownMarketplaces": {
    "dpf-platform-local": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
