#!/bin/sh
# pre-push-gate: refuse a push unless the current branch+SHA carries a passing
# local-CI sandbox gate record (BI-166C59F3 mechanics, enforced by default per
# BI-C74F4DE9). Chained from .githooks/pre-push after Git LFS.
#
# The gate record is written by scripts/gate-worktree.sh (`pnpm run pregate`),
# which claims the shared local-integration-ci lease, runs the checked-in
# CI-equivalent runner (scripts/local-ci-runner.sh by default), records MCP
# evidence, and persists the result to .git/dpf-local-ci-gate.json.
#
# What does NOT need a gate record:
#   - delete-only / tag-only pushes (nothing to verify)
#   - pushes from main or a detached HEAD (the merge queue governs main)
#   - docs-only diffs vs the configured comparison base, PROVIDED none of the
#     changed docs are the source of a registered derived artifact that is
#     now stale (scripts/derived-artifacts-gate.mjs push-exempt; registry at
#     scripts/lib/derived-artifacts-registry.mjs — BI-48768E05)
#
# Override (recorded, PR-visible — NOT silent): set BOTH
#   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON="why" git push
# The skip reason is persisted into the gate state file so `pnpm pr:health`
# can surface it as an explicit operator attestation at PR time.

set -eu

# gate-worktree.sh pushes the branch as part of the gate run itself, before the
# gate record exists. That push carries the in-flight marker and must pass —
# the run it belongs to records the real result minutes later.
if [ "${DPF_PREPUSH_GATE_INFLIGHT:-}" = "1" ]; then
  echo "[pre-push-gate] gate run in progress (gate-worktree.sh) — deferring to its recorded result."
  exit 0
fi

refs_input="$(cat 2>/dev/null || true)"

# Delete-only / tag-only pushes carry nothing to gate. When stdin is empty
# (hook exercised directly), fall through to the branch checks.
if [ -n "$refs_input" ]; then
  needs_gate=0
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case "$local_ref" in
      refs/tags/*) continue ;;
      "(delete)") continue ;;
    esac
    case "$local_sha" in
      0000000000000000000000000000000000000000) continue ;;
    esac
    needs_gate=1
  done <<EOF
$refs_input
EOF
  if [ "$needs_gate" = "0" ]; then
    echo "[pre-push-gate] delete/tag-only push — local-CI gate not required."
    exit 0
  fi
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
sha="$(git rev-parse HEAD)"
state_file="$(git rev-parse --git-path dpf-local-ci-gate.json)"

if [ "$branch" = "HEAD" ]; then
  echo "[pre-push-gate] detached HEAD — gate applies to branch pushes only; skipping."
  exit 0
fi
if [ "$branch" = "main" ]; then
  echo "[pre-push-gate] main is governed by the merge queue — local-CI gate skipped."
  exit 0
fi

# Recorded override: allowed, but never silent. The reason is persisted so the
# PR-health guard can read it back as an explicit operator attestation.
if [ "${DPF_SKIP_PREPUSH_GATE:-}" = "1" ]; then
  reason="${DPF_SKIP_PREPUSH_GATE_REASON:-}"
  if [ -z "$reason" ]; then
    echo "[pre-push-gate] DPF_SKIP_PREPUSH_GATE=1 requires DPF_SKIP_PREPUSH_GATE_REASON." >&2
    echo "[pre-push-gate] The override is recorded and surfaced at PR time — state why this" >&2
    echo "[pre-push-gate] push is verified-clean without a sandbox gate run, e.g.:" >&2
    echo "[pre-push-gate]   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON=\"WIP handoff, gate before PR\" git push" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$state_file")"
  node -e '
const fs = require("node:fs");
const [file, branch, sha, reason] = process.argv.slice(1);
fs.writeFileSync(file, JSON.stringify({
  branch,
  sha,
  gatePassed: false,
  skipped: true,
  skipReason: reason,
  recordedAt: new Date().toISOString()
}, null, 2) + "\n");
' "$state_file" "$branch" "$sha" "$reason"
  echo "[pre-push-gate] override recorded for $branch@$sha: $reason"
  echo "[pre-push-gate] NOTE: pnpm pr:health will require a passing gate record or a"
  echo "[pre-push-gate] Local-CI-Override attestation in the PR body before merge-readiness."
  exit 0
fi

# Docs-only diffs need no sandbox run UNLESS the diff invalidates a
# registered derived artifact (BI-48768E05) — a docs change is not
# inherently runtime-safe when it is the SOURCE of a generated runtime
# artifact (e.g. apps/web/lib/docs/doc-index.generated.json). PR #3284 was
# exactly this: a docs-only diff that turned main red because the old rule
# here exempted it by path regex alone, with no check that the derived
# artifact was actually still fresh. scripts/derived-artifacts-gate.mjs
# derives the exemption from the registry instead of a path regex: it still
# requires zero non-docs runtime changes, and additionally runs the --check
# command for every registered artifact whose sources are in the diff. When
# this checkout has no such registry (scripts/derived-artifacts-gate.mjs
# absent), fall back to the plain "diff touches only docs/, memory/, or *.md"
# rule the registry itself replaced — still zero non-docs changes, just no
# derived-artifact staleness awareness. The comparison base defaults to
# origin/main for GitHub-hosted clones, but can be pointed at a local
# accepted-base ref by offline/forge-neutral integrations. If the configured
# base is missing, do NOT fall back silently; require the SHA-bound gate
# record instead.
base_ref="${DPF_PREPUSH_BASE_REF:-origin/main}"
if git rev-parse --verify --quiet "$base_ref" >/dev/null 2>&1; then
  merge_base="$(git merge-base HEAD "$base_ref" 2>/dev/null || true)"
  if [ -n "$merge_base" ]; then
    if [ -f "scripts/derived-artifacts-gate.mjs" ]; then
      if node scripts/derived-artifacts-gate.mjs push-exempt "$merge_base"; then
        echo "[pre-push-gate] docs-only diff vs $base_ref — no gate record required."
        exit 0
      fi
    else
      non_docs="$(git diff --name-only "$merge_base" HEAD 2>/dev/null | grep -Ev '^(docs/|memory/)|\.md$' || true)"
      if [ -z "$non_docs" ]; then
        echo "[pre-push-gate] docs-only diff vs $base_ref — no gate record required."
        exit 0
      fi
    fi
  fi
fi

if [ ! -f "$state_file" ]; then
  echo "[pre-push-gate] No local-CI gate record exists for this worktree." >&2
  echo "[pre-push-gate] Run the sandbox gate first:  pnpm run pregate" >&2
  echo "[pre-push-gate] (claims the shared local-integration-ci lease, runs the checked-in" >&2
  echo "[pre-push-gate]  CI-equivalent runner, records MCP evidence, writes the gate record)" >&2
  echo "[pre-push-gate] Recorded override for a verified-clean push:" >&2
  echo "[pre-push-gate]   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON=\"why\" git push" >&2
  exit 1
fi

node -e '
const fs = require("node:fs");
const [file, branch, sha] = process.argv.slice(1);
const state = JSON.parse(fs.readFileSync(file, "utf8"));
if (state.branch !== branch || state.sha !== sha || state.gatePassed !== true) {
  console.error("[pre-push-gate] Latest local-CI gate does not pass for this HEAD.");
  console.error(`[pre-push-gate] expected ${branch}@${sha}`);
  console.error(`[pre-push-gate] found ${state.branch || "(none)"}@${state.sha || "(none)"} gatePassed=${state.gatePassed}${state.skipped ? " (recorded override, not a pass)" : ""}`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (or a recorded override — see above)");
  process.exit(1);
}
if (!state.expiresAt) {
  console.error("[pre-push-gate] Latest local-CI gate record is missing expiresAt.");
  console.error("[pre-push-gate] Run: pnpm run pregate   (records fresh, expiry-bound local-CI evidence)");
  process.exit(1);
}
const expiresAt = Date.parse(state.expiresAt);
if (!Number.isFinite(expiresAt)) {
  console.error(`[pre-push-gate] Latest local-CI gate record has an invalid expiresAt: ${state.expiresAt}`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (records fresh, expiry-bound local-CI evidence)");
  process.exit(1);
}
if (expiresAt <= Date.now()) {
  console.error(`[pre-push-gate] Latest local-CI gate record expired at ${state.expiresAt}.`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (refreshes local-CI evidence for this HEAD)");
  process.exit(1);
}
' "$state_file" "$branch" "$sha"

echo "[pre-push-gate] local-CI gate passed for $branch@$sha"
