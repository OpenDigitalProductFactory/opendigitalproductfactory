#!/bin/sh
# pre-push-gate: refuse a push unless the current branch+SHA carries a passing
# local-CI sandbox gate record (BI-166C59F3 mechanics, enforced by default per
# BI-C74F4DE9). Chained from .githooks/pre-push after Git LFS.
#
# The gate record is written by scripts/gate-worktree.sh (`pnpm run pregate`),
# which claims the shared local-integration-ci lease, runs the checked-in
# CI-equivalent runner (scripts/local-ci-runner.sh by default), records MCP
# evidence, and persists the result to .git/dpf-local-ci-gate.json.
#
# What does NOT need a gate record:
#   - delete-only / tag-only pushes (nothing to verify)
#   - pushes from main or a detached HEAD (the merge queue governs main)
#   - docs-only diffs vs the configured comparison base, PROVIDED none of the
#     changed docs are the source of a registered derived artifact that is
#     now stale (scripts/derived-artifacts-gate.mjs push-exempt; registry at
#     scripts/lib/derived-artifacts-registry.mjs — BI-48768E05)
#
# Override (recorded, PR-visible — NOT silent): set BOTH
#   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON="why" git push
# The skip reason is persisted into the gate state file so `pnpm pr:health`
# can surface it as an explicit operator attestation at PR time.

set -eu

# A push is not "done": the PR is complete only once its required checks are
# GREEN. Emitted on every path that lets a push through (gate passed, recorded
# override, docs-only exempt) so an agent does not push-and-abandon a red PR
# (the failure mode behind PRs #4172/#4173/#4189). Cheap, non-blocking reminder.
completion_notice() {
  echo "[pre-push-gate] NOTE: pushing is not 'done' — a PR is complete only when its required checks are GREEN."
  echo "[pre-push-gate]       After CI starts, verify with:  pnpm pr:health <PR#>   (do not leave a red PR unattended)."
}

# gate-worktree.sh pushes the branch as part of the gate run itself, before the
# gate record exists. That push carries the in-flight marker and must pass —
# the run it belongs to records the real result minutes later.
if [ "${DPF_PREPUSH_GATE_INFLIGHT:-}" = "1" ]; then
  echo "[pre-push-gate] gate run in progress (gate-worktree.sh) — deferring to its recorded result."
  exit 0
fi

refs_input="$(cat 2>/dev/null || true)"

# Delete-only / tag-only pushes carry nothing to gate. When stdin is empty
# (hook exercised directly), fall through to the branch checks.
if [ -n "$refs_input" ]; then
  needs_gate=0
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case "$local_ref" in
      refs/tags/*) continue ;;
      "(delete)") continue ;;
    esac
    case "$local_sha" in
      0000000000000000000000000000000000000000) continue ;;
    esac
    needs_gate=1
  done <<EOF
$refs_input
EOF
  if [ "$needs_gate" = "0" ]; then
    echo "[pre-push-gate] delete/tag-only push — local-CI gate not required."
    exit 0
  fi
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
sha="$(git rev-parse HEAD)"
state_file="$(git rev-parse --git-path dpf-local-ci-gate.json)"

# BI-5529B5AC: gate state is written PER SLOT — slot-0 to dpf-local-ci-gate.json
# and slot-1 to dpf-local-ci-gate-slot-1.json (scripts/lib/local-ci-slot-manifest.mjs).
# `pregate:status` reconciles across slots; this hook used to read the slot-0
# filename and nothing else, so a gate that ran and PASSED on slot-1 was
# invisible here and the push was refused with gatePassed=false for a SHA that
# had genuinely passed. Observed 2026-09-02 on this repository: slot-1 recorded
# status=passed with an evidence id while a stale slot-0 record from an earlier
# unadmitted attempt still said queued, and the push was refused.
#
# That defect activates exactly when the two-slot pool starts working, and it
# presents as gate flakiness rather than as a slot bug, so it drives re-runs.
# Prefer any slot record that passes for THIS branch and SHA; otherwise keep the
# default file so every "no record" and "did not pass" message below is unchanged.
if [ -f "scripts/lib/local-ci-gate-state.mjs" ] || [ -d "$(dirname "$state_file")" ]; then
  passing_state_file="$(node -e '
const fs = require("node:fs");
const path = require("node:path");
const [dir, branch, sha] = process.argv.slice(1);
let entries = [];
try { entries = fs.readdirSync(dir); } catch { process.exit(0); }
for (const name of entries) {
  if (!/^dpf-local-ci-gate.*\.json$/.test(name)) continue;
  const file = path.join(dir, name);
  let state;
  try { state = JSON.parse(fs.readFileSync(file, "utf8")); } catch { continue; }
  if (state.branch === branch && state.sha === sha && state.gatePassed === true) {
    process.stdout.write(file);
    break;
  }
}
' "$(dirname "$state_file")" "$branch" "$sha" 2>/dev/null || true)"
  if [ -n "$passing_state_file" ] && [ "$passing_state_file" != "$state_file" ]; then
    echo "[pre-push-gate] using the passing slot record $(basename "$passing_state_file")"
    state_file="$passing_state_file"
  fi
fi

if [ "$branch" = "HEAD" ]; then
  echo "[pre-push-gate] detached HEAD — gate applies to branch pushes only; skipping."
  exit 0
fi
if [ "$branch" = "main" ]; then
  echo "[pre-push-gate] main is governed by the merge queue — local-CI gate skipped."
  exit 0
fi

# DCO sign-off is mandatory for EVERY commit that will become part of the PR,
# and it is checked here — before any skip/exempt exit below — because an
# unsigned commit is unsigned regardless of what it changes. The "DCO" required
# check is posted by the third-party DCO GitHub App only AFTER the push, so a
# missing sign-off (classically a corrupted or auto-generated MERGE commit —
# PR #4189 pushed exactly that) otherwise turns the PR red minutes later, once
# the author has moved on. scripts/pre-push-dco-check.mjs scans origin/main..HEAD
# (merges included) with the same predicate `pnpm pr:ready` uses. Its exit 2
# ("base ref unresolvable on this host") is a loud WARN, not a block — an
# offline fork must not be hard-failed, and CI's DCO app still enforces it.
# The [ -f ] guard lets the gate's temp-dir contract tests (no scripts/ tree)
# fall through, matching the sibling derived-artifacts / semantic-review guards.
if [ -f "scripts/pre-push-dco-check.mjs" ]; then
  if node scripts/pre-push-dco-check.mjs; then
    :
  else
    dco_status=$?
    if [ "$dco_status" = "2" ]; then
      echo "[pre-push-gate] DCO range could not be computed locally (see above) — CI's DCO app still enforces sign-off." >&2
    else
      echo "[pre-push-gate] DCO sign-off check failed — refusing to push (see above)." >&2
      exit "$dco_status"
    fi
  fi
fi

# Recorded override: allowed, but never silent. The reason is persisted so the
# PR-health guard can read it back as an explicit operator attestation.
if [ "${DPF_SKIP_PREPUSH_GATE:-}" = "1" ]; then
  reason="${DPF_SKIP_PREPUSH_GATE_REASON:-}"
  if [ -z "$reason" ]; then
    echo "[pre-push-gate] DPF_SKIP_PREPUSH_GATE=1 requires DPF_SKIP_PREPUSH_GATE_REASON." >&2
    echo "[pre-push-gate] Use a closed reason code (BI-563F6AB6), e.g.:" >&2
    echo "[pre-push-gate]   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON=\"operator-emergency: brief why\" git push" >&2
    exit 1
  fi
  # Validate allowlisted code before writing the skip record (BI-563F6AB6).
  # Inline codes (no monorepo import) so temp-dir gate contract tests still work;
  # keep in sync with packages/dpf-skill-pack/hooks/lib/local-ci-override.mjs.
  if ! node -e '
const reason = process.argv[1] || "";
const codes = new Set([
  "docs-adjacent",
  "delete-or-tag-only",
  "operator-emergency",
  "external-contribution-no-install",
  "install-bootstrap-recovery",
]);
const raw = reason.trim();
const m = raw.match(/^([a-z0-9-]+)(?:\s*[:\u2014\-]\s*(.*))?$/i);
if (!m || !codes.has(m[1].toLowerCase())) {
  console.error(
    "[pre-push-gate] DPF_SKIP_PREPUSH_GATE_REASON must start with an allowlisted code:",
    [...codes].join(", "),
  );
  console.error("[pre-push-gate] got:", JSON.stringify(raw));
  process.exit(1);
}
' "$reason"; then
    exit 1
  fi
  mkdir -p "$(dirname "$state_file")"
  node -e '
const fs = require("node:fs");
const [file, branch, sha, reason] = process.argv.slice(1);
fs.writeFileSync(file, JSON.stringify({
  branch,
  sha,
  gatePassed: false,
  skipped: true,
  skipReason: reason,
  recordedAt: new Date().toISOString()
}, null, 2) + "\n");
' "$state_file" "$branch" "$sha" "$reason"
  echo "[pre-push-gate] override recorded for $branch@$sha: $reason"
  echo "[pre-push-gate] NOTE: pnpm pr:health accepts only allowlisted override codes."

  # A recorded sandbox-gate skip — the standard source-only agent path via
  # external-contribution-no-install — still owes the CHEAP guard-parity
  # preflight. It needs no sandbox, runs host-native in seconds, and catches
  # exactly the deterministic guard class a skipped sandbox gate would otherwise
  # let sail through to a red PR: a stale UX-Fit manifest (PR #4173), a prose
  # ratchet, a module-size breach. The preflight self-degrades — a guard the
  # host cannot run WARNS rather than blocks (exit 0), so a source-only worktree
  # is never false-blocked; only a genuine deterministic violation (exit 1) is.
  # Escape hatch for the rare case even the preflight must be skipped:
  # DPF_SKIP_PREGATE_PREFLIGHT_REASON, honoured inside the preflight itself.
  if [ -f "scripts/pregate-preflight.mjs" ]; then
    if node scripts/pregate-preflight.mjs; then
      echo "[pre-push-gate] guard-parity preflight clean on override path."
    else
      echo "[pre-push-gate] guard-parity preflight found a deterministic guard violation — refusing the override push." >&2
      echo "[pre-push-gate] Fix the guard failure above. To bypass the preflight too (rare), set" >&2
      echo "[pre-push-gate]   DPF_SKIP_PREGATE_PREFLIGHT_REASON=\"why\" alongside the override." >&2
      exit 1
    fi
  fi

  completion_notice
  exit 0
fi

# Docs-only diffs need no sandbox run UNLESS the diff invalidates a
# registered derived artifact (BI-48768E05) — a docs change is not
# inherently runtime-safe when it is the SOURCE of a generated runtime
# artifact (e.g. apps/web/lib/docs/doc-index.generated.json). PR #3284 was
# exactly this: a docs-only diff that turned main red because the old rule
# here exempted it by path regex alone, with no check that the derived
# artifact was actually still fresh. scripts/derived-artifacts-gate.mjs
# derives the exemption from the registry instead of a path regex: it still
# requires zero non-docs runtime changes, and additionally runs the --check
# command for every registered artifact whose sources are in the diff. When
# this checkout has no such registry (scripts/derived-artifacts-gate.mjs
# absent), fall back to the plain "diff touches only docs/, memory/, or *.md"
# rule the registry itself replaced — still zero non-docs changes, just no
# derived-artifact staleness awareness. The comparison base defaults to
# origin/main for GitHub-hosted clones, but can be pointed at a local
# accepted-base ref by offline/forge-neutral integrations. If the configured
# base is missing, do NOT fall back silently; require the SHA-bound gate
# record instead.
base_ref="${DPF_PREPUSH_BASE_REF:-origin/main}"
if git rev-parse --verify --quiet "$base_ref" >/dev/null 2>&1; then
  merge_base="$(git merge-base HEAD "$base_ref" 2>/dev/null || true)"
  if [ -n "$merge_base" ]; then
    if [ -f "scripts/derived-artifacts-gate.mjs" ]; then
      if node scripts/derived-artifacts-gate.mjs push-exempt "$merge_base"; then
        echo "[pre-push-gate] docs-only diff vs $base_ref — no gate record required."
        completion_notice
        exit 0
      fi
    else
      non_docs="$(git diff --name-only "$merge_base" HEAD 2>/dev/null | grep -Ev '^(docs/|memory/)|\.md$' || true)"
      if [ -z "$non_docs" ]; then
        echo "[pre-push-gate] docs-only diff vs $base_ref — no gate record required."
        completion_notice
        exit 0
      fi
    fi
  fi
fi

# Semantic-review freshness is a separate, cheap pre-publication control. It
# performs no network/model call: it validates only the receipt sidecar minted
# from review_semantic_change for this exact committed diff. Policy remains
# shadow until measured external + Build Studio outcomes ratchet it to enforce.
if [ -f "scripts/semantic-review-gate.mjs" ]; then
  node scripts/semantic-review-gate.mjs validate || exit $?
fi

if [ ! -f "$state_file" ]; then
  echo "[pre-push-gate] No local-CI gate record exists for this worktree." >&2
  echo "[pre-push-gate] Run the sandbox gate first:  pnpm run pregate" >&2
  echo "[pre-push-gate] (claims the shared local-integration-ci lease, runs the checked-in" >&2
  echo "[pre-push-gate]  CI-equivalent runner, records MCP evidence, writes the gate record)" >&2
  echo "[pre-push-gate] Recorded override for a verified-clean push:" >&2
  echo "[pre-push-gate]   DPF_SKIP_PREPUSH_GATE=1 DPF_SKIP_PREPUSH_GATE_REASON=\"why\" git push" >&2
  exit 1
fi

node -e '
const fs = require("node:fs");
const [file, branch, sha] = process.argv.slice(1);
const state = JSON.parse(fs.readFileSync(file, "utf8"));
if (state.branch !== branch || state.sha !== sha || state.gatePassed !== true) {
  console.error("[pre-push-gate] Latest local-CI gate does not pass for this HEAD.");
  console.error(`[pre-push-gate] expected ${branch}@${sha}`);
  console.error(`[pre-push-gate] found ${state.branch || "(none)"}@${state.sha || "(none)"} gatePassed=${state.gatePassed}${state.skipped ? " (recorded override, not a pass)" : ""}`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (or a recorded override — see above)");
  process.exit(1);
}
if (state.evidencePending === true) {
  console.error("[pre-push-gate] local-CI gate passed but evidence publication is still pending.");
  console.error(`[pre-push-gate] reason=${state.evidencePendingReason || "unknown"}`);
  console.error(`[pre-push-gate] Run: pnpm run pregate -- --finalize-evidence --branch "${branch}" --sha "${sha}"`);
  process.exit(1);
}
if (!state.expiresAt) {
  console.error("[pre-push-gate] Latest local-CI gate record is missing expiresAt.");
  console.error("[pre-push-gate] Run: pnpm run pregate   (records fresh, expiry-bound local-CI evidence)");
  process.exit(1);
}
const expiresAt = Date.parse(state.expiresAt);
if (!Number.isFinite(expiresAt)) {
  console.error(`[pre-push-gate] Latest local-CI gate record has an invalid expiresAt: ${state.expiresAt}`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (records fresh, expiry-bound local-CI evidence)");
  process.exit(1);
}
if (expiresAt <= Date.now()) {
  console.error(`[pre-push-gate] Latest local-CI gate record expired at ${state.expiresAt}.`);
  console.error("[pre-push-gate] Run: pnpm run pregate   (refreshes local-CI evidence for this HEAD)");
  process.exit(1);
}
' "$state_file" "$branch" "$sha"

echo "[pre-push-gate] local-CI gate passed for $branch@$sha"
completion_notice
