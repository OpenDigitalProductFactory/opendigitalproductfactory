# DPF Edge Node — standalone deployment environment.
#
# Copy to .env on the Edge Node host (NOT the Authority host) before
# running `docker compose -f docker-compose.edge-standalone.yml up -d`.
#
# See docker-compose.edge-standalone.yml header + the multi-host
# runbook at docs/install/edge-node-multi-host.md for full usage.
#
# DO NOT commit your .env. The bootstrap token grants single-use
# enrollment on your Authority Core; treat it like a password.

# ── Required ────────────────────────────────────────────────────────

# Routable URL of the Authority Core from THIS host. Must NOT be
# localhost / 127.0.0.1 / host.docker.internal — those do not resolve
# across hosts.
#
# Use one of:
#   - Static LAN IP:  http://192.168.1.42:3000
#   - mDNS .local:    http://dpf-authority.local:3000
#   - DNS A record:   http://dpf.example.com:3000
#   - HTTPS (T2.2+):  https://dpf-authority.lan:443
DPF_AUTHORITY_URL=http://dpf-authority.lan:3000

# One-time bootstrap token from the Authority Core.
#
# Get one: log into the Authority Core, open
#   Admin > Platform Development > Edge Nodes
# click "Issue bootstrap token", copy the plaintext (shown ONCE,
# 15 minute TTL, single-use).
DPF_BOOTSTRAP_TOKEN=dpfboot_REPLACE_ME_WITH_TOKEN_FROM_ADMIN_UI

# ── Optional ────────────────────────────────────────────────────────

# Operator-friendly name; appears in the admin UI's Edge Nodes table.
# Defaults to the host's hostname under network_mode: host.
# DPF_EDGE_NODE_NAME=edge-node-warehouse-2

# Install mode classification for the audit + admin UI.
#   container-host = container on a Linux / macOS host (DEFAULT)
#   container-vm   = container in a VM (Docker Desktop)
#   native         = host binary (Phase 1+)
# DPF_INSTALL_MODE=container-host

# Image source — pin a specific tag for reproducibility in production.
# GHCR_OWNER=opendigitalproductfactory
# DPF_IMAGE_TAG=latest
