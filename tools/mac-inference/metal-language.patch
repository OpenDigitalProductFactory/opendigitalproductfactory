+
+// Explicit tensor language avoids an old linked SDK selecting Metal 3.2.
+// 0x40000 is MTLLanguageVersion4_0's ABI value; older SDK headers lack its name.
+static MTLCompileOptions * ggml_metal_compile_options(ggml_metal_device_t dev) {
+    MTLCompileOptions * options = [MTLCompileOptions new];
+    if (ggml_metal_device_get_props(dev)->has_tensor) {
+        options.languageVersion = (MTLLanguageVersion) 0x40000;
+    }
+    return options;
+}
 
