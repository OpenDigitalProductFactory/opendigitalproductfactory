@@ -0,0 +1,70 @@
+package llamacpp
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/docker/model-runner/pkg/inference"
+	"github.com/docker/model-runner/pkg/logging"
+)
+
+func dpfDisableUpdates(t *testing.T) {
+	t.Helper()
+	ShouldUpdateServerLock.Lock()
+	previous := ShouldUpdateServer
+	ShouldUpdateServer = false
+	ShouldUpdateServerLock.Unlock()
+	t.Cleanup(func() {
+		ShouldUpdateServerLock.Lock()
+		ShouldUpdateServer = previous
+		ShouldUpdateServerLock.Unlock()
+	})
+}
+
+func dpfEngineFixture(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	text := "#!/bin/sh\nprintf 'version: 9879 (72874f5-dpf-metal4.1)\\n'\n"
+	if err := os.WriteFile(filepath.Join(dir, "llama-server"), []byte(text), 0700); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func TestDpfUpstreamNamedOverrideHasHonestRunningStatus(t *testing.T) {
+	dpfDisableUpdates(t)
+	log := logging.NewLogger(slog.LevelError)
+	l := &llamaCpp{installDir: dpfEngineFixture(t), status: inference.FormatNotInstalled("")}
+	err := l.downloadLatestLlamaCpp(context.Background(), log, "b9879", "metal")
+	if !errors.Is(err, errLlamaCppUpdateDisabled) {
+		t.Fatalf("expected disabled updater: %v", err)
+	}
+	if !strings.HasPrefix(l.status, inference.StatusRunning) || !strings.Contains(l.status, "72874f5-dpf-metal4.1") {
+		t.Fatalf("custom engine not truthfully identified: %s", l.status)
+	}
+	if strings.Contains(l.status, "b9879-metal") {
+		t.Fatalf("custom engine advertised as vendor variant: %s", l.status)
+	}
+}
+
+func TestDpfDisabledUpdaterRefusesMissingEngine(t *testing.T) {
+	dpfDisableUpdates(t)
+	l := &llamaCpp{installDir: t.TempDir(), status: inference.FormatNotInstalled("")}
+	err := l.downloadLatestLlamaCpp(context.Background(), logging.NewLogger(slog.LevelError), "b9879", "metal")
+	if err == nil || errors.Is(err, errLlamaCppUpdateDisabled) {
+		t.Fatalf("missing custom engine accepted: %v", err)
+	}
+}
+
+func TestDpfInstallRejectsUnavailableOverride(t *testing.T) {
+	dpfDisableUpdates(t)
+	l := &llamaCpp{installDir: t.TempDir(), log: logging.NewLogger(slog.LevelError), status: inference.FormatNotInstalled("")}
+	if err := l.Install(context.Background(), nil); err == nil {
+		t.Fatal("backend Install accepted an unavailable explicit engine")
+	}
+}
