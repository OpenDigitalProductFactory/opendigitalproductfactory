+++ b/pkg/server/dpf_lease_unix_test.go
@@ -0,0 +1,87 @@
+//go:build darwin || linux
+
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func dpfLeaseFixture(t *testing.T) (string, dpfLeaseObservation) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "lease.json")
+	value := dpfLeaseObservation{SchemaVersion: 1, LeaseID: "NPEL-TEST", Owner: "test-owner", Branch: "codex/test", Status: "active", Phase: "running", ExpiresAt: time.Now().Add(time.Minute)}
+	data, _ := json.Marshal(value)
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path, value
+}
+
+func TestDpfLeaseRefusesUnsafeFilesAndExpiredObservations(t *testing.T) {
+	path, value := dpfLeaseFixture(t)
+	if _, err := readDpfLease(path, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(filepath.Dir(path), "link.json")
+	if err := os.Symlink(path, link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readDpfLease(link, time.Now()); err == nil {
+		t.Fatal("symlink accepted")
+	}
+	if err := os.Chmod(path, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readDpfLease(path, time.Now()); err == nil {
+		t.Fatal("public lease accepted")
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	value.ExpiresAt = time.Now().Add(-time.Second)
+	data, _ := json.Marshal(value)
+	os.WriteFile(path, data, 0600)
+	if _, err := readDpfLease(path, time.Now()); err == nil {
+		t.Fatal("expired lease accepted")
+	}
+}
+
+func TestDpfLeaseHardDeadlineStopsWithoutTheClient(t *testing.T) {
+	path, _ := dpfLeaseFixture(t)
+	t.Setenv("DPF_INFERENCE_LEASE_FILE", path)
+	t.Setenv("DPF_INFERENCE_EXPERIMENT_DEADLINE", time.Now().Add(100*time.Millisecond).Format(time.RFC3339Nano))
+	ctx, cancel, err := dpfLeasedContext(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cancel()
+	select {
+	case <-ctx.Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("native runtime outlived hard deadline")
+	}
+}
+
+func TestDpfLeaseChangedOwnerFencesNativeRuntime(t *testing.T) {
+	path, value := dpfLeaseFixture(t)
+	t.Setenv("DPF_INFERENCE_LEASE_FILE", path)
+	t.Setenv("DPF_INFERENCE_EXPERIMENT_DEADLINE", time.Now().Add(time.Minute).Format(time.RFC3339Nano))
+	ctx, cancel, err := dpfLeasedContext(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cancel()
+	value.Owner = "different-owner"
+	data, _ := json.Marshal(value)
+	os.WriteFile(path, data, 0600)
+	select {
+	case <-ctx.Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("changed owner did not fence runtime")
+	}
+}
