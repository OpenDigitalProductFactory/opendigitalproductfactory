+//go:build !darwin && !linux
+
+package server
+
+import (
+	"context"
+	"fmt"
+	"os"
+)
+
+func dpfLeasedContext(parent context.Context) (context.Context, context.CancelFunc, error) {
+	if os.Getenv("DPF_INFERENCE_LEASE_FILE") != "" {
+		return nil, nil, fmt.Errorf("leased native experiments are unsupported on this platform")
+	}
+	return parent, func() {}, nil
+}
