diff --git a/pkg/server/dpf_listener.go b/pkg/server/dpf_listener.go
new file mode 100644
--- /dev/null
+++ b/pkg/server/dpf_listener.go
@@ -0,0 +1,24 @@
+package server
+
+import (
+	"fmt"
+	"net"
+	"strconv"
+
+	"github.com/docker/model-runner/pkg/envconfig"
+)
+
+// DPF's host-native distribution never exposes an unauthenticated LAN listener.
+// Container access must be proven through the supported Desktop host gateway.
+func dpfTCPListenAddress(port string) (string, error) {
+	host := envconfig.Var("MODEL_RUNNER_BIND_HOST")
+	if host == "" {
+		host = "127.0.0.1"
+	}
+	ip := net.ParseIP(host)
+	n, err := strconv.Atoi(port)
+	if ip == nil || !ip.IsLoopback() || err != nil || n < 1 || n > 65535 || strconv.Itoa(n) != port {
+		return "", fmt.Errorf("DPF model runner requires a loopback IP and decimal TCP port")
+	}
+	return net.JoinHostPort(host, port), nil
+}
diff --git a/pkg/server/dpf_listener_test.go b/pkg/server/dpf_listener_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/server/dpf_listener_test.go
@@ -0,0 +1,34 @@
+package server
+
+import "testing"
+
+func TestDpfLoopbackListener(t *testing.T) {
+	for _, tc := range []struct{ host, port, want string }{
+		{"", "12434", "127.0.0.1:12434"},
+		{"127.0.0.1", "12435", "127.0.0.1:12435"},
+		{"::1", "12435", "[::1]:12435"},
+	} {
+		t.Run(tc.host+tc.port, func(t *testing.T) {
+			t.Setenv("MODEL_RUNNER_BIND_HOST", tc.host)
+			got, err := dpfTCPListenAddress(tc.port)
+			if err != nil || got != tc.want {
+				t.Fatalf("got %q / %v, want %q", got, err, tc.want)
+			}
+		})
+	}
+}
+
+func TestDpfListenerRejectsExposureAndInvalidPorts(t *testing.T) {
+	for _, tc := range []struct{ host, port string }{
+		{"0.0.0.0", "12435"}, {"::", "12435"}, {"192.168.1.20", "12435"},
+		{"localhost", "12435"}, {"127.0.0.1", "0"}, {"127.0.0.1", "65536"},
+		{"127.0.0.1", "012435"}, {"127.0.0.1", "http"}, {"127.0.0.1", "12435:1"},
+	} {
+		t.Run(tc.host+tc.port, func(t *testing.T) {
+			t.Setenv("MODEL_RUNNER_BIND_HOST", tc.host)
+			if got, err := dpfTCPListenAddress(tc.port); err == nil || got != "" {
+				t.Fatalf("unsafe listener accepted: %q", got)
+			}
+		})
+	}
+}
diff --git a/pkg/server/dpf_lease_unix.go b/pkg/server/dpf_lease_unix.go
new file mode 100644
--- /dev/null
+++ b/pkg/server/dpf_lease_unix.go
@@ -0,0 +1,93 @@
+//go:build darwin || linux
+
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// A private projection of the existing server-granted lease bounds a native
+// experiment. It grants no tool authority and contains no bearer credentials.
+type dpfLeaseObservation struct {
+	SchemaVersion int       `json:"schemaVersion"`
+	LeaseID       string    `json:"leaseId"`
+	Owner         string    `json:"ownerSessionId"`
+	Branch        string    `json:"branchName"`
+	Status        string    `json:"status"`
+	Phase         string    `json:"phase"`
+	ExpiresAt     time.Time `json:"expiresAt"`
+}
+
+func readDpfLease(path string, now time.Time) (dpfLeaseObservation, error) {
+	var value dpfLeaseObservation
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return value, fmt.Errorf("native experiment lease unavailable")
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	var stat unix.Stat_t
+	if unix.Fstat(fd, &stat) != nil || stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Mode&0o077 != 0 || stat.Uid != uint32(os.Geteuid()) {
+		return value, fmt.Errorf("native experiment lease must be an owner-only regular file")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 65537))
+	if err != nil || len(data) > 65536 || json.Unmarshal(data, &value) != nil || value.SchemaVersion != 1 ||
+		value.LeaseID == "" || value.Owner == "" || value.Branch == "" || value.Status != "active" ||
+		value.Phase != "running" || !value.ExpiresAt.After(now) {
+		return value, fmt.Errorf("native experiment lease invalid or expired")
+	}
+	return value, nil
+}
+
+func dpfLeasedContext(parent context.Context) (context.Context, context.CancelFunc, error) {
+	path := os.Getenv("DPF_INFERENCE_LEASE_FILE")
+	if path == "" {
+		return parent, func() {}, nil
+	}
+	now := time.Now()
+	hardEnd, err := time.Parse(time.RFC3339Nano, os.Getenv("DPF_INFERENCE_EXPERIMENT_DEADLINE"))
+	if err != nil || !hardEnd.After(now) || hardEnd.After(now.Add(10*time.Minute)) {
+		return nil, nil, fmt.Errorf("native experiment hard deadline required (at most ten minutes)")
+	}
+	first, err := readDpfLease(path, now)
+	if err != nil {
+		return nil, nil, err
+	}
+	ctx, cancel := context.WithCancel(parent)
+	deadline := func(expiry time.Time) time.Duration {
+		if hardEnd.Before(expiry) {
+			expiry = hardEnd
+		}
+		return time.Until(expiry)
+	}
+	go func() {
+		timer := time.NewTimer(deadline(first.ExpiresAt))
+		defer timer.Stop()
+		ticker := time.NewTicker(250 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-timer.C:
+				cancel()
+				return
+			case <-ticker.C:
+				current, err := readDpfLease(path, time.Now())
+				if err != nil || current.LeaseID != first.LeaseID || current.Owner != first.Owner || current.Branch != first.Branch {
+					cancel()
+					return
+				}
+				timer.Reset(deadline(current.ExpiresAt))
+			}
+		}
+	}()
+	return ctx, cancel, nil
+}
