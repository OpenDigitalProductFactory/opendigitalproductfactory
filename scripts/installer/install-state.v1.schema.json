{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://dpf.local/schemas/install-state.v1.json",
  "title": "DPF Install State v1",
  "type": "object",
  "required": ["schemaVersion", "installerVersion", "platform", "arch"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "installerVersion": { "type": "string" },
    "lastSuccessfulInstallVersion": { "type": ["string", "null"] },
    "lastSuccessfulComposeHash": { "type": ["string", "null"] },
    "composeProjectName": { "type": "string" },
    "enabledRuntimeCapabilities": { "type": "array", "items": { "type": "string", "pattern": "^runtime:[a-z0-9-]+$" }, "uniqueItems": true },
    "capabilityCatalogHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "capabilityStateVersion": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "platform": { "type": "string", "enum": ["darwin", "linux", "win32", "unsupported"] },
    "arch": { "type": "string" },
    "dockerContext": { "type": ["string", "null"] },
    "dockerEndpoint": { "type": ["string", "null"] },
    "installPath": { "type": "string" },
    "devWorkspacePath": { "type": ["string", "null"] },
    "stateDir": { "type": "string" },
    "installMode": { "type": ["string", "null"] },
    "edge": { "type": "object", "required": ["enabled", "mode"], "properties": { "enabled": { "type": "boolean" }, "mode": { "type": ["string", "null"] } }, "additionalProperties": false },
    "composeFiles": { "type": "array", "items": { "type": "string" } },
    "imageTag": { "type": ["string", "null"] },
    "llmProvider": { "type": ["string", "null"], "enum": ["model-runner", "ollama", "external", null] },
    "resourceLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "autostart": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "kind": { "type": "string", "enum": ["launchagent", "systemd-user", "scheduled-task", "none"] } }, "required": ["enabled", "kind"], "additionalProperties": false },
    "lastHealthCheck": { "type": ["string", "null"], "format": "date-time" },
    "lastBackupAt": { "type": ["string", "null"], "format": "date-time" },
    "lastDoctorBundlePath": { "type": ["string", "null"] },
    "agentToolchain": {
      "type": "object",
      "required": ["appliedAt", "dpfPlatformVersion", "superpowersVersion", "claudeCodeWired", "codexWired", "grokWired", "memorySeededAt", "mcpReadiness", "smokeTest", "readinessState"],
      "properties": {
        "appliedAt": { "type": "string", "format": "date-time" },
        "dpfPlatformVersion": { "type": "string" },
        "superpowersVersion": { "type": ["string", "null"] },
        "claudeCodeWired": { "type": "boolean" },
        "codexWired": { "type": "boolean" },
        "grokWired": { "type": "boolean" },
        "memorySeededAt": { "type": ["string", "null"], "format": "date-time" },
        "mcpReadiness": {
          "oneOf": [
            {
              "type": "object",
              "required": ["ok", "toolCount", "observedAt"],
              "properties": {
                "ok": { "const": true },
                "toolCount": { "type": "integer", "minimum": 0 },
                "observedAt": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["ok", "reason", "httpStatus"],
              "properties": {
                "ok": { "const": false },
                "reason": { "type": "string", "enum": ["no_token", "portal-unavailable", "mcp-unavailable", "endpoint_unreachable", "scope_insufficient", "unexpected_shape"] },
                "httpStatus": { "type": ["integer", "null"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "smokeTest": {
          "oneOf": [
            {
              "type": "object",
              "required": ["result", "kernelPrincipleObserved", "transcript"],
              "properties": { "result": { "const": "passed" }, "kernelPrincipleObserved": { "type": "string" }, "transcript": { "type": "string" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["result", "transcript", "reason"],
              "properties": { "result": { "const": "failed" }, "transcript": { "type": "string" }, "reason": { "type": "string" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["result", "reason"],
              "properties": {
                "result": { "const": "skipped" },
                "reason": { "type": "string", "enum": ["claude_not_on_path", "codex_not_on_path", "grok_not_on_path", "no_cli_on_path", "no_token"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "readinessState": { "type": "string", "enum": ["ready", "partial", "missing_cli", "missing_token", "needs_refresh", "portal-unavailable", "mcp-unavailable", "failed_smoke"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
