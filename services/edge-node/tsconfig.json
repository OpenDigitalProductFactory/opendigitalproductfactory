{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext emits CommonJS here because package.json declares no "type",
    // and CommonJS keeps the existing extensionless imports
    // (e.g. `import {…} from "./api-client"`) working at runtime; Node's ESM
    // resolver would refuse them with ERR_MODULE_NOT_FOUND. tsx (used by the
    // dev/test scripts) handles either module style. NodeNext replaced
    // "module": "CommonJS" + "moduleResolution": "Node" (node10), which
    // TypeScript 7 removed (TS5108, BI-2B8D67A9).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
