# apps/mobile is its own pnpm workspace (plan 2026-09-08 M6), so the root
# .npmrc does not reach it. React Native tooling (Metro, nativewind's JSX
# runtime) expects the flat layout the monorepo always gave it.
node-linker=hoisted
# Same store-safety rule as the root .npmrc (BI-EC88BAC1).
package-import-method=copy
