{
  "format": "gpp-shape/0.1",
  "key": "drc-pass-parallel-split",
  "version": "1.0.0",
  "title": "DRC fixture drc-pass-parallel-split",
  "description": "A sound parallel split and join: executable since GPP Phase 3c PR-3c-2, so it compiles.",
  "triggers": [
    "claim"
  ],
  "stages": [
    {
      "key": "a",
      "title": "Stage a",
      "accountablePrincipalRef": "role:shape-owner",
      "advance": {
        "kind": "status-change",
        "condition": "Stage a recorded its evidence."
      },
      "evidence": [
        "manual-check"
      ]
    },
    {
      "key": "b",
      "title": "Stage b",
      "accountablePrincipalRef": "role:shape-owner",
      "advance": {
        "kind": "status-change",
        "condition": "Stage b recorded its evidence."
      },
      "evidence": [
        "manual-check"
      ]
    },
    {
      "key": "c",
      "title": "Stage c",
      "accountablePrincipalRef": "role:shape-owner",
      "advance": {
        "kind": "status-change",
        "condition": "Stage c recorded its evidence."
      },
      "evidence": [
        "manual-check"
      ]
    }
  ],
  "flow": {
    "nodes": [
      {
        "id": "p",
        "type": "parallel-split"
      },
      {
        "id": "j",
        "type": "parallel-join",
        "pairs": "p"
      }
    ],
    "edges": [
      {
        "from": "a",
        "to": "p"
      },
      {
        "from": "p",
        "to": "b"
      },
      {
        "from": "p",
        "to": "c"
      },
      {
        "from": "b",
        "to": "j"
      },
      {
        "from": "c",
        "to": "j"
      },
      {
        "from": "j",
        "to": "success"
      }
    ]
  },
  "stopConditions": [
    {
      "kind": "success",
      "condition": "Every stage recorded its evidence.",
      "disposition": "proceed"
    },
    {
      "kind": "failure",
      "condition": "A stage cannot produce its evidence.",
      "disposition": "refused"
    },
    {
      "kind": "budget",
      "condition": "The cycle budget is spent.",
      "disposition": "inconclusive"
    }
  ],
  "grants": [],
  "measures": [],
  "budgets": [],
  "reviewPoint": {
    "everyDays": 7,
    "description": "Weekly review."
  },
  "collaborationShape": null
}
