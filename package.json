{
  "name": "dpf",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/host-resource-runner.mjs --class preview -- pnpm --filter web dev",
    "measure:obligation-cadence": "node scripts/measure-obligation-cadence-coverage.mjs",
    "measure:obligation-cadence:check": "node scripts/check-obligation-cadence-coverage.mjs",
    "measure:doc-cadence": "node scripts/measure-doc-cadence-coverage.mjs",
    "measure:doc-cadence:check": "node scripts/measure-doc-cadence-coverage.mjs --check",
    "measure:capability-completeness": "node scripts/measure-capability-completeness.mjs",
    "measure:capability-completeness:check": "node scripts/measure-capability-completeness.mjs --check",
    "check:agent-capability-integrity": "node scripts/check-agent-capability-integrity.mjs",
    "dev:web": "node scripts/host-resource-runner.mjs --class preview -- pnpm --filter web dev",
    "dev:portal": "sh scripts/dev-portal-lease.sh refresh",
    "contributor:preview": "sh scripts/dev-portal-lease.sh refresh",
    "dev:prod-runtime": "docker compose up -d portal",
    "dev:sandbox": "docker compose up -d sandbox",
    "pregate": "node scripts/pregate.mjs",
    "pregate:preflight": "node scripts/pregate-preflight.mjs",
    "pregate:status": "node scripts/pregate-status.mjs",
    "dco:check": "node scripts/pre-push-dco-check.mjs",
    "review:semantic-gate": "node scripts/semantic-review-gate.mjs",
    "gate:context": "node scripts/gate-context.mjs",
    "build": "node scripts/host-resource-runner.mjs --class next-build -- pnpm --filter web build",
    "test": "node scripts/host-resource-runner.mjs --class vitest -- pnpm -r --if-present --workspace-concurrency=1 --no-bail test",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright-demo.config.ts",
    "typecheck": "node scripts/host-resource-runner.mjs --class typescript -- pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @dpf/db generate",
    "db:migrate": "pnpm --filter @dpf/db migrate",
    "db:seed": "pnpm --filter @dpf/db seed",
    "db:studio": "pnpm --filter @dpf/db studio",
    "check:lifecycle-surfaces": "node --test scripts/lifecycle-surface-policy.test.mjs",
    "test:endpoints": "tsx scripts/test-endpoints.ts",
    "verify:preflight": "tsx scripts/dpf-verify-preflight.ts",
    "pr:ready": "node scripts/pr-readiness.mjs",
    "check:bundle-boundaries": "node scripts/check-bundle-boundaries.mjs",
    "check:application-boundaries": "node scripts/check-application-boundaries.mjs",
    "check:diagram-dependency-pins": "node scripts/check-diagram-dependency-pins.mjs",
    "check:override-comments": "node scripts/check-override-comments.mjs && node --test scripts/check-override-comments.test.mjs",
    "audit:stale-overrides": "node scripts/audit-stale-overrides.mjs",
    "regen:lockfile": "node scripts/regen-lockfile.mjs",
    "check:reporting-composition": "node scripts/check-reporting-composition.mjs",
    "check:platform-composition-home": "node --test scripts/check-platform-composition-single-home.test.mjs && node scripts/check-platform-composition-single-home.mjs",
    "check:prose-lint": "tsx scripts/check-prose-lint.ts",
    "check:prose-lint:test": "tsx --test scripts/check-prose-lint.test.ts",
    "check:fpaw-standard": "tsx scripts/check-fpaw-standard.ts",
    "check:fpaw-standard:test": "tsx --test scripts/check-fpaw-standard.test.ts scripts/check-fpaw-external-bridge.test.ts",
    "check:n1-caller-honesty": "node scripts/check-n-minus-one-caller-honesty.mjs",
    "check:module-size": "node scripts/check-module-size.mjs",
    "check:fk-index-coverage": "node scripts/check-fk-index-coverage.mjs",
    "check:ux-primitive-adoption": "node scripts/check-ux-primitive-adoption.mjs",
    "check:build-studio-surface": "node scripts/check-build-studio-surface-budget.mjs",
    "check:retention-enrollment": "node scripts/check-retention-enrollment.mjs",
    "check:closed-set-strings": "node scripts/check-no-new-closed-set-strings.mjs",
    "check:doc-anchors": "node scripts/check-doc-anchor-existence.mjs",
    "check:live-blockers": "node scripts/check-live-blocker-references.mjs",
    "check:baseline-budgets": "node scripts/check-no-expired-baseline-budgets.mjs",
    "check:spec-status": "node scripts/check-spec-status-frontmatter.mjs",
    "check:data-impact": "node scripts/check-data-impact.mjs",
    "measure:substrate": "node scripts/measure-platform-substrate.mjs --json",
    "check:substrate": "node scripts/measure-platform-substrate.mjs",
    "compile:capability-services": "node scripts/compile-capability-service-catalog.mjs",
    "check:capability-services": "node scripts/compile-capability-service-catalog.mjs --check",
    "check:capability-consumers": "node scripts/check-capability-consumers.mjs",
    "measure:substrate:runtime": "node scripts/measure-platform-substrate-runtime.mjs --json",
    "check:substrate:runtime": "node scripts/measure-platform-substrate-runtime.mjs",
    "check:mcp-tool-pack": "node scripts/check-mcp-tool-pack.mjs",
    "check:guards": "node scripts/check-guards.mjs",
    "check:seed-fit": "node scripts/check-seed-fit-decision.mjs",
    "check:architecture-parity": "pnpm --filter web exec tsx scripts/audit-architecture-parity.ts --baseline docs/superpowers/audits/2026-06-14-architecture-parity-baseline.json",
    "sbom": "node scripts/sbom/generate-platform-sbom.mjs",
    "check:sbom-drift": "node scripts/sbom/check-sbom-drift.mjs",
    "check:new-deps": "node scripts/sbom/check-new-dependencies.mjs",
    "scan:deps": "node scripts/sbom/scan-dependencies.mjs",
    "audit:provenance": "node scripts/sbom/audit-provenance.mjs",
    "check:lockfile-release-age": "node scripts/sbom/check-lockfile-release-age.mjs",
    "surface": "node scripts/sbom/runtime-surface.mjs",
    "candidates": "node scripts/sbom/internalization-candidates.mjs",
    "check:singletons": "node scripts/sbom/check-singleton-safety.mjs",
    "docs:index": "node scripts/gen-doc-index.mjs",
    "docs:business-types": "tsx scripts/generate-business-type-pages.ts",
    "docs:index:check": "node scripts/gen-doc-index.mjs --check",
    "docs:business-types:check": "tsx scripts/generate-business-type-pages.ts --check",
    "docs:business-types:test": "tsx --test docs/business-types/_generate.test.mts",
    "route:sync": "pnpm --filter web build:route-manifest && pnpm --filter web build:route-shells && pnpm --filter web build:route-audience && node scripts/gen-doc-index.mjs",
    "route:sync:check": "pnpm --filter web check:route-manifest && pnpm --filter web build:route-shells -- --check && pnpm --filter web build:route-audience -- --check && node scripts/gen-doc-index.mjs --check",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:links:test": "node --test scripts/check-doc-links.test.mjs",
    "docs:links:fix": "node scripts/fix-doc-links.mjs",
    "docs:diagrams": "node scripts/render-doc-diagrams.mjs",
    "docs:diagrams:check": "node scripts/render-doc-diagrams.mjs --check",
    "docs:impact": "node scripts/check-docs-impact.mjs",
    "check:retired-substrate": "node --test scripts/check-retired-substrate.test.mjs && node scripts/check-retired-substrate.mjs",
    "check:retired-substrate:update": "node scripts/check-retired-substrate.mjs --update",
    "docs:impact:test": "node --test scripts/check-docs-impact.test.mjs scripts/gen-doc-impact.test.mjs",
    "docs:impact:graph": "node scripts/gen-doc-impact.mjs",
    "docs:impact:graph:check": "node scripts/gen-doc-impact.mjs --check",
    "check:doc-links": "node scripts/gen-doc-index.mjs --check && node scripts/check-doc-links.mjs && node --test scripts/check-doc-links.test.mjs scripts/public-docs-rendering.test.mjs && node scripts/render-doc-diagrams.mjs --check",
    "security:secrets": "node scripts/security/run-gitleaks-local.mjs --tree",
    "security:secrets:staged": "node scripts/security/run-gitleaks-local.mjs --staged",
    "docs:tak": "node docs/architecture/generate-tak-docx.mjs",
    "docs:gaid": "node docs/architecture/generate-gaid-docx.mjs",
    "docs:jsi": "node docs/architecture/generate-jsi-docx.mjs",
    "docs:agent-standards": "node docs/architecture/generate-agent-standard-docx.mjs all",
    "pr:health": "node scripts/pr-health.mjs",
    "pr:origin": "node scripts/pr-origin.mjs",
    "merge-policy:check": "node scripts/merge-readiness-policy.mjs check",
    "merge-policy:audit": "node scripts/merge-readiness-policy.mjs audit",
    "merge-policy:apply": "node scripts/merge-readiness-policy.mjs apply",
    "postinstall": "node scripts/set-hooks-path.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@mermaid-js/mermaid-cli": "11.16.0",
    "@playwright/test": "^1.62.0",
    "docx": "^9.7.1",
    "puppeteer": "^25.7.0",
    "tsx": "^4.23.12"
  }
}
