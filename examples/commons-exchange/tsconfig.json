{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true, "strict": true,
    "types": [],
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "kernel/**/*.ts"
  ]
}
