# Build context for Dockerfile.doctools: only the doctools sources.
# BuildKit reads <Dockerfile>.dockerignore in place of .dockerignore, so the
# repository (node_modules, docs, apps) is never sent to the builder.
*
!tools/doctools/dpf-convert
!tools/doctools/registrymodifications.xcu
!tools/doctools/dpf-render
!tools/doctools/dpf_render_uno.py
!tools/doctools/dpf_render_families.py
