# Line-ending policy — deterministic blobs across Windows, macOS, and Linux so
# the same file produces the same bytes regardless of editor, tool, or host.
# This prevents whole-file CRLF<->LF churn in diffs and blame (the failure mode
# where one edit on a Windows box silently flips an entire file's line endings).
#
# Added forward-only: NO mass renormalize was run, so existing files normalize
# to this policy the next time they are committed — one file at a time, when you
# are already touching it. `text=auto` auto-detects binary files; the Git LFS
# rules below still override for the listed asset types.
# See docs/testing/pre-pr-gate.md and AGENTS.md §2.
* text=auto eol=lf

# Shell scripts run in Linux containers — LF required.
docker-entrypoint.sh text eol=lf
*.sh text eol=lf

# Windows-native scripts — CRLF. Batch files are line-ending-sensitive, and the
# PowerShell scripts here are authored and committed as CRLF. Overrides the LF
# default above.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.ps1xml text eol=crlf

# Binary assets via Git LFS — never treat as text.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text

# Upstream Model Context Protocol spec — preserve LF line endings so the local
# copy stays byte-identical to upstream and refresh diffs are clean.
docs/Reference/mcp/spec/** text eol=lf
docs/Reference/mcp/schema/** text eol=lf

# Ratchet baselines are line-oriented (one `<path>\t<value>` entry per line,
# sorted) precisely so concurrent PRs that each re-baseline merge cleanly with
# the built-in union driver instead of conflicting (BI-3B0AD9CF). The guard
# parsers tolerate union-merge duplicates (max wins) and --update rewrites
# sorted + deduped.
scripts/module-size-baseline.txt merge=union

scripts/route-error-baseline.txt merge=union
scripts/superpowers-skill-baseline.txt merge=union

scripts/docs-reference-baseline.txt merge=union

scripts/private-identity-baseline.txt merge=union

scripts/hand-rolled-loading-baseline.txt merge=union

# Doc-anchor grandfather baseline (BI-3F17B16B) — line-oriented pairs.
scripts/doc-anchor-baseline.txt merge=union

# Spec-status grandfather baseline (BI-79BCE3F2) — line-oriented paths.
scripts/spec-status-frontmatter-baseline.txt merge=union

# Instruction-plane size ratchet baseline (BI-0020D511) — always-on agent
# doctrine plane; union-merge so concurrent re-baselines never conflict.
scripts/instruction-plane-baseline.txt merge=union
scripts/instruction-plane-rule-baseline.txt merge=union

# CI test-inventory allowlist — line-oriented; concurrent guard PRs each append
# their own self-test and should never conflict on adjacent lines.
scripts/ci-policy-test-inventory-allowlist.txt merge=union

# Archetype completeness ratchet baseline — concurrent PRs that each re-run
# --update must not conflict; union-merge and let --update re-dedupe/sort.
scripts/archetype-completeness-baseline.txt merge=union

# Stewardship-scope ratchet baseline + exemption registry (BI-C34E09B0). Both
# are one-model-per-line for the same reason: a schema-heavy release lands many
# PRs that each add models, and two of them re-running --update must union-merge
# rather than collide on a shared line. --update re-dedupes and re-sorts.
scripts/stewardship-scope-baseline.txt merge=union
scripts/stewardship-exemptions.txt merge=union

# Ambient-host-state test ratchet baseline (BI-95A83B47) — line-oriented pairs;
# min-wins on duplicates, so union merges never loosen the ratchet.
scripts/ambient-host-test-baseline.txt merge=union

# The tool-pack registry is one-pack-per-line precisely so concurrent PRs that
# each add a pack merge with the built-in union driver instead of colliding on
# a shared line (BI-3B0AD9CF pattern applied to composeToolPacks). The
# pack-registry.test.ts asserts no duplicate packId survives a union merge.
apps/web/lib/mcp/pack-registry.ts merge=union
